---
/*
  Home hero ambience (on navy): a warm lamp-lit backdrop, three slow glow
  blobs, gold light ribbons that draw in once, and sparks that travel along them. Decorative only.
  Place it as the first child of a position:relative, isolation:isolate hero; it fills the hero behind
  the content (z-index -1). Tuned to the home hero, whose portrait sits right of centre.

  The ribbons and sparks share one fixed 1440×900 px stage, centred, so the sparks' CSS offset-path
  and the SVG paths read the same path data in the same pixels (no JS scaling; transforming the
  stage moves both together). Wider screens see the ribbons fade out at the stage ends; single-column
  screens keep one flattened ribbon between the CTAs and the stats.

  Motion: blobs drift 28s / 34s / 40s (alternate); ribbons draw in once (2.4s, staggered); sparks
  loop 11 / 14 / 17 / 12.5s so they never sync. Only transform, opacity, offset-distance and the
  one-shot stroke-dashoffset animate. site.ts pauses it all while off screen (.gold-idle) or in a
  hidden tab (html.gold-paused); reduced motion shows the drawn ribbons, still blobs, no sparks.
*/
// Stage px. The home hero's text column spans x 120–770; the gaps these cross it in are above the
// eyebrow (y < 100), between the CTAs and the stats (y 690–770) and below the stats (y > 880).
// All three then pass behind the portrait (x 900–1320, y 120–540) and its caption.
const ribbons = [
  { d: 'M-80 80 C 320 20, 640 60, 900 150 S 1280 300, 1540 250', dd: '0.1s' },
  { d: 'M-80 760 C 260 700, 560 760, 860 560 S 1240 250, 1540 280', dd: '0.35s' },
  { d: 'M-80 895 C 400 860, 760 900, 1060 780 S 1380 620, 1540 640', dd: '0.6s' }
];
// [ribbon, duration, delay]: the first pass of each waits until the ribbons have drawn in.
const sparks: [number, string, string][] = [
  [0, '11s', '2.6s'],
  [1, '14s', '3.4s'],
  [2, '17s', '4.8s'],
  [1, '12.5s', '9.5s']
];
---
<div class="amb" aria-hidden="true">
  <i class="amb__glow amb__glow--1"></i><i class="amb__glow amb__glow--2"></i><i class="amb__glow amb__glow--3"></i>
  <div class="amb__stage">
    <svg viewBox="0 0 1440 900" width="1440" height="900" focusable="false">
      <defs>
        <linearGradient id="amb-edge"><stop offset="0" stop-color="#a98141" stop-opacity="0" /><stop offset=".3" stop-color="#a98141" stop-opacity=".75" /><stop offset=".66" stop-color="#ffe7b0" /><stop offset=".86" stop-color="#a98141" /><stop offset="1" stop-color="#a98141" stop-opacity="0" /></linearGradient>
        <linearGradient id="amb-soft"><stop offset="0" stop-color="#c99a4e" stop-opacity="0" /><stop offset=".55" stop-color="#c99a4e" /><stop offset="1" stop-color="#c99a4e" stop-opacity="0" /></linearGradient>
      </defs>
      {
        ribbons.map((r) => (
          <g style={`--dd:${r.dd}`}>
            <path class="amb__under" d={r.d} pathLength="1" />
            <path class="amb__edge" d={r.d} pathLength="1" />
          </g>
        ))
      }
    </svg>
    {sparks.map(([r, t, delay]) => <i class="amb__spark" style={`offset-path:path('${ribbons[r].d}');animation-duration:${t};animation-delay:${delay}`} />)}
  </div>
</div>

<style is:global>
  .amb {
    position: absolute; inset: 0; z-index: -1; overflow: hidden; pointer-events: none;
    background:
      radial-gradient(70% 55% at 76% 46%, rgba(214, 150, 66, 0.2), transparent 70%),
      linear-gradient(180deg, var(--bg) 0%, #0c1429 55%, var(--bg) 100%);
    /* soft top and bottom edges, so the ribbons never meet the nav or the ticker in a hard line */
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 8%, #000 86%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 8%, #000 86%, transparent);
  }
  .amb__glow { position: absolute; border-radius: 50%; }
  .amb__glow--1 { top: -12vw; right: -10vw; width: 43vw; height: 43vw; background: radial-gradient(circle closest-side, rgba(214, 158, 80, 0.2), transparent); }
  .amb__glow--2 { top: 32%; left: -15vw; width: 37vw; height: 37vw; background: radial-gradient(circle closest-side, rgba(92, 108, 150, 0.22), transparent); }
  .amb__glow--3 { right: 15vw; bottom: -17vw; width: 28vw; height: 28vw; background: radial-gradient(circle closest-side, rgba(232, 176, 96, 0.14), transparent); }

  .amb__stage { position: absolute; top: 0; left: 50%; width: 1440px; height: 900px; margin-left: -720px; }
  .amb__stage svg { display: block; width: 1440px; height: 900px; max-width: none; overflow: visible; }
  .amb__stage path { fill: none; stroke-linecap: round; }
  .amb__under { stroke: url(#amb-soft); stroke-width: 10; opacity: 0.2; filter: blur(5px); }
  .amb__edge { stroke: url(#amb-edge); stroke-width: 1.3; opacity: 0.85; }
  .amb__spark {
    position: absolute; top: 0; left: 0; width: 34px; height: 2px; border-radius: 2px; opacity: 0;
    background: linear-gradient(90deg, transparent, #fff1cc 70%, #fffaf0);
    box-shadow: 0 0 3px 2.8px rgba(201, 154, 78, 0.3);
    offset-anchor: 100% 50%; offset-rotate: auto; will-change: transform;
  }
  /* Single column (no portrait): the text runs full width, so keep only the lowest ribbon and lay it,
     flattened, into the gap between the CTAs and the stats, measured up from the hero's bottom edge. */
  @media (max-width: 960px) {
    .amb__stage { top: auto; bottom: 114px; transform: rotate(10.5deg); }
    .amb__stage g:not(:last-of-type), .amb__spark:not(:nth-of-type(3)) { display: none; }
  }
  @media (max-width: 640px) { .amb__stage { bottom: 208px; transform: rotate(4deg); } }

  @media (prefers-reduced-motion: no-preference) {
    .amb__glow--1 { animation: amb-drift-1 28s ease-in-out infinite alternate; }
    .amb__glow--2 { animation: amb-drift-2 34s ease-in-out infinite alternate; }
    .amb__glow--3 { animation: amb-drift-1 40s ease-in-out infinite alternate-reverse; }
    .amb__stage path { stroke-dasharray: 1 1; animation: amb-draw 2.4s var(--ease-io) var(--dd) both; }
    .amb__spark { animation: amb-travel 11s linear infinite; }
  }
  @media (prefers-reduced-motion: reduce) { .amb__spark { display: none; } }
  @keyframes amb-drift-1 { to { transform: translate3d(-6vw, 5vh, 0) scale(1.08); } }
  @keyframes amb-drift-2 { to { transform: translate3d(7vw, -6vh, 0) scale(1.1); } }
  @keyframes amb-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes amb-travel {
    0% { offset-distance: 0%; opacity: 0; }
    12%, 86% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }
</style>
