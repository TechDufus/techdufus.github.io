---
/*
  "How I operate" (mockup index.html #about):
    <h3 class="about__h operate__h" data-reveal>How I operate <span>· keeping speed without losing control</span></h3>
    <ul class="operate"><li data-reveal><span class="meta">01</span><h4>…</h4><p>…</p></li>…</ul>
  Defaults to aboutHowIOperate.items.
*/
import { aboutHowIOperate } from '../../data/site';
import { delay, pad2 } from './format';

type Principle = { title: string; detail: string };

interface Props {
  items?: readonly Principle[];
  heading?: string;
  sub?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  items = aboutHowIOperate.items,
  heading = 'How I operate',
  sub = 'keeping speed without losing control',
  headingLevel: Heading = 'h3'
} = Astro.props;
const Item = Heading === 'h2' ? 'h3' : 'h4';
---
<Heading class="about__h operate__h" data-reveal="">{heading}{sub && <>{' '}<span>· {sub}</span></>}</Heading>
<ul class="operate">
  {
    items.map((item, i) => (
      <li data-reveal style={delay(i || null)}>
        <span class="meta">{pad2(i + 1)}</span>
        <Item>{item.title}</Item>
        <p>{item.detail}</p>
      </li>
    ))
  }
</ul>

<style is:global>
  /* Mockup index.html #about. .about__h is the small mono section label, also used by page-level subheads. */
  .about__h { font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); margin-bottom: 22px; font-weight: 500; }
  .operate__h { margin-top: clamp(56px, 7vw, 96px); }
  .operate__h span { text-transform: none; letter-spacing: 0; color: var(--faint); font-weight: 400; }
  .operate__h + .operate { margin-top: 0; }
  .operate { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); margin-top: clamp(56px, 7vw, 96px); }
  .operate li { display: grid; gap: 8px; align-content: start; padding-top: 18px; border-top: 1px solid var(--line); }
  .operate h3, .operate h4 { font-family: var(--font-display); font-size: 1.4rem; font-weight: 400; line-height: 1.15; }
  .operate p { color: var(--muted); font-size: 0.95rem; }
  @media (max-width: 960px) { .operate { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .operate { grid-template-columns: minmax(0, 1fr); } }
</style>
