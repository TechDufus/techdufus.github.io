---
/*
  Page-wide SVG paint servers, rendered once by BaseLayout (first child of <body>; <html class="has-duo">).
  #studio-duo  portrait duotone: a true gradient map, shadows → --duo-dark (#0b1630), highlights → --duo-light (#f4d9a2).
               Midnight only, so the 9-step, 1.45-gamma tables that the mockup computes at runtime are baked in.
  #studio-gold the gold gradient for SVG strokes (portrait ring): --gold-sheen's warm shape, twice round
               the ring, so the drawn arc reads lamp-lit; stops read the --gold-* tokens.
  #i-star #i-fork #i-repo #i-law  repeated repo-card icons; Icon.astro renders these as <use href="#i-…">.
*/
const goldStops: [number, string][] = [
  [0, '--gold-shadow'],
  [0.14, '--gold-deep'],
  [0.3, '--gold-light'],
  [0.4, '--gold-pale'],
  [0.52, '--gold'],
  [0.7, '--gold-deep'],
  [0.86, '--gold-light'],
  [1, '--gold']
];
---
<svg aria-hidden="true" focusable="false" style="position:absolute;width:0;height:0;overflow:hidden">
  <filter id="studio-duo" color-interpolation-filters="sRGB">
    <feColorMatrix type="saturate" values="0" />
    <feComponentTransfer>
      <feFuncR type="table" tableValues="0.043 0.088 0.166 0.264 0.378 0.505 0.645 0.796 0.957" />
      <feFuncG type="table" tableValues="0.086 0.124 0.189 0.271 0.366 0.473 0.590 0.716 0.851" />
      <feFuncB type="table" tableValues="0.188 0.210 0.248 0.296 0.352 0.414 0.483 0.557 0.635" />
    </feComponentTransfer>
  </filter>
  <linearGradient id="studio-gold" x1="0" y1="0" x2="1" y2="1">
    {goldStops.map(([offset, token]) => <stop offset={offset} style={`stop-color:var(${token})`} />)}
  </linearGradient>
  <symbol id="i-star"><path d="M8 1.5l1.9 3.95 4.35.6-3.17 3.03.78 4.32L8 11.35 4.14 13.4l.78-4.32L1.75 6.05l4.35-.6L8 1.5z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" /></symbol>
  <symbol id="i-fork" fill="none" stroke="currentColor" stroke-width="1.3"><circle cx="4" cy="3" r="1.6" /><circle cx="12" cy="3" r="1.6" /><circle cx="8" cy="13" r="1.6" /><path d="M4 4.6v1.2c0 1.1.9 2 2 2h4c1.1 0 2-.9 2-2V4.6M8 7.8v3.6" /></symbol>
  <symbol id="i-repo" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"><path d="M3 12.5V3a1.5 1.5 0 0 1 1.5-1.5H13v10H4.5A1.5 1.5 0 0 0 3 13a1.5 1.5 0 0 0 1.5 1.5H6" /><path d="M8 13v2.5l1.25-.9 1.25.9V13" /></symbol>
  <symbol id="i-law" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"><path d="M8 2v12M4 14h8M3 4h10M3 4l-2 5a2 2 0 0 0 4 0L3 4zM13 4l-2 5a2 2 0 0 0 4 0l-2-5z" /></symbol>
</svg>
