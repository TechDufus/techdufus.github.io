---
import { getEntry } from 'astro:content';
import readingTime from 'reading-time';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/prose.css';
import { externalReferences } from '../../data/site';

const [doc, setup] = await Promise.all([getEntry('docs', 'career'), getEntry('docs', 'setup')]);
if (!doc) {
  throw new Error('Missing docs/career content source.');
}

const { Content, headings } = await doc.render();
const stats = readingTime(doc.body);
const minutes = Math.max(1, Math.round(stats.minutes));

// Table of contents: markdown `##` headings plus raw `<h2 id>` blocks (Astro doesn't collect those).
const rawSections = [...doc.body.matchAll(/<h2\s+id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/g)].map((match) => ({
  slug: match[1],
  text: match[2].replace(/<[^>]+>/g, '').trim()
}));
const toc = [...headings.filter((heading) => heading.depth === 2), ...rawSections]
  .filter((heading, index, all) => all.findIndex((other) => other.slug === heading.slug) === index)
  .map((heading) => ({ slug: heading.slug, text: heading.text, at: doc.body.search(new RegExp(`id="${heading.slug}"|^## ${heading.text.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`, 'm')) }))
  .sort((a, b) => a.at - b.at);
const hasToc = toc.length >= 2;
const n = (index: number) => String(index + 1).padStart(2, '0');

---

<BaseLayout title="Docs: Career" description={doc.data.description}>
  <article class="doc" aria-labelledby="doc-title">
    <header class="post-head">
      <div class="wrap post-grid">
        <div class="col-rail post-head__rail" data-reveal>
          <span class="sec-head__index">Docs · 02</span>
          <span class="eyebrow">Background</span>
        </div>
        <div class="col-main">
          <nav class="crumbs meta" aria-label="Breadcrumb" data-reveal>
            <a href="/docs/"><span class="arrow" aria-hidden="true">→</span> All docs</a>
            <span class="crumbs__sep" aria-hidden="true"></span>
            <span>{doc.data.title}</span>
          </nav>
          <h1 class="post-title" id="doc-title" data-reveal style="--d:1">{doc.data.title} <em class="foil">notes</em></h1>
          <p class="lede doc-lede" data-reveal style="--d:1">{doc.data.description}</p>
          <dl class="post-meta" data-reveal style="--d:2">
            <div><dt>Reading</dt><dd>{minutes} min</dd></div>
            <div><dt>Length</dt><dd>{stats.words.toLocaleString('en-US')} <span class="muted">words</span></dd></div>
            <div><dt>Sections</dt><dd>{toc.length}</dd></div>
            <div><dt>Now</dt><dd>Senior DevSecOps <span class="muted">at Raft</span></dd></div>
          </dl>
          <div class="post-head__foot" data-reveal style="--d:3">
            <a class="chip chip--accent doc-cross" href="/about/">The short version: about me <span class="arrow" aria-hidden="true">→</span></a>
            <span class="meta">Want to talk shop? <a class="link link--quiet" href="/contact/">Get in touch</a></span>
          </div>
        </div>
      </div>
    </header>

    <div class="post-body">
      <div class="wrap post-grid">
        {
          hasToc && (
            <aside class="col-rail" aria-label="Reading aids">
              <div class="rail">
                <nav aria-labelledby="toc-label">
                  <div class="rail__label">
                    <span class="eyebrow" id="toc-label">On this page</span>
                    <span class="rail__left">{minutes} min</span>
                  </div>
                  <ol class="toc">
                    {toc.map((item, index) => (
                      <li><a href={`#${item.slug}`} data-toc-link={item.slug}><span class="n" aria-hidden="true">{n(index)}</span><span>{item.text}</span></a></li>
                    ))}
                  </ol>
                </nav>
                <a class="rail__top" href="#main" data-to-top data-hidden><span class="arrow" aria-hidden="true">→</span> Back to top</a>
              </div>
            </aside>
          )
        }

        <div class="col-main">
          {
            hasToc && (
              <details class="toc-bar" data-toc-bar>
                <summary>
                  <span class="toc-bar__label">Contents</span>
                  <span class="toc-bar__current" data-toc-current>{toc[0].text}</span>
                  <span class="toc-bar__chev" aria-hidden="true"></span>
                </summary>
                <nav aria-label="Contents">
                  <ol class="toc">
                    {toc.map((item, index) => (
                      <li><a href={`#${item.slug}`} data-toc-link={item.slug}><span class="n" aria-hidden="true">{n(index)}</span><span>{item.text}</span></a></li>
                    ))}
                  </ol>
                </nav>
              </details>
            )
          }

          <div class="prose">
            <Content />
          </div>

          {
            externalReferences.length > 0 && (
              <section class="doc-refs" aria-labelledby="refs-title">
                <h2 class="eyebrow" id="refs-title">Related references</h2>
                <ul>
                  {externalReferences.map((reference) => (
                    <li><a class="link" href={reference.href} target="_blank" rel="noopener">{reference.title} <span class="arrow--ne" aria-hidden="true">↗</span></a></li>
                  ))}
                </ul>
              </section>
            )
          }

          <nav class="doc-after" aria-label="Related pages">
            <div class="doc-link">
              <span class="doc-link__k">About <span class="arrow" aria-hidden="true">→</span></span>
              <p class="doc-link__t"><a href="/about/">The short <em>version</em></a></p>
              <p>Who I am, what I'm focused on now, and how I operate.</p>
            </div>
            <div class="doc-link">
              <span class="doc-link__k">Docs · 01 <span class="arrow" aria-hidden="true">→</span></span>
              <p class="doc-link__t"><a href="/docs/setup/">Setup <em>notes</em></a></p>
              {setup && <p>{setup.data.description}</p>}
            </div>
          </nav>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // Contents: highlight the section in view, close the phone contents bar on jump or Esc.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const targets = [...new Set(links.map((link) => link.dataset.tocLink ?? ''))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (targets.length > 0) {
    const bar = document.querySelector<HTMLDetailsElement>('[data-toc-bar]');
    const current = document.querySelector('[data-toc-current]');
    const toTop = document.querySelector('[data-to-top]');
    let active = '';
    let ticking = false;

    const update = () => {
      ticking = false;
      const line = Math.min(window.innerHeight * 0.3, 260) + 60;
      let id = targets[0].id;
      for (const el of targets) if (el.getBoundingClientRect().top <= line) id = el.id;
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) id = targets[targets.length - 1].id;
      toTop?.toggleAttribute('data-hidden', window.scrollY < 480);
      if (id === active) return;
      active = id;
      links.forEach((link) => {
        const on = link.dataset.tocLink === id;
        link.classList.toggle('is-active', on);
        if (on) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      const heading = targets.find((el) => el.id === id);
      if (current && heading) current.textContent = heading.textContent?.trim() ?? '';
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();

    bar?.addEventListener('click', (event) => {
      if ((event.target as Element | null)?.closest('a')) bar.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && bar?.open) {
        bar.open = false;
        bar.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  /* Studio article layout (design/pro-studio/post.html), trimmed for reference docs. */
  :global(html) { scroll-padding-top: calc(var(--nav-h) + 36px); }

  .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 680px) minmax(0, 1fr);
    column-gap: clamp(32px, 4vw, 64px);
  }
  .post-grid > .col-main { grid-column: 2; min-width: 0; }
  .post-grid > .col-rail { grid-column: 1; min-width: 0; }

  .post-head { padding-block: clamp(40px, 6vw, 88px) clamp(40px, 5vw, 64px); }
  .post-head__rail { display: grid; align-content: start; gap: 6px; padding-top: 14px; }
  .post-head__rail .sec-head__index { font-size: var(--fs-xs); }
  .crumbs { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; color: var(--faint); }
  .crumbs a { color: var(--muted); transition: color var(--t-1) ease; }
  .crumbs a:hover { color: var(--ink); }
  .crumbs .arrow { transform: scaleX(-1); }
  .crumbs a:hover .arrow { transform: scaleX(-1) translateX(3px); }
  .crumbs__sep { width: 18px; height: 1px; background: var(--line-3); }
  .post-title {
    font-family: var(--font-display); font-weight: 400;
    font-size: clamp(2.5rem, 1.35rem + 3.5vw, 4.25rem); line-height: 1.02; letter-spacing: -0.02em;
    color: var(--ink); text-wrap: balance;
  }
  .post-title em { font-style: italic; color: var(--accent); }
  .doc-lede { margin-top: 20px; }

  .post-meta {
    display: grid; grid-template-columns: repeat(3, auto) minmax(0, 1fr); gap: 0;
    margin-top: clamp(32px, 4vw, 44px); border-block: 1px solid var(--line);
  }
  .post-meta > div { display: grid; gap: 4px; align-content: start; padding: 14px 24px 16px 0; }
  .post-meta > div + div { padding-left: 24px; border-left: 1px solid var(--line); }
  .post-meta dt { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .post-meta dd { color: var(--ink); font-size: 0.975rem; font-variant-numeric: tabular-nums; }
  .post-meta dd .muted { font-size: 0.9rem; }

  .post-head__foot { display: flex; align-items: center; justify-content: space-between; gap: 12px 20px; flex-wrap: wrap; margin-top: 20px; }
  .doc-cross { height: 32px; padding: 0 14px; gap: 8px; font-size: 0.8125rem; }
  .doc-cross .arrow { color: var(--accent); }

  .post-body { padding-bottom: clamp(56px, 7vw, 96px); }
  .rail { position: sticky; top: calc(var(--nav-h) + 40px); display: grid; gap: 28px; max-width: 220px; padding-top: 6px; }
  .rail__label { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .rail__label .eyebrow { color: var(--faint); }
  .rail__left { font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .toc a { position: relative; display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 4px; align-items: baseline; }
  .toc a .n { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--faint); opacity: 0.75; }
  .toc a.is-active .n { color: var(--accent); opacity: 1; }
  .rail__top { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 0.75rem; color: var(--faint); transition: color var(--t-1) ease, opacity var(--t-2) ease; justify-self: start; }
  .rail__top:hover { color: var(--ink); }
  .rail__top .arrow { transform: rotate(-90deg); }
  .rail__top[data-hidden] { opacity: 0; pointer-events: none; }
  .toc-bar { display: none; }

  .doc-refs { margin-top: clamp(48px, 6vw, 72px); display: grid; gap: 14px; }
  .doc-refs ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .doc-refs li { padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 0.975rem; }

  .doc-after { margin-top: clamp(56px, 7vw, 88px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-block: 1px solid var(--line); }
  .doc-link { position: relative; display: grid; gap: 8px; align-content: start; padding: 28px 24px 28px 0; }
  .doc-link + .doc-link { padding: 28px 0 28px 24px; border-left: 1px solid var(--line); }
  .doc-link__k { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .doc-link__t { font-family: var(--font-display); font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.125rem); line-height: 1.12; letter-spacing: -0.012em; color: var(--ink); text-wrap: balance; }
  .doc-link__t em { font-style: italic; color: var(--accent); }
  .doc-link__t a { transition: color var(--t-1) ease; }
  .doc-link__t a::after { content: ""; position: absolute; inset: 0; }
  .doc-link:hover .doc-link__t a { color: var(--accent-hi); }
  .doc-link:hover .arrow { transform: translateX(3px); }
  .doc-link p:last-child { color: var(--muted); font-size: 0.975rem; }

  @media (max-width: 1119px) {
    .post-grid { grid-template-columns: minmax(0, 1fr); max-width: calc(720px + var(--gutter) * 2); }
    .post-grid > .col-main, .post-grid > .col-rail { grid-column: 1; }
    .post-body .col-rail { display: none; }
    .post-head__rail { display: flex; align-items: center; gap: 12px; padding-top: 0; margin-bottom: 20px; }
    .crumbs { margin-bottom: 20px; }
    :global(html) { scroll-padding-top: calc(var(--nav-h) + 72px); }

    .toc-bar {
      display: block; position: sticky; top: var(--nav-h); z-index: 40;
      margin-bottom: 36px; margin-inline: calc(var(--gutter) * -1);
      background: color-mix(in srgb, var(--bg) 90%, transparent);
      -webkit-backdrop-filter: saturate(140%) blur(14px); backdrop-filter: saturate(140%) blur(14px);
      border-block: 1px solid var(--line);
    }
    .toc-bar summary { display: flex; align-items: center; gap: 12px; height: 48px; padding-inline: var(--gutter); list-style: none; cursor: pointer; font-size: 0.9375rem; }
    .toc-bar summary::-webkit-details-marker { display: none; }
    .toc-bar__label { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); flex: none; }
    .toc-bar__current { flex: 1; min-width: 0; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .toc-bar__chev { width: 10px; height: 10px; flex: none; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: translateY(-3px) rotate(45deg); transition: transform var(--t-2) var(--ease-out); }
    .toc-bar[open] .toc-bar__chev { transform: translateY(2px) rotate(-135deg); }
    .toc-bar > nav {
      position: absolute; left: 0; right: 0; top: 100%; padding: 6px var(--gutter) 18px;
      background: color-mix(in srgb, var(--bg) 97%, transparent); border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.8);
      max-height: calc(100dvh - var(--nav-h) - 60px); overflow-y: auto;
    }
    .toc-bar .toc a { padding-block: 9px; }
  }
  @media (max-width: 640px) {
    .post-meta { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .post-meta > div { padding: 12px 12px 14px 0; }
    .post-meta > div + div { padding-left: 14px; }
    .post-meta > div:last-child { grid-column: 1 / -1; padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
    .prose { font-size: 1.0625rem; }
    .doc-after { grid-template-columns: minmax(0, 1fr); }
    .doc-link + .doc-link { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
