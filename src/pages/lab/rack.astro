---
/*
  /lab/rack/: Sheet 01 · The cabinet (TD-LAB-01). The drawing is src/components/drawing/rack/
  CabinetSheet.astro; everything below it is the text equivalent, generated from the same data
  (src/data/hardware/rack.ts): the device and link schedules, totals, open questions and sources.
  The front, side and rear views and the detail cards load from /lab/rack/views/ (rack.ts).
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import CabinetSheet from '../../components/drawing/rack/CabinetSheet.astro';
import ProvChip from '../../components/drawing/ProvChip.astro';
import type { Device, Fact, Source } from '../../data/hardware/types';
import { CAB, DWG, ORDER, balloonOf, cabinet, derived, dev, devices, links, offSheet, slotOf$, sources, stack, uText } from '../../components/drawing/rack/model';

type SourceKey = keyof typeof sources;
const src = (f?: { source?: string }): Source | undefined => (f?.source ? sources[f.source as SourceKey] : undefined);
const nameOf = (id: string) => (id in offSheet ? 'ISP (off sheet)' : dev(id).short);
const rows = ORDER.map((id) => dev(id));
const fmt = (n?: number, unit = '') => (n === undefined ? '—' : `${n}${unit}`);
const airflow: Record<string, string> = {
  'front-to-back': 'Front → back',
  'back-to-front': 'Back → front',
  'side-to-side': 'Side to side',
  passive: 'Passive',
  unknown: 'Not documented',
};

// Every vendor document a fact on this sheet points at, in the order first used.
const used = new Set<SourceKey>();
const collect = (f?: Fact<unknown>) => f?.source && used.add(f.source as SourceKey);
for (const d of devices) {
  for (const f of [d.u, d.body, d.mass, d.maxPower, d.airflow, ...d.specs.map((s) => s.fact)]) collect(f);
  for (const p of [d.panels?.front, d.panels?.rear]) if (p?.source) used.add(p.source as SourceKey);
}
collect(cabinet.reference);
const sourceList: Source[] = [...used].map((k) => sources[k]);

const r720 = dev('r720xd');
const range = derived.nameplateRangeW.value;
const questions = [
  { t: 'Where exactly is everything?', d: 'The top-to-bottom order comes from a Nov 2024 photo. The UNAS Pro 8 isn’t in that photo, so its slot is my call. Every U number on this sheet waits for a tape measure.' },
  { t: 'Which cabinet is it?', d: 'It’s a 42U enclosed cabinet with a glass door. The make and size are unknown, so the sheet borrows the published size of an APC AR3100.' },
  { t: 'Are the shelf and patch panel still there?', d: 'Both are in the Nov 2024 photo. I haven’t checked since.' },
  { t: 'How much RAM is in the R720xd?', d: 'My notes say 256 GB. The OS saw 125 GiB usable on 2026-09-27. Memory mirroring or missing DIMMs would explain it. Sheet 02 has both numbers.' },
  { t: 'What PSUs are in the R720xd?', d: 'Two, redundant, wattage unknown. That’s why the power total is a range.' },
  { t: 'Which SFP+ cage on the UNAS, and DAC or optics?', d: 'The link is measured at 10 GbE. The cage and the cable type aren’t recorded.' },
];
---

<BaseLayout
  title="Sheet 01 · The cabinet"
  description="My homelab's 42U cabinet as an engineering drawing: every box at its U position, front, side and rear views, network links, airflow and power, drawn from the manufacturers' specs."
>
  <div class="pg-rack">
    <section class="wrap rk-hero" aria-labelledby="rk-title">
      <p class="eyebrow rk-hero__eyebrow">Lab · Sheet 01</p>
      <h1 class="h1" id="rk-title">The <em>cabinet</em>.</h1>
      <p class="lede rk-hero__lede">Everything in the 42U, drawn from the manufacturers’ specs. Where things sit is my best guess until I measure.</p>
      <p class="rk-hero__links">
        <a class="link link--quiet" href="/lab/"><span aria-hidden="true">←</span> The lab</a>
        <a class="link link--quiet" href="/lab/r720xd/">Sheet 02 · The server <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </section>

    <div class="rk-sheet" data-rack-views="/lab/rack/views/">
      <CabinetSheet id={DWG} />
    </div>

    <section class="wrap rk-detail" data-rack-detail aria-live="polite" aria-label="Selected device">
      <p class="rk-detail__empty" data-rack-empty>Pick a box in the drawing, or a name in the schedule below. Its details land here.</p>
      <div data-rack-card></div>
    </section>

    <!-- ============ 01 · SCHEDULE ============ -->
    <section class="section section--tight" aria-labelledby="rk-bom">
      <div class="wrap">
        <SectionHead index={1} label="Device schedule" title="What’s <em>in</em> it." titleId="rk-bom" lede="Balloon numbers match the drawing. The last two live elsewhere." />
        <div class="rk-scroll" role="region" aria-label="Device schedule" tabindex="0">
          <table class="rk-table">
            <thead>
              <tr><th scope="col">No.</th><th scope="col">Device</th><th scope="col">U</th><th scope="col">Height</th><th scope="col">Depth</th><th scope="col">Mass</th><th scope="col">Max power</th><th scope="col">Airflow</th><th scope="col">Source</th></tr>
            </thead>
            <tbody>
              {rows.map((d: Device) => {
                const s = src(d.body) ?? src(d.panels?.front);
                return (
                  <tr>
                    <td class="rk-n">{balloonOf(d.id)}</td>
                    <th scope="row"><button type="button" class="rk-pick" data-pick={d.id}>{d.short}</button></th>
                    <td>{d.location === 'cabinet' ? uText(d) : d.mount === 'desk' ? 'Desk' : 'Ceiling/wall'} {d.u && <ProvChip prov={d.u.prov} compact />}</td>
                    <td>{d.heightU ? `${d.heightU}U` : `${d.body.value.h} mm`}</td>
                    <td class="num">{d.location === 'cabinet' ? slotOf$(d.id).body.d : d.body.value.d}</td>
                    <td class="num">{fmt(d.mass?.value, ' kg')}</td>
                    <td class="num">{d.maxPower ? `${d.maxPower.value} W` : d.id === 'r720xd' ? '? W' : '—'}</td>
                    <td>{d.airflow ? airflow[d.airflow.value] : '—'}</td>
                    <td><ProvChip prov={d.body.prov} compact /> {s ? s.publisher : d.seenInPhoto?.value ? 'Nov 2024 photo' : 'Guess'}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <p class="rk-foot">Depth is the body, front to back, in mm. Max power is the nameplate figure, not a measurement. The Pi’s 15 W is its power supply’s rating. The R720xd’s PSU wattage is unknown.</p>
      </div>
    </section>

    <!-- ============ 02 · LINKS ============ -->
    <section class="section section--tight" aria-labelledby="rk-links">
      <div class="wrap">
        <SectionHead index={2} label="Link schedule" title="What’s <em>plugged</em> into what." titleId="rk-links" lede="Only the links I’ve actually read off the gateway." />
        <div class="rk-scroll" role="region" aria-label="Link schedule" tabindex="0">
          <table class="rk-table">
            <thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Speed</th><th scope="col">Medium</th><th scope="col">Read</th></tr></thead>
            <tbody>
              {links.map((l) => (
                <tr>
                  <th scope="row">{nameOf(l.from.device)} · {l.from.port}</th>
                  <td>{nameOf(l.to.device)} · {l.to.port}</td>
                  <td class={l.speed.startsWith('10') ? 'rk-10g' : undefined}>{l.speed}</td>
                  <td>{l.medium ?? 'Not recorded'}</td>
                  <td><ProvChip prov={l.prov} asOf={l.asOf} /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="rk-foot">Not shown because they aren’t documented: the U7 Pro’s and the Flex Mini’s uplinks, and whatever runs through the patch panel.</p>
      </div>
    </section>

    <!-- ============ 03 · TOTALS ============ -->
    <section class="section section--tight" aria-labelledby="rk-totals">
      <div class="wrap">
        <SectionHead index={3} label="Totals" title="Adding it <em>up</em>." titleId="rk-totals" lede="All worked out from the numbers above, so treat them as sums, not measurements." />
        <dl class="rk-totals">
          <div><dt>Rack units</dt><dd><strong>{derived.uUsed.value}U used</strong> · {derived.uFree.value}U free of {CAB.units}U <ProvChip prov="inferred" /></dd><dd class="rk-note">Shelf, patch panel, UDM Pro, UNAS Pro 8 and R720xd, U{stack.from}–{stack.to}. The Pi stands on the shelf.</dd></div>
          <div><dt>Power, nameplate</dt><dd><strong>{range.min}–{range.max} W</strong> <ProvChip prov="inferred" /></dd><dd class="rk-note">{derived.nameplateKnownW.value} W for the UDM Pro, the UNAS Pro 8 and the Pi’s supply, plus one R720xd PSU at 495 or 1100 W. It’s a ceiling, not a reading.</dd></div>
          <div><dt>Racked mass</dt><dd><strong>{derived.rackedMassKg.value} kg</strong> <ProvChip prov="inferred" /></dd><dd class="rk-note">The R720xd at Dell’s maximum weight, the UNAS without drives, and the UDM Pro. Not counted: the shelf, the patch panel and the drives.</dd></div>
        </dl>
      </div>
    </section>

    <!-- ============ 04 · OPEN QUESTIONS ============ -->
    <section class="section section--tight" aria-labelledby="rk-open">
      <div class="wrap">
        <SectionHead index={4} label="Field notes" title="Still <em>open</em>." titleId="rk-open" lede="Things to check with a tape measure and a flashlight." />
        <ol class="rk-open">
          {questions.map((q) => <li><strong>{q.t}</strong> {q.d}</li>)}
        </ol>
      </div>
    </section>

    <!-- ============ 05 · SOURCES ============ -->
    <section class="section section--tight" aria-labelledby="rk-src">
      <div class="wrap rk-split">
        <div>
          <SectionHead index={5} label="Sources" title="Where the <em>numbers</em> come from." titleId="rk-src" />
          <ul class="rk-sources">
            {sourceList.map((s) => <li><a href={s.href} rel="noopener">{s.title}</a> <span>{s.publisher}{s.archiveOf && ' · archived copy'}</span></li>)}
          </ul>
        </div>
        <aside class="rk-colophon" aria-labelledby="rk-how">
          <h2 class="h4" id="rk-how">How this was drawn</h2>
          <p>I didn’t draw any of this by hand. Every line is generated at build time from typed data in git: box sizes from the vendor PDFs, panel layouts traced from their product photos, U positions from my best guess. No images, no WebGL. When I finally measure the rack, I change a few numbers and the whole sheet redraws.</p>
          <p class="rk-next">
            <a class="link" href={r720.sheetHref}>Sheet 02 · The server <span class="arrow" aria-hidden="true">→</span></a>
            <a class="link" href="/blog/from-hardware-raid-to-zfs/">The post: from hardware RAID to ZFS <span class="arrow" aria-hidden="true">→</span></a>
          </p>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import '../../components/drawing/rack/rack';
</script>

<style is:global>
  .pg-rack .rk-hero { padding-block: clamp(40px, 6vw, 80px) clamp(28px, 4vw, 44px); }
  .pg-rack .rk-hero__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .pg-rack .rk-hero__eyebrow::before { content: ""; width: 28px; height: 1px; background: var(--gold-line); }
  .pg-rack .rk-hero__lede { margin-top: 20px; max-width: 58ch; }
  .pg-rack .rk-hero__links { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 24px; font-size: var(--fs-sm); }
  .pg-rack .rk-sheet { max-width: 1400px; margin-inline: auto; padding-inline: var(--gutter); }
  .pg-rack .rk-free .hatch { opacity: 0.45; }
  /* the R720xd's phantom 'extended' outline steps aside while the real one is pulled out */
  .pg-rack .rk-ghost { transition: opacity var(--t-2) ease; }
  .pg-rack .dwg:has([data-part="r720xd"][aria-pressed="true"]) .rk-ghost { opacity: 0; }

  .pg-rack .rk-detail { margin-top: 20px; min-height: 64px; }
  .pg-rack .rk-detail__empty { margin: 0; padding: 18px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font: 0.8125rem/1.5 var(--font-mono); letter-spacing: 0.04em; color: var(--muted); }
  .pg-rack .rk-card { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 8px 48px; padding: 28px 0 32px; border-top: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); }
  .pg-rack .rk-card__specs { margin: 0; }
  .pg-rack .rk-card__meta { display: flex; align-items: center; gap: 12px; margin: 0; font: 0.75rem/1.2 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .pg-rack .rk-card__n { display: inline-grid; place-items: center; width: 26px; height: 26px; border: 1px solid var(--gold); border-radius: 50%; color: var(--gold-light); letter-spacing: 0; }
  .pg-rack .rk-card__t { margin: 12px 0 0; font: 400 clamp(1.75rem, 1.3rem + 1.2vw, 2.25rem)/1.1 var(--font-display); color: var(--ink); }
  .pg-rack .rk-card__role { margin: 10px 0 0; color: var(--ink-2); max-width: 40ch; }
  .pg-rack .rk-card__more { display: inline-block; margin-top: 20px; }
  .pg-rack .rk-card__specs > div { display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 16px; padding: 7px 0; border-bottom: 1px solid var(--line); }
  .pg-rack .rk-card__specs dt { font: 0.6875rem/1.9 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--faint); }
  .pg-rack .rk-card__specs dd { margin: 0; font-size: var(--fs-sm); color: var(--ink-2); }
  .pg-rack .rk-card__h { margin: 18px 0 6px; font: 0.6875rem/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .pg-rack .rk-card__ports { margin: 0; padding: 0; list-style: none; font-size: var(--fs-sm); color: var(--ink-2); }
  .pg-rack .rk-card__ports li { padding: 3px 0; }
  .pg-rack .rk-card__ports span { color: var(--faint); }

  .pg-rack .rk-scroll { position: relative; overflow-x: auto; margin-top: 32px; scrollbar-width: thin; }
  .pg-rack .rk-scroll:focus-visible { outline-offset: 4px; }
  .pg-rack .rk-table { width: 100%; min-width: 720px; border-collapse: collapse; font-size: var(--fs-sm); }
  .pg-rack .rk-table :is(th, td) { padding: 12px 14px 12px 0; border-bottom: 1px solid var(--line); text-align: left; vertical-align: baseline; color: var(--ink-2); font-weight: 400; }
  .pg-rack .rk-table thead th { font: 500 0.6875rem/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); border-top: 1px solid var(--line-2); }
  .pg-rack .rk-table tbody th { color: var(--ink); }
  .pg-rack .rk-table .num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .pg-rack .rk-n { font-family: var(--font-mono); color: var(--gold-light); width: 3rem; }
  .pg-rack .rk-10g { color: var(--gold-light); }
  .pg-rack .rk-pick { white-space: nowrap; padding: 0; border: 0; background: none; font: inherit; color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent-line); text-underline-offset: 4px; cursor: pointer; }
  .pg-rack .rk-pick:hover { color: var(--gold-light); }
  .pg-rack .rk-table a { color: var(--ink-2); text-decoration: underline; text-decoration-color: var(--accent-line); text-underline-offset: 3px; }
  .pg-rack .rk-foot { margin: 16px 0 0; max-width: 72ch; font-size: var(--fs-sm); color: var(--muted); }

  .pg-rack .rk-totals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin: 32px 0 0; }
  .pg-rack .rk-totals > div { padding-top: 16px; border-top: 1px solid var(--line-2); }
  .pg-rack .rk-totals dt { font: 500 0.6875rem/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); }
  .pg-rack .rk-totals dd { margin: 12px 0 0; color: var(--ink-2); }
  .pg-rack .rk-totals strong { font: 400 1.75rem/1.1 var(--font-display); color: var(--ink); margin-right: 6px; }
  .pg-rack .rk-totals .rk-note { font-size: var(--fs-sm); color: var(--muted); }

  .pg-rack .rk-open { margin: 32px 0 0; padding: 0; list-style: none; counter-reset: q; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; }
  .pg-rack .rk-open li { counter-increment: q; position: relative; padding: 16px 0 16px 44px; border-top: 1px solid var(--line); color: var(--ink-2); font-size: var(--fs-sm); }
  .pg-rack .rk-open li::before { content: counter(q, decimal-leading-zero); position: absolute; left: 0; top: 18px; font: 0.75rem var(--font-mono); color: var(--gold-light); }
  .pg-rack .rk-open strong { display: block; margin-bottom: 4px; font-weight: 500; color: var(--ink); font-size: var(--fs-base); }

  .pg-rack .rk-split { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .pg-rack .rk-sources { margin: 28px 0 0; padding: 0; list-style: none; font-size: var(--fs-sm); }
  .pg-rack .rk-sources li { padding: 10px 0; border-top: 1px solid var(--line); }
  .pg-rack .rk-sources a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent-line); text-underline-offset: 3px; }
  .pg-rack .rk-sources span { display: block; margin-top: 2px; font: 0.6875rem/1.4 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); }
  .pg-rack .rk-colophon { padding: 24px; border: 1px solid var(--line-2); background: var(--surface-lit); }
  .pg-rack .rk-colophon p { margin: 12px 0 0; color: var(--ink-2); font-size: var(--fs-sm); }
  .pg-rack .rk-next { display: grid; gap: 10px; margin-top: 20px !important; }

  @media (max-width: 860px) {
    .pg-rack .rk-card { grid-template-columns: minmax(0, 1fr); }
    .pg-rack .rk-card__specs { margin-top: 16px; }
    .pg-rack .rk-card__specs > div { grid-template-columns: 8.5rem minmax(0, 1fr); gap: 12px; }
    .pg-rack .rk-totals, .pg-rack .rk-open, .pg-rack .rk-split { grid-template-columns: minmax(0, 1fr); }
  }
</style>
