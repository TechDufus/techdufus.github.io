---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import SupportCards from '../components/ui/SupportCards.astro';
import SpecList from '../components/ui/SpecList.astro';
import { pad2 } from '../components/ui/format';
import { supportLinks } from '../data/site';

type SupportMeta = { lane: string; commitment: string; command: string; recommended?: boolean };

const supportMetaByLabel: Record<string, SupportMeta> = {
  'Buy Me a Coffee': { lane: 'One-time', commitment: 'One-time or monthly', command: 'coffee' },
  'GitHub Sponsors': { lane: 'Monthly', commitment: 'Recurring sponsorship', command: 'sponsor', recommended: true }
};

const defaultSupportMeta: SupportMeta = { lane: 'Optional', commitment: 'Optional support', command: 'support' };

const supportChannels = supportLinks.map((link) => ({
  ...link,
  ...(supportMetaByLabel[link.label] ?? defaultSupportMeta)
}));

const oneTimeRoute = supportChannels.find((channel) => channel.lane === 'One-time');
const monthlyRoute = supportChannels.find((channel) => channel.lane === 'Monthly');

const laneRows = supportChannels.map((channel) => ({
  k: `${channel.lane} support`,
  v: channel.label,
  href: channel.href,
  note: channel.recommended ? `${channel.commitment} · most sustainable` : channel.commitment
}));

const supportImpact = [
  { label: 'Lab costs', detail: 'Offsets hosting, hardware, and homelab rebuild costs behind the examples.', lane: '/infra' },
  { label: 'Writing time', detail: 'Creates room to turn rough incident notes into practical, searchable docs.', lane: '/docs' },
  { label: 'Open source upkeep', detail: 'Supports maintenance, issue triage, and updates across active repos.', lane: '/oss' }
];
---

<BaseLayout
  title="Support"
  description="Support TechDufus if the content helped. Everything stays free, and support is optional."
>
  <!-- ============ Header ============ -->
  <header class="head wrap" aria-labelledby="page-title">
    <div class="head__grid">
      <div>
        <p class="eyebrow head__eyebrow" data-reveal>Support</p>
        <h1 class="display" id="page-title" data-reveal style="--d:1">Keep the notes free. Support if it feels <em>worth it</em>.</h1>
        <p class="lede" data-reveal style="--d:2">
          Every post and doc on this site stays free. No paywall and no premium tier. Support is optional, and it helps me
          keep publishing practical writeups from real platform work.
        </p>
        <div class="head__ctas" data-reveal style="--d:3">
          {monthlyRoute && (
            <a class="btn btn--primary btn--lg" href={monthlyRoute.href} target="_blank" rel="noopener">
              Monthly support · {monthlyRoute.label} <span class="arrow" aria-hidden="true">↗</span>
            </a>
          )}
          {oneTimeRoute && (
            <a class="btn btn--ghost btn--lg" href={oneTimeRoute.href} target="_blank" rel="noopener">
              One-time support · {oneTimeRoute.label}
            </a>
          )}
        </div>
      </div>
      <div class="head__side" data-reveal style="--d:3">
        <h2 class="side__h">Support lanes</h2>
        <SpecList rows={laneRows} label="Support lanes" />
      </div>
    </div>
  </header>

  <!-- ============ 01 · Lanes ============ -->
  <section id="lanes" class="section" aria-labelledby="lanes-title">
    <div class="wrap">
      <SectionHead
        index={1}
        label="Choose your support lane"
        titleId="lanes-title"
        title="Pick whichever platform you already <em>trust</em>."
      />
      <SupportCards />
    </div>
  </section>

  <!-- ============ 02 · What it enables ============ -->
  <section id="enables" class="section" aria-labelledby="enables-title">
    <div class="wrap">
      <SectionHead
        index={2}
        label="What support enables"
        titleId="enables-title"
        title="Directly funds the work that keeps this site <em>useful</em>."
      />
      <ul class="impact">
        {supportImpact.map((item, i) => (
          <li data-reveal style={`--d:${i}`}>
            <span class="meta">{pad2(i + 1)}</span>
            <h3 class="h3">{item.label}</h3>
            <p>{item.detail}</p>
            <span class="chip chip--quiet">{item.lane}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 03 · No pressure ============ -->
  <section id="no-pressure" class="section" aria-labelledby="policy-title">
    <div class="wrap">
      <SectionHead index={3} label="No pressure policy" bare />
      <div class="split">
        <div class="policy" data-reveal>
          <h2 class="h2" id="policy-title">Everything here stays free <em>either way</em>.</h2>
          <p>
            No paywall, no premium tier, and no gated docs. If support feels worth it, I appreciate it. If not, keep using
            the posts and docs exactly the same way.
          </p>
          <div class="policy__ctas">
            <a class="btn btn--ghost" href="/blog/">Read latest posts <span class="arrow" aria-hidden="true">-&gt;</span></a>
            <a class="btn btn--quiet" href="/docs/">Browse docs</a>
          </div>
        </div>
        <div class="thanks" data-reveal style="--d:1">
          <p class="quote">Thank you for reading. That part already means a lot.</p>
          <p class="meta">Matthew · TechDufus</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page head (mockup blog.html .head) */
  .head { padding-block: clamp(40px, 7vw, 104px) clamp(48px, 6vw, 88px); }
  .head__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(40px, 6vw, 112px); align-items: end; }
  .head__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
  .head__eyebrow::before { content: ""; width: 28px; height: 1px; background: var(--gold-line); }
  .head .display { max-width: 14ch; }
  .head .lede { margin-top: 28px; }
  .head__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .head__side { display: grid; gap: 18px; }
  .side__h { font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); font-weight: 500; }
  .head__side :global(.spec > div) { grid-template-columns: 140px minmax(0, 1fr); padding: 12px 0; }
  .head__side :global(.spec a) { text-decoration: underline; text-decoration-color: var(--accent-line); text-underline-offset: 3px; transition: color var(--t-1) ease; }
  .head__side :global(.spec a:hover) { color: var(--accent-hi); }
  .head__side :global(.spec dd small) { display: block; margin: 2px 0 0; }
  @media (max-width: 960px) { .head__grid { grid-template-columns: minmax(0, 1fr); align-items: start; } }
  @media (max-width: 640px) { .head__ctas .btn { width: 100%; } }

  /* What support enables (mockup .operate rhythm) */
  .impact { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 3vw, 40px); }
  .impact li { display: grid; gap: 10px; align-content: start; justify-items: start; padding-top: 18px; border-top: 1px solid var(--line); }
  .impact .meta { color: var(--accent); }
  .impact p { color: var(--muted); font-size: 0.975rem; line-height: 1.55; }
  @media (max-width: 960px) { .impact { grid-template-columns: minmax(0, 1fr); } }

  .policy p { margin-top: 24px; color: var(--ink-2); font-size: 1.0625rem; max-width: 56ch; }
  .policy__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .thanks::before { content: ""; display: block; width: 32px; height: 1px; background: var(--gold-line); margin-bottom: 28px; }
  .thanks .meta { margin-top: 14px; }
  #lanes :global(.support) { margin-top: 0; }
</style>
