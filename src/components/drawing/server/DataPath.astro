---
/*
  DataPath: the storage data path as a compact strip, left to right:
  disks → SAS expander (backplane) → controller → what the OS sees.
    before  PERC H710P Mini, hardware RAID: the OS sees virtual disks
    after   HBA330, pass-through: the OS sees every disk, ZFS on top (planned)
    both    the boxes once, each state's lettering in g.swap-b / g.swap-a (the page shows one)
  Paper units; put it inside any drawing SVG (Sheet or figure).

  <DataPath x={80} y={600} w={680} state="after" />
*/
import Particles from '../Particles.astro';
import { r720xd } from '../../../data/hardware/r720xd';

interface Props {
  x: number;
  y: number;
  w: number;
  state: 'before' | 'after' | 'both';
  /** dots along the path (off for static figures) */
  flow?: boolean;
}
const { x, y, w, state, flow = true } = Astro.props;

type Stage = { t: string; s: string; cls?: string };
const kept = r720xd.drives.filter((d) => d.fate === 'keep').length;
const ssd = r720xd.drives.filter((d) => d.kind === 'ssd').length;
const pools = r720xd.pools.map((p) => p.id.toUpperCase()).join(' ');
const text: Record<'before' | 'after', Stage[]> = {
  before: [
    { t: `${r720xd.drives.length} DISKS`, s: `${ssd} SSD + ${r720xd.drives.length - ssd} SAS` },
    { t: 'SAS EXPANDER', s: 'ON THE BACKPLANE' },
    { t: 'PERC H710P MINI', s: 'HARDWARE RAID', cls: 'sem-removed' },
    { t: 'OS: 4 VIRTUAL', s: 'DISKS, NOT DRIVES' },
  ],
  after: [
    { t: `${kept} DISKS`, s: 'FAILING SAS OUT' },
    { t: 'SAS EXPANDER', s: 'SAME · 2 UPLINKS' },
    { t: 'HBA330', s: 'PASS-THROUGH', cls: 'sem-new' },
    { t: `OS: ${kept} DISKS`, s: `ZFS: ${pools}`, cls: 'sem-new' },
  ],
};
const states = state === 'both' ? (['before', 'after'] as const) : [state];
const GAP = 34, BH = 44, N = 4;
const bw = (w - GAP * (N - 1)) / N;
const f = (v: number) => String(Math.round(v * 10) / 10);
const mid = y + BH / 2;
const line = `M${f(x + 4)} ${f(mid)}H${f(x + w - 4)}`;
const bx = (i: number) => x + i * (bw + GAP);
const arrows = [1, 2, 3].map((i) => `M${f(bx(i) - 3)} ${f(mid)}l-8.5 -2.8v5.6z`).join('');
---

<g class="dpath">
  <path class="ln-dim" d={line} />
  <path class="dim-arr" d={arrows} />
  {flow && <Particles d={line} kind="net10" n={3} dur={3.2} guide={false} />}
  <path class="face ln-obj" d={[0, 1, 2, 3].map((i) => `M${f(bx(i))} ${f(y)}h${f(bw)}v${BH}h${f(-bw)}z`).join('')} />
  {states.map((st) => (
    <g class={state === 'both' ? (st === 'before' ? 'swap-b' : 'swap-a') : undefined}>
      {text[st].map((t, i) => (
        <g class={t.cls}>
          {t.cls && <path class="ln-obj" d={`M${f(bx(i))} ${f(y)}h${f(bw)}v${BH}h${f(-bw)}z`} />}
          <text class="txt-label" x={f(bx(i) + bw / 2)} y={f(y + 19)} text-anchor="middle">{t.t}</text>
          <text class="txt-note" x={f(bx(i) + bw / 2)} y={f(y + 34)} text-anchor="middle">{t.s}</text>
        </g>
      ))}
    </g>
  ))}
</g>
