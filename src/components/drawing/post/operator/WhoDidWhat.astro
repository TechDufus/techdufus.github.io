---
/*
  FIG 5 · Who did what: two lanes (me, the agent) across five stages. Every item gets a mark,
  hollow for me and solid for the agent, so the fuller lane reads before a word does. Wide
  (breakout, 850 units): stages are columns, lanes are rows, the agent's lane on a faint band.
  Narrow (280 units): lanes are columns, stages are rows. Items wrap to the same width in both
  layouts; each cell (a stage's items for one lane) is drawn once and moved (at()).
*/
import Figure from '../../figure/Figure.astro';
import { at, wrap } from '../../../../lib/drawing/figure';
import { monoWidth } from '../../../../lib/drawing/sheet';
import { whoDidWhat as D, type Who } from './data';
import './operator.css';

const WRAP = 16; // characters a line (≈ 117 units at 12px mono)
const LH = 16, GAP = 7;
const who: Who[] = ['me', 'agent'];

type Item = { t: string[]; dy: number };
/** wrap(), but a last line of four characters or fewer takes a word from the line above. */
const lines = (x: string): string[] => {
  const t = wrap(x, WRAP);
  const n = t.length;
  if (n > 1 && t[n - 1].length <= 4) {
    const cut = t[n - 2].lastIndexOf(' ');
    const moved = `${t[n - 2].slice(cut + 1)} ${t[n - 1]}`;
    if (cut > 0 && moved.length <= WRAP) return [...t.slice(0, n - 2), t[n - 2].slice(0, cut), moved];
  }
  return t;
};
/** A cell's items, stacked: each item's first baseline relative to the cell's first one. */
const stackUp = (xs: string[]): { items: Item[]; h: number } => {
  let dy = 0;
  const items = xs.map((x) => {
    const t = lines(x);
    const it = { t, dy };
    dy += t.length * LH + GAP;
    return it;
  });
  return { items, h: dy - GAP };
};
const cells = D.stages.map((s) => ({ stage: s.stage, me: stackUp(s.me), agent: stackUp(s.agent) }));
const tallest = (k: Who): number => Math.max(...cells.map((c) => c[k].h));

/* wide: 850 · 5 columns of CW from X0 · lane rows under a stage header row */
const W = 850, X0 = 16, CW = (W - 2 * X0) / D.stages.length, HEAD = 46;
const laneTop = { me: HEAD, agent: HEAD + 46 + tallest('me') + 14 };
const H = laneTop.agent + 46 + tallest('agent') + 16;
const colX = (i: number): number => X0 + i * CW;

/* narrow: 280 · two lane columns · one band per stage */
const NW = 280, NCOL = { me: 4, agent: 140 }, NHEAD = 58;
let ny = NHEAD;
const bands = cells.map((c) => {
  const top = ny;
  ny += 38 + Math.max(c.me.h, c.agent.h) + 16;
  return top;
});
const NH = ny + 4;

/* rules: wide header rule, lane rule, column rules inside each lane; narrow band rules */
const colRules = (top: number, bottom: number): string =>
  cells.slice(1).map((_, i) => `M${colX(i + 1)} ${top}V${bottom}`).join('');
const rulesW =
  `M${X0} ${HEAD}H${W - X0}M${X0} ${laneTop.agent}H${W - X0}` +
  colRules(10, HEAD - 6) + colRules(laneTop.me + 32, laneTop.agent - 8) + colRules(laneTop.agent + 32, H - 8);
const rulesN = bands.map((t) => `M6 ${t}H${NW - 6}`).join('');

const lane = (k: Who) => D.lanes.find((l) => l.id === k)!;
const say = (k: Who): string => cells.map((c) => `${c.stage}: ${D.stages.find((s) => s.stage === c.stage)![k].join(', ')}`).join('; ');
const desc =
  `Two lanes across five stages, and the agent’s is much fuller. ` +
  `${lane('me').label}, ${lane('me').sub}: ${say('me')}. ${lane('agent').label}, ${lane('agent').sub}: ${say('agent')}.`;
---

<Figure
  id="fig-who"
  fig={5}
  date="2026-09-29"
  title={D.title}
  desc={desc}
  size={[W, H]}
  narrow={[NW, NH]}
  bp={W}
  breakout
>
  <rect class="fg-band fg-w" x="8" y={laneTop.agent + 4} width={W - 16} height={H - laneTop.agent - 10} style="--p:0" />
  <rect class="fg-band fg-n" x={NCOL.agent - 5} y="8" width={NW - NCOL.agent} height={NH - 14} style="--p:0" />
  <path class="ln-thin fg-w" d={rulesW} style="--p:1" />
  <path class="ln-thin fg-n" d={rulesN} style="--p:1" />

  <g style="--p:3">
    {who.map((k) => (
      <g {...at([X0, laneTop[k] + 26], [NCOL[k], 24])}>
        <text class:list={['view__t', k === 'agent' && 'op-foil']}>{lane(k).label.toUpperCase()}</text>
        <text class="op-n fg-w" x={Math.round(monoWidth(lane(k).label.toUpperCase(), 13, 0.14)) + 12}>{lane(k).sub}</text>
        <text class="op-n fg-n" y="17">{lane(k).sub}</text>
      </g>
    ))}
    {cells.map((c, i) => <text {...at([colX(i) + 12, 32], [NCOL.me, bands[i] + 22], 'txt-label fg-h')}>{c.stage}</text>)}
  </g>

  <g style="--p:5">
    {cells.map((c, i) =>
      who.map((k) => (
        <g {...at([colX(i) + 22, laneTop[k] + 52], [NCOL[k] + 11, bands[i] + 46])}>
          {c[k].items.map((it) => (
            <Fragment>
              <circle class={k === 'me' ? 'op-me' : 'op-ag'} cx="-7" cy={it.dy - 4} r="3.2" />
              <text class="op-t" y={it.dy || undefined}>{it.t.map((t, j) => <tspan x="0" y={j ? it.dy + j * LH : undefined}>{t}</tspan>)}</text>
            </Fragment>
          ))}
        </g>
      )),
    )}
  </g>
</Figure>
