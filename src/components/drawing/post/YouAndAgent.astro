---
/*
  FIG 6 · Me and the agent: two swimlanes across the runbook's stages 0–10 (r720xd.stages; `who`
  decides the lanes), with the "Proxmox is up" hand-off. Wide: lanes run left to right. Narrow:
  stages run down the page, lanes side by side. Cell notes move as blocks; boxes are per layout.
*/
import PostFigure from './PostFigure.astro';
import { r720xd } from '../../../data/hardware/r720xd';
import type { Stage } from '../../../data/hardware/types';
import ProvMark from '../ProvMark.astro';
import { at, glyphRun, Pen, rc, wLabel, type P } from './fig';

type Lane = 'you' | 'agent';
/* Short lane notes (≤ 8 characters a line), paraphrasing each stage's summary and the runbook's
   You / Agent columns. `opt` = optional for that lane. */
const NOTES: Record<number, Partial<Record<Lane, { lines: string[]; opt?: boolean }>>> = {
  0: { you: { lines: ['bracket', 'slot', 'cables', 'password'] }, agent: { lines: ['USB', 'stick'], opt: true } },
  1: { you: { lines: ['tape the', 'bad', 'drive'] } },
  2: { you: { lines: ['unplug', 'both', 'cords'] }, agent: { lines: ['clean', 'shutdown', 'on go'] } },
  3: { you: { lines: ['pull the', 'PERC +', 'cable 1'] } },
  4: { you: { lines: ['HBA330', 'cables', 'A + B'] } },
  5: { you: { lines: ['close', 'it up'] } },
  6: { you: { lines: ['pull', 'bay 25,', 'slide', 'others', 'out'] } },
  7: { you: { lines: ['firmware', 'setup'] } },
  8: { you: { lines: ['install', 'Proxmox'] } },
  9: { you: { lines: ['first', 'boot,', 'SSH key'] } },
  10: { agent: { lines: ['firmware check', 'updates', 'SAS drive → rpool', 'create fast, bulk', 'burn-in: SMART,', 'write, scrub', 'fan check', 'record bays', 'update the repo'] } },
};
const lanesOf = (s: Stage): Lane[] => (s.who === 'both' ? ['you', 'agent'] : [s.who]);
const stages = r720xd.stages;
for (const s of stages) for (const l of lanesOf(s)) if (!NOTES[s.n]?.[l]) throw new Error(`no ${l} note for stage ${s.n}`);
const LH = 13; // note line height

/* wide: columns across; the last (the agent's stage 10) is wide */
const COL = 66, X0 = 92, LAST = stages.length - 1;
const wCol = (i: number): [number, number] => (i < LAST ? [X0 + i * COL, COL] : [X0 + i * COL + 6, 896 - (X0 + i * COL + 6)]);
const lane = { you: [40, 106], agent: [158, 144] } as Record<Lane, [number, number]>; // y, h

/* narrow: rows down; row height from the longest note in the row */
const NX = { n: 18, you: 40, agent: 216, w: 170 };
const rows: { y: number; h: number }[] = [];
let ny = 68;
for (const s of stages) {
  const n = Math.max(...lanesOf(s).map((l) => NOTES[s.n][l]!.lines.length));
  const h = n * LH + 14;
  rows.push({ y: ny, h });
  ny += h + (s.n === 9 ? 34 : 6);
}
const NH = ny + 8;

const cells = stages.flatMap((s, i) =>
  lanesOf(s).map((l) => {
    const note = NOTES[s.n][l]!;
    const [cx, cw] = wCol(i);
    return {
      n: s.n, l, note,
      w: [cx + 2, lane[l][0] + 4, cw - 4, lane[l][1] - 8] as [number, number, number, number],
      nr: [NX[l], rows[i].y, NX.w, rows[i].h] as [number, number, number, number],
    };
  }),
);
const pens = { w: new Pen(), n: new Pen() };
for (const c of cells) {
  const k = `${c.note.opt ? 'ln-hid' : 'tint ln-med'} pf-${c.l}`;
  pens.w.add(k, rc(...c.w));
  pens.n.add(k, rc(...c.nr));
}
const rules = {
  w: `M8 ${lane.you[0] - 4}H896M8 ${lane.agent[0] - 6}H896M8 ${lane.agent[0] + lane.agent[1] + 4}H896`,
  n: `M${NX.you - 4} 44V${NH - 4}M${NX.agent - 3} 44V${NH - 4}`,
};
const nums = {
  w: glyphRun(stages.map((s, i) => [wCol(i)[0] + (i < LAST ? COL / 2 : 12), String(s.n)])),
  n: glyphRun(stages.map((s, i) => [NX.n, String(s.n), rows[i].y + 16])),
};
/* hand-off: out of stage 9 (you) into stage 10 (agent) */
const r9 = rows[LAST - 1], r10 = rows[LAST];
const handoff = {
  w: `M${wCol(LAST - 1)[0] + COL - 4} 104H800V${lane.agent[0] - 2}`,
  n: `M${NX.you + NX.w - 6} ${r9.y + 30}H300V${r10.y - 2}`,
  wHead: `M800 ${lane.agent[0] + 2}l-4 -9h8Z`,
  nHead: `M300 ${r10.y + 2}l-4 -9h8Z`,
};
/* the agent's quiet stretch: from its last job before the hand-off to the hand-off */
const busy = stages.filter((s) => lanesOf(s).includes('agent')).map((s) => stages.indexOf(s));
const w0 = busy[busy.length - 2] + 1, w1 = LAST - 1;
const waitMid: [P, P] = [
  [(wCol(w0)[0] + wCol(w1)[0] + COL) / 2, lane.agent[0] + lane.agent[1] / 2 - 8],
  [300, rows[w0].y + 12],
];
const wait = {
  w: `M${wCol(w0)[0] + 8} ${waitMid[0][1] + 8}H${wCol(w1)[0] + COL - 8}`,
  n: `M300 ${rows[w0].y + 20}V${rows[w1].y + rows[w1].h - 8}`,
};

const ranges = (ns: number[]): string =>
  ns.reduce<number[][]>((a, n) => (a.length && a[a.length - 1].at(-1) === n - 1 ? (a[a.length - 1].push(n), a) : [...a, [n]]), [])
    .map((r) => (r.length > 1 ? `${r[0]} to ${r[r.length - 1]}` : `${r[0]}`))
    .join(', ');
const byWho = (w: Stage['who']): number[] => stages.filter((s) => s.who === w).map((s) => s.n);
const desc =
  `Two swimlanes, me and the agent, across the runbook's stages 0 to ${stages[LAST].n}. Mine alone: ${ranges(byWho('you'))}. ` +
  `Shared: ${ranges(byWho('both'))} (the agent writes the USB stick and shuts the host down on my go). ` +
  `After I say "Proxmox is up" at the end of stage ${stages[LAST - 1].n}, stage ${stages[LAST].n} is the agent's: ${NOTES[stages[LAST].n].agent!.lines.map((l) => l.replace(/,$/, '')).join(', ').replace('→', 'into')}.`;
---

<PostFigure
  id="fig-lanes"
  n={6}
  title="Me and the agent, stage by stage"
  desc={desc}
  caption="Hands on the left, SSH on the right. It doesn't get a screwdriver."
  size={[900, 310]}
  narrow={[390, NH]}
  breakout
>
  {(['w', 'n'] as const).map((k) => (
    <g class={`pf-${k}`}>
      <path class="ln-thin" d={rules[k]} style="--p:1" />
      {pens[k].list.map(({ c, d }) => <path class={c} d={d} style="--p:2" pathLength={c.includes('hid') ? undefined : '1'} />)}
      <path class="ln-phantom pf-agent" d={wait[k]} style="--p:4" />
      <g class="sem-new" style="--p:5">
        <path class="ln-obj" d={handoff[k]} pathLength="1" />
        <path class="tint ln-med" d={k === 'w' ? handoff.wHead : handoff.nHead} />
      </g>
      <text class="txt-note pf-c" x={nums[k].x} y={nums[k].y ?? 28} style="--p:6">{nums[k].t}</text>
    </g>
  ))}

  <g style="--p:6">
    <g {...at([8, lane.you[0] + 18], [NX.you, 24])}>
      <text class="view__t">YOU</text>
      <text class="txt-note" y="16">hands</text>
    </g>
    <g {...at([8, lane.agent[0] + 18], [NX.agent, 24], 'pf-agent')}>
      <text class="view__t">AGENT</text>
      <text class="txt-note" y="16">over SSH,</text>
      <text class="txt-note" y="30">on my go</text>
    </g>
    <text {...at([X0 - 4, 28], [NX.n + 6, 44], 'txt-note pf-e pf-nm')}>stage</text>
    {cells.map((c) => (
      <text {...at([c.w[0] + 5, c.w[1] + 16], [c.nr[0] + 8, c.nr[1] + 16], `txt-note pf-tt${c.l === 'agent' ? ' pf-agent' : ''}`)}>
        {c.note.lines.map((t, i) => <tspan x="0" y={i * LH}>{t}</tspan>)}
      </text>
    ))}
    <g {...at([wCol(LAST)[0] + 8, 92], [NX.agent + 4, r9.y + 18])}>
      <text class="txt-dim pf-nc sem-new">“Proxmox is up”</text>
      <ProvMark x={wLabel('“Proxmox is up”') * 0.94 + 2} y={-8.5} prov="owner" asOf="2026-09-28" />
    </g>
    <text {...at(...waitMid, 'txt-note pf-c pf-agent')}>waits its turn</text>
  </g>
</PostFigure>
