---
/*
  ServerSchedule: the text equivalents under Sheet 02: parts list (synced with the exploded
  view's balloons via data-bom), telemetry, drives, pools, PCIe slots, CPUs and memory, open
  questions and sources. Everything comes from r720xd.ts; styles live in the page (.pg-server).
*/
import SectionHead from '../../ui/SectionHead.astro';
import ProvChip from '../ProvChip.astro';
import { r720xd } from '../../../data/hardware/r720xd';
import { explodedBom } from './geom';

const X = r720xd;
const num = (v: number) => v.toLocaleString('en-US');
const fans = X.fans, temps = X.temperatures;
const cpu = X.cpus[0];
const spec = (label: string) => cpu.specs.find((s) => s.label === label)?.fact.value ?? '';
---

<section class="wrap srv-sec" aria-labelledby="srv-parts">
  <SectionHead index={1} label="Parts list" title="What comes <em>apart</em>." titleId="srv-parts" />
  <div class="srv-split">
    <table class="srv-t srv-bom">
      <caption class="sr-only">Parts on the exploded view, by balloon number. Each part name shows it on the drawing.</caption>
      <thead><tr><th scope="col">No.</th><th scope="col">Part</th><th scope="col">Qty</th><th scope="col">Note</th></tr></thead>
      <tbody>
        {explodedBom.map((b) => (
          <tr data-bom={b.id} class={b.state}>
            <td>{b.n}</td>
            <th scope="row"><button type="button">{b.name}</button></th>
            <td>{b.qty}</td>
            <td>{b.note} <ProvChip prov={b.prov} asOf={b.asOf} compact /></td>
          </tr>
        ))}
      </tbody>
    </table>

    <div class="srv-read" aria-labelledby="srv-tele">
      <h3 class="srv-h" id="srv-tele">Telemetry</h3>
      <dl>
        <div><dt>Fans</dt><dd><b>{fans.count.value} × {num(fans.rpm.value[0])}–{num(fans.rpm.value[1])}</b> rpm</dd></div>
        <div><dt>CPUs</dt><dd><b>{temps.cpuC.value[0]} / {temps.cpuC.value[1]}</b> °C</dd></div>
        <div><dt>Exhaust</dt><dd><b>{temps.exhaustC.value}</b> °C</dd></div>
        <div><dt>Inlet</dt><dd><b>—</b> no reading</dd></div>
      </dl>
      <p><ProvChip prov="measured" asOf={fans.rpm.asOf} /> With the PERC still in. After the swap the fans get checked against this, in case they sulk about the new card.</p>
    </div>
  </div>
</section>

<section class="wrap srv-sec" aria-labelledby="srv-drives">
  <SectionHead index={2} label="Drives and pools" title="Seven drives, <em>one</em> leaving." titleId="srv-drives" />
  <p class="srv-fine">Health, hours and remaps as the drives reported them <ProvChip prov="measured" asOf="2026-09-27" compact />. Pools are the plan <ProvChip prov="owner" asOf="2026-09-28" compact />; usable sizes are my estimates <ProvChip prov="inferred" compact />.</p>
  <ul class="srv-drv">
    {X.drives.map((d) => (
      <li data-pool={d.pool ?? 'none'} data-fate={d.fate}>
        <p class="srv-drv__h"><b>{d.label}</b> <span>{d.pool ?? 'no pool'}</span> <span>{d.fate === 'keep' ? 'Keep' : 'Removed'}</span></p>
        <p class="srv-drv__g">{d.health.value}</p>
        <p class="srv-drv__m">{[
          d.model.split(' (')[0],
          `${d.osSize.value} ${d.kind.toUpperCase()}`,
          d.bay.value === null ? '' : `rear bay ${d.bay.value}`,
          d.hours && `${num(d.hours.value)} h (${d.hoursYears?.value} yr)`,
          d.remapped && `${d.remapped.value} remapped`,
          d.lifeLeftPct && `${d.lifeLeftPct.value}% life left`,
        ].filter(Boolean).join(' · ')}</p>
      </li>
    ))}
  </ul>
  <ul class="srv-pools">
    {X.pools.map((p) => (
      <li data-pool={p.id}><b>{p.id}</b> {p.layout.value}. <span>{p.usable.value} · {p.holds.value}</span></li>
    ))}
  </ul>
</section>

<section class="wrap srv-sec" aria-labelledby="srv-board">
  <SectionHead index={3} label="Board" title="Slots, CPUs, <em>memory</em>." titleId="srv-board" />
  <div class="srv-split">
    <table class="srv-t">
      <caption class="sr-only">PCIe slots, from the Owner’s Manual Table 3</caption>
      <thead><tr><th scope="col">Slot</th><th scope="col">Riser</th><th scope="col">CPU</th><th scope="col">Card</th><th scope="col">Link</th><th scope="col">Today → plan</th></tr></thead>
      <tbody>
        {X.pcie.slots.map((s) => (
          <tr class={s.plan?.startsWith('HBA330 (') ? 'new' : undefined}><th scope="row">{s.slot}</th><td>{s.riser}</td><td>{s.cpu}</td><td>{s.height}, {s.length}</td><td>{s.link}</td><td>{s.today}{s.plan && ` → ${s.plan}`}</td></tr>
        ))}
      </tbody>
    </table>
    <div class="srv-read">
      <h3 class="srv-h">CPUs and memory</h3>
      <dl>
        <div><dt>CPUs</dt><dd><b>2 × {cpu.model.value.replace('Intel ', '')}</b> {spec('Cores / threads')} each · {spec('Base / turbo')} · {spec('TDP')} · {spec('Vector extensions')} <ProvChip prov="vendor" href={X.sources['intel-e5-2690v2'].href} source="Intel" /></dd></div>
        <div><dt>Memory</dt><dd><b>{X.memory.ownerStated.value}</b> <ProvChip prov="owner" /> <b class="srv-vs">or {X.memory.usable.value}</b> <ProvChip prov="measured" asOf={X.memory.usable.asOf} /></dd></div>
      </dl>
      <p class="srv-flag">Unresolved. Memory mirroring would halve 256 into about 128. Or some DIMMs are missing. F2 setup, or counting sticks, settles it.</p>
    </div>
  </div>
</section>

<section class="wrap srv-sec" aria-labelledby="srv-open">
  <SectionHead index={4} label="Open questions" title="Still <em>unknown</em>." titleId="srv-open" />
  <div class="srv-split">
    <ol class="srv-q">
      {X.unknowns.map((u) => <li><b>{u.question}</b> {u.howToResolve}</li>)}
    </ol>
    <div>
      <h3 class="srv-h">Sources</h3>
      <ul class="srv-src">
        {Object.values(X.sources).map((s) => <li><a href={s.href} rel="noopener">{s.title}</a></li>)}
      </ul>
    </div>
  </div>
  <p class="srv-next">
    <a class="link" href="/lab/rack/"><span aria-hidden="true">←</span> Sheet 01 · The cabinet</a>
    <a class="link" href="/blog/from-hardware-raid-to-zfs/">The post: from hardware RAID to ZFS <span class="arrow" aria-hidden="true">→</span></a>
  </p>
</section>
