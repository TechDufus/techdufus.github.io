---
import { isPlaceholder, primaryCta, primaryNavigation, siteMetadata, visibleNav } from '../data/site';

const pathname = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  return href === '/' ? pathname === '/' : pathname.startsWith(href.replace(/\/?$/, '/'));
};

// Home section each nav item scroll-spies on the homepage (site.ts toggles .is-active).
const homeSection: Record<string, string> = {
  '/blog/': 'writing',
  '/lab/': 'lab',
  '/app/': 'app',
  '/#services': 'services',
  '/about/': 'about'
};

const links = visibleNav(primaryNavigation).map((item) => ({
  ...item,
  current: isActive(item.href),
  placeholder: isPlaceholder(item.label),
  section: homeSection[item.href]
}));
const homeCurrent = pathname === '/';
---

<header data-site-nav>
  <a class="skip" href="#main">Skip to content</a>
  <nav class="nav" aria-label="Primary">
    <div class="wrap nav__inner">
      <a class="wordmark" href="/" aria-label="TechDufus, home">TechDufus<i>.</i></a>
      <div class="nav__links">
        {links.map((item) => (
          <a
            class="nav__link"
            href={item.href}
            data-section={item.section}
            aria-current={item.current ? 'page' : undefined}
          >
            {item.placeholder ? <span class="ph" title="Placeholder">{item.label}</span> : item.label}
          </a>
        ))}
      </div>
      <a class="btn btn--primary btn--sm nav__cta" href={primaryCta.href}>{primaryCta.label}</a>
      <button class="nav__menu" type="button" aria-expanded="false" aria-controls="site-sheet">
        Menu <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
  <div class="sheet" id="site-sheet" role="dialog" aria-modal="true" aria-label="Site menu">
    <div class="sheet__scrim" data-sheet-close></div>
    <div class="sheet__panel">
      <div class="sheet__top">
        <a class="wordmark" href="/" data-sheet-close>TechDufus<i>.</i></a>
        <button class="icon-btn" type="button" data-sheet-close aria-label="Close menu">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
      <div class="sheet__links">
        <a href="/" aria-current={homeCurrent ? 'page' : undefined} data-sheet-close>Home <small>01</small></a>
        {links.map((item, i) => (
          <a href={item.href} aria-current={item.current ? 'page' : undefined} data-sheet-close>
            {item.placeholder ? <span class="ph" title="Placeholder">{item.label}</span> : item.label}{' '}
            <small>{String(i + 2).padStart(2, '0')}</small>
          </a>
        ))}
      </div>
      <div class="sheet__foot">
        <a class="btn btn--primary btn--lg btn--block" href={primaryCta.href} data-sheet-close>{primaryCta.label}</a>
        <p class="meta">{siteMetadata.email}</p>
      </div>
    </div>
  </div>
</header>
