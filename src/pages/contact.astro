---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import EmailCopy from '../components/ui/EmailCopy.astro';
import SocialChips from '../components/ui/SocialChips.astro';
import SupportCards from '../components/ui/SupportCards.astro';
import SpecList from '../components/ui/SpecList.astro';
import { linkProps } from '../components/ui/format';
import { socialLinks } from '../data/site';

type ChannelPriority = 'primary' | 'secondary';

type ChannelMeta = {
  lane: string;
  bestFor: string;
  command: string;
  priority: ChannelPriority;
  spotlight?: boolean;
};

const toDisplayValue = (href: string) => {
  if (href.startsWith('mailto:')) return href.replace('mailto:', '');
  try {
    const url = new URL(href);
    return url.hostname.replace(/^www\./, '') + url.pathname.replace(/\/$/, '');
  } catch {
    return href;
  }
};

const channelMetaByLabel: Record<string, ChannelMeta> = {
  Email: { lane: 'Project + client', bestFor: 'Long-form project details and client conversations.', command: 'email', priority: 'secondary' },
  GitHub: { lane: 'Open source', bestFor: 'Issues, PRs, and anything code-first.', command: 'github', priority: 'primary', spotlight: true },
  LinkedIn: { lane: 'Professional', bestFor: 'Network intros and business conversations.', command: 'linkedin', priority: 'primary', spotlight: true },
  X: { lane: 'Quick updates', bestFor: 'Short questions and day-to-day tech chatter.', command: 'x', priority: 'primary', spotlight: true },
  YouTube: { lane: 'Video', bestFor: 'Walkthroughs, demos, and longer explainer content.', command: 'youtube', priority: 'secondary' },
  Discord: { lane: 'Community', bestFor: 'Ongoing conversations about tooling and experiments.', command: 'discord', priority: 'secondary' }
};

const defaultChannelMeta: ChannelMeta = {
  lane: 'General',
  bestFor: 'General conversations and follow-ups.',
  command: 'ping',
  priority: 'secondary'
};

const channels = socialLinks
  .map((link) => ({
    ...link,
    ...(channelMetaByLabel[link.label] ?? defaultChannelMeta),
    displayValue: toDisplayValue(link.href)
  }))
  .sort((a, b) => {
    if ((a.spotlight ?? false) !== (b.spotlight ?? false)) return a.spotlight ? -1 : 1;
    if (a.priority !== b.priority) return a.priority === 'primary' ? -1 : 1;
    return a.label.localeCompare(b.label);
  });

const channelByLabel = new Map(channels.map((channel) => [channel.label, channel]));

const quickRoutes = [
  { label: 'Open source', channel: 'GitHub' },
  { label: 'Professional', channel: 'LinkedIn' },
  { label: 'Quick updates', channel: 'X' },
  { label: 'Project + client', channel: 'Email' }
].flatMap((route) => {
  const channel = channelByLabel.get(route.channel);
  return channel ? [{ k: route.label, v: channel.label, href: channel.href, note: channel.displayValue }] : [];
});
---

<BaseLayout title="Contact" description="Pick a channel and reach out.">
  <div class="pg-contact">
  <!-- ============ Header ============ -->
  <header class="head wrap" aria-labelledby="page-title">
    <div class="head__grid">
      <div>
        <p class="eyebrow head__eyebrow" data-reveal>Contact</p>
        <h1 class="display" id="page-title" data-reveal style="--d:1">No forms. Just <em>direct</em> routes.</h1>
        <p class="lede" data-reveal style="--d:2">
          Pick the channel that matches your intent. GitHub, LinkedIn, and X are the fastest lanes; email is best for
          longer client/project threads.
        </p>
        <EmailCopy d={3} />
        <SocialChips d={4} />
      </div>
      <div class="head__side" data-reveal style="--d:3">
        <h2 class="side__h">Quick routes</h2>
        <SpecList rows={quickRoutes} label="Quick routes" />
      </div>
    </div>
  </header>

  <!-- ============ 01 · Channels ============ -->
  <section id="channels" class="section" aria-labelledby="channels-title">
    <div class="wrap">
      <SectionHead
        index={1}
        label="Channels"
        aside={`${channels.length} routes`}
        titleId="channels-title"
        title="What to reach out <em>about</em>."
        lede="Primary routes first, then everything else."
      />
      <ul class="routes" data-reveal>
        {channels.map((channel) => (
          <li>
            <a class="route" {...linkProps(channel.href)}>
              <span class="route__lane eyebrow">{channel.lane}</span>
              <span class="route__main">
                <strong>{channel.label}</strong>
                <span class="meta">{channel.displayValue}</span>
              </span>
              <span class="route__for">{channel.bestFor}</span>
              <span class="route__tags">
                {channel.priority === 'primary' && <span class="chip chip--accent">primary</span>}
                <span class="chip chip--quiet">/{channel.command}</span>
              </span>
              <span class="route__arrow" aria-hidden="true">{channel.href.startsWith('http') ? '↗' : '->'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 02 · Support ============ -->
  <section id="support" class="section" aria-labelledby="support-title">
    <div class="wrap">
      <SectionHead
        index={2}
        label="Support (optional)"
        titleId="support-title"
        title="Everything on this site stays <em>free</em>."
        lede="If you want to support the work, there is a dedicated support page. No paywall and no premium tier."
      />
      <SupportCards />
      <div class="support__foot" data-reveal>
        <a class="link link--quiet" href="/support/">Open support options -&gt;</a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<style is:global>
  /* Global under the .pg-contact root (no data-astro-cid attributes). Page head (mockup blog.html .head) */
  .pg-contact .head { padding-block: clamp(40px, 7vw, 104px) clamp(48px, 6vw, 88px); }
  .pg-contact .head__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(40px, 6vw, 112px); align-items: end; }
  .pg-contact .head__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
  .pg-contact .head__eyebrow::before { content: ""; width: 28px; height: 1px; background: var(--gold-line); }
  .pg-contact .head .display { max-width: 12ch; }
  .pg-contact .head .lede { margin-top: 28px; }
  .pg-contact .head__side { display: grid; gap: 18px; }
  .pg-contact .side__h { font-family: var(--font-mono); font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); font-weight: 500; }
  .pg-contact .head__side .spec > div { grid-template-columns: 124px minmax(0, 1fr); padding: 12px 0; }
  .pg-contact .head__side .spec a { text-decoration: underline; text-decoration-color: var(--accent-line); text-underline-offset: 3px; transition: color var(--t-1) ease; }
  .pg-contact .head__side .spec a:hover { color: var(--accent-hi); }
  @media (max-width: 960px) { .pg-contact .head__grid { grid-template-columns: minmax(0, 1fr); align-items: start; } }

  /* Channel rows (post-row rhythm: lane | name | best for | tags) */
  .pg-contact .routes { border-top: 1px solid var(--line); }
  .pg-contact .route {
    display: grid; grid-template-columns: 150px minmax(0, 3fr) minmax(0, 4fr) auto 20px; gap: 12px 28px; align-items: baseline;
    padding: 22px 4px; border-bottom: 1px solid var(--line); color: var(--ink);
    transition: background-color var(--t-2) ease;
  }
  .pg-contact .route:hover { background: var(--surface); }
  .pg-contact .route__lane { color: var(--accent); }
  .pg-contact .route__main { display: grid; gap: 2px; min-width: 0; }
  .pg-contact .route__main strong { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; line-height: 1.15; transition: color var(--t-1) ease; }
  .pg-contact .route:hover .route__main strong { color: var(--accent-hi); }
  .pg-contact .route__main .meta { overflow-wrap: anywhere; }
  .pg-contact .route__for { color: var(--muted); font-size: 0.975rem; line-height: 1.55; }
  .pg-contact .route__tags { display: flex; gap: 6px; justify-content: flex-end; }
  .pg-contact .route__arrow { color: var(--faint); transition: color var(--t-1) ease, transform var(--t-2) var(--ease-out); }
  .pg-contact .route:hover .route__arrow { color: var(--accent-hi); transform: translate(2px, -2px); }
  @media (max-width: 960px) {
    .pg-contact .route { grid-template-columns: minmax(0, 1fr) auto; gap: 8px 16px; }
    .pg-contact .route__lane, .pg-contact .route__main, .pg-contact .route__for, .pg-contact .route__tags { grid-column: 1; }
    .pg-contact .route__arrow { grid-column: 2; grid-row: 1 / span 2; align-self: center; }
    .pg-contact .route__tags { justify-content: flex-start; }
  }

  .pg-contact .support__foot { margin-top: 28px; }
  .pg-contact #support .support { margin-top: 0; }
</style>
