---
/*
  TD-LAB-02 · Sheet 2 of 3 · The servers: the four machines that run things, each one's front at
  the same scale, so a 2U server and a Raspberry Pi can be compared by eye. Under each front: what
  is in it and what runs on it. In the right column: the schedule (threads and memory, with the
  total), then the cards. The two Dells' cards link their own sheets, /lab/r730/ (TD-LAB-02A) and
  /lab/r430/ (TD-LAB-02B).

  The fronts are the cabinet's panel line work (../rack/model.ts, from src/data/lab/rack.ts); every
  word and number comes from src/data/lab/servers.ts. The page (src/pages/lab/servers.astro) wraps
  this in the page shell and the text equivalent.
*/
import '../../../styles/schedule.css';
import Sheet from '../Sheet.astro';
import View from '../View.astro';
import Part from '../Part.astro';
import Balloon from '../Balloon.astro';
import Dim from '../Dim.astro';
import PartCard from '../PartCard.astro';
import LineKey from '../LineKey.astro';
import { atScale, matrix } from '../../../lib/drawing/projection';
import { wrap } from '../../../lib/drawing/figure';
import { frontPanel, slotOf$ } from '../rack/model';
import { cpuCount, machineCard, machines, totals, type MachineId } from '../../../data/lab/servers';

const DWG = 'labsv';

/* ---------- layout (paper units): three rows, the two rack servers above the two on the shelf ---------- */
const k = atScale(1, 2.5);
const X0 = 148;
/** Each front's left edge, and the paper y its bottom edge stands on; `cw` is the room its lettering has. */
const PLACE: Record<MachineId, { x: number; foot: number; cw: number }> = {
  r730: { x: X0, foot: 245, cw: 579 },
  r430: { x: X0, foot: 455, cw: 579 },
  mini: { x: X0, foot: 627, cw: 314 },
  'rpi-4b': { x: X0 + 330, foot: 627, cw: 249 },
};
/** Header baselines per row, so the two on the shelf line up although one is shorter. */
const HEAD: Record<MachineId, number> = { r730: 110, r430: 374, mini: 554, 'rpi-4b': 554 };
/** Whose width is dimensioned (the R430 is as wide as the R730: one dimension covers both). */
const WIDTH_DIM: MachineId[] = ['r730', 'mini', 'rpi-4b'];
/** A .txt-note character's advance (10.5 px mono, tracked .06 em), and the pitch of its lines. */
const CHAR = 10.5 * (0.6 + 0.06), LINE = 15;

const rows = machines.map((m, i) => {
  const s = slotOf$(m.id);
  const { x, foot, cw } = PLACE[m.id];
  const w = s.faceW * k, h = s.faceH * k, top = foot - h;
  const dimmed = WIDTH_DIM.includes(m.id);
  const at = s.dev.placement;
  const text = [
    `${m.cpu} · ${cpuCount(m)} · ${m.memoryGB} GB`,
    `${m.storage ? `${m.storage} · ` : ''}${m.os}`,
    ...wrap(`Runs · ${m.runs.join(' · ')}`, Math.floor(cw / CHAR)),
  ];
  return {
    m, n: i + 1, s, x, top, foot, w, h,
    face: `M${x} ${top}h${w}v${h}h${-w}Z`,
    use: matrix([k, 0, 0, k, x - s.faceX * k, top]),
    head: HEAD[m.id],
    // a rack-width face also gets its inch equivalent
    sub: at.kind === 'rack' ? `[${(s.faceW / 25.4).toFixed(2)}]` : undefined,
    dimmed,
    textY: foot + (dimmed ? 54 : 24),
    text,
    u: at.kind === 'rack' ? `${at.u.bottom - at.u.top + 1}U` : '',
  };
});

const desc =
  'The four machines that run things, each drawn from the front at the same scale. ' +
  machines.map((m) => `${m.name} (${m.where}): ${m.cpu}, ${cpuCount(m)}, ${m.memoryGB} GB${m.storage ? `, ${m.storage.toLowerCase()}` : ''}, ${m.os}; runs ${m.runs.join(', ')}.`).join(' ') +
  ' Each numbered machine opens a card.';
---

<Sheet
  id={DWG}
  dwgNo="TD-LAB-02"
  title="The servers"
  desc={desc}
  sheet={[2, 3]}
  rev="A"
  date="2026-11-10"
  checked="TD"
  revisions={[{ rev: 'A', date: '2026-11-10', desc: 'First issue: four machines' }]}
  stamp={{ text: 'AS BUILT', tone: 'ok', x: 1036, y: 520 }}
  interactive
  hint
>
  <defs>
    {rows.map(({ m, s }) => {
      const p = frontPanel(s);
      return (
        <symbol id={`${DWG}-pf-${m.id}`} overflow="visible">
          {p.obj && <path class="ln-obj" d={p.obj} />}
          {p.med && <path class="ln-med" d={p.med} />}
          {p.thin && <path class="ln-thin" d={p.thin} />}
        </symbol>
      );
    })}
  </defs>

  <View x={39} y={39} w={798} h={813} title="FRONT ELEVATIONS" scale={k} note="ALL FOUR AT ONE SCALE" labelAt={[438, 782]}>
    {rows.map((r) => (
      <>
        <Part id={r.m.id} label={r.m.short} p={2}>
          <path class="face-front" d={r.face} />
          <g class="dwg-tex"><use href={`#${DWG}-pf-${r.m.id}`} transform={r.use} /></g>
        </Part>
        <Balloon at={[r.x + 11, r.head + 2]} n={r.n} part={r.m.id} />
        <g style="--p:4">
          <text class="txt-label" x={r.x + 32} y={r.head}>{r.m.name}</text>
          <text class="txt-note" x={r.x + 32} y={r.head + LINE}>{r.m.where} · {r.m.job}</text>
          {r.text.map((t, i) => <text class:list={['txt-note', i === 0 && 'sv-spec']} x={r.x} y={r.textY + i * LINE}>{t}</text>)}
        </g>
        <Dim a={[r.x + r.w, r.foot]} b={[r.x + r.w, r.top]} offset={22} mm={r.s.faceH} sub={r.u || undefined} />
        {r.dimmed && <Dim a={[r.x, r.foot]} b={[r.x + r.w, r.foot]} offset={20} mm={r.s.faceW} sub={r.sub} />}
      </>
    ))}
  </View>

  <Fragment slot="aside">
    <table class="rk-list">
      <caption>Schedule</caption>
      <thead><tr><th scope="col">No</th><th scope="col">Machine</th><th scope="col" class="rk-list__u">CPU</th><th scope="col" class="rk-list__u">Memory</th></tr></thead>
      <tbody>
        {rows.map(({ m, n }) => (
          <tr>
            <td class="rk-list__n"><span>{n}</span></td>
            <th scope="row"><button type="button" data-balloon-for={m.id}>{m.name}</button></th>
            <td class="rk-list__u">{cpuCount(m)}</td>
            <td class="rk-list__u">{m.memoryGB} GB</td>
          </tr>
        ))}
      </tbody>
      <tfoot>
        <tr><td></td><th scope="row">All four</th><td class="rk-list__u">{totals.threads} threads</td><td class="rk-list__u">{totals.memoryGB} GB</td></tr>
      </tfoot>
    </table>
  </Fragment>

  <Fragment slot="cards">
    {machines.map((m) => {
      const c = machineCard(m);
      return (
        <PartCard id={m.id} title={c.title} kind={c.kind} lines={c.lines}>
          {m.sheet && <a class="link" href={m.sheet.href}>Sheet {m.sheet.no} · the {m.short} <span aria-hidden="true">→</span></a>}
        </PartCard>
      );
    })}
  </Fragment>

  <Fragment slot="legend">
    <LineKey items={[{ line: 'obj', label: 'Object' }, { line: 'dim', label: 'Dimension' }]} />
  </Fragment>
</Sheet>

<style is:global>
  [data-dwg="labsv"] .sv-spec { fill: var(--dwg-text-hi); }
</style>
