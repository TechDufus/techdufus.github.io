---
/*
  SheetLink: the card at the end of the post that points to Sheet 02 (TD-LAB-02), with a tiny
  front elevation of the R720xd drawn from its dimensions and bay count.
*/
import { device } from '../../../data/lab/rack';
import { server } from '../../../data/lab/server';
import { f } from '../../../lib/drawing/figure';

const href = device('r720xd').sheetHref ?? '/lab/r720xd/';
const { before, now } = server.controller;
const { body, earsWidth } = server.dims;

/* thumbnail: front elevation, ears included, fitted to 150 units wide */
const k = 150 / earsWidth;
const W = earsWidth * k, H = body.h * k, ear = ((earsWidth - body.w) / 2) * k;
const X = 5, Y = 8;
const n = server.bays.front;
const bayW = (W - 2 * ear - 4) / n;
const bays = Array.from({ length: n + 1 }, (_, i) => `M${f(X + ear + 2 + i * bayW)} ${f(Y + 3)}v${f(H - 6)}`).join('');
const outline = `M${X} ${Y}h${f(W)}v${f(H)}h${f(-W)}Z M${f(X + ear)} ${Y}v${f(H)}M${f(X + W - ear)} ${Y}v${f(H)}`;
---

<a class="pf-card" href={href}>
  <svg class="pf-card__th" viewBox={`0 0 160 ${f(H + 16)}`} aria-hidden="true" focusable="false">
    <path class="pf-card__o" d={outline} />
    <path class="pf-card__b" d={bays} />
  </svg>
  <span class="pf-card__txt">
    <span class="pf-card__meta">TD-LAB-02 · Sheet 2 of 3 · Rev B · Checked TD</span>
    <span class="pf-card__t">The server</span>
    <span class="pf-card__d">The R720xd inside and out, after the {before.name} → {now.id.toUpperCase()} swap.</span>
    <span class="pf-card__go">Open Sheet 02 <span class="arrow" aria-hidden="true">→</span></span>
  </span>
</a>

<style is:global>
  .prose .pf-card {
    display: grid; grid-template-columns: minmax(120px, 34%) minmax(0, 1fr); gap: 0; margin-block: 2em;
    border: 1px solid var(--line-2); background: var(--bg-deep); color: var(--ink-2); text-decoration: none;
    transition: border-color var(--t-2) ease;
  }
  .prose .pf-card:hover { color: var(--ink-2); border-color: var(--accent-line); }
  .pf-card__th {
    display: block; width: 100%; height: 100%; padding: 18px 16px; box-sizing: border-box; border-right: 1px solid var(--line-2);
    background: repeating-linear-gradient(0deg, color-mix(in srgb, var(--line-ink) 5%, transparent) 0 1px, transparent 1px 15px),
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--line-ink) 5%, transparent) 0 1px, transparent 1px 15px), var(--bg);
  }
  .pf-card__th path { fill: none; vector-effect: non-scaling-stroke; }
  .pf-card__o { stroke: var(--gold-light); stroke-width: 1.4; }
  .pf-card__b { stroke: color-mix(in srgb, var(--gold) 70%, transparent); stroke-width: 0.7; }
  .pf-card__txt { display: grid; gap: 6px; align-content: center; padding: 18px 20px; }
  .pf-card__meta { font: 500 0.6875rem/1.3 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); }
  .pf-card__t { font: italic 1.75rem/1.05 var(--font-display); color: var(--gold-light); }
  .pf-card__d { font-size: 0.9375rem; line-height: 1.5; color: var(--muted); }
  .pf-card__go { margin-top: 4px; font: 500 0.75rem/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .pf-card__go .arrow { display: inline-block; transition: transform var(--t-2) var(--ease-out); }
  .pf-card:hover .pf-card__go .arrow { transform: translateX(4px); }
  .pf-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 520px) {
    .prose .pf-card { grid-template-columns: minmax(0, 1fr); }
    .pf-card__th { height: auto; border-right: 0; border-bottom: 1px solid var(--line-2); }
  }
  @media print { .pf-card__th { background: none; } .pf-card__o, .pf-card__b { stroke: #000; } }
</style>
