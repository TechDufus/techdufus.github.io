---
/*
  /lab/rack/: Sheet 01 · The cabinet (TD-LAB-01). The drawing is src/components/drawing/rack/
  CabinetSheet.astro, with the device schedule in its right column; under it one colophon line,
  then the links as a table (the rear view in words), from the same data (src/data/lab/rack.ts).
  The front, side and rear views load from /lab/rack/views/ (src/components/drawing/rack/rack.ts).
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import CabinetSheet from '../../components/drawing/rack/CabinetSheet.astro';
import { DWG, derived, device, links } from '../../components/drawing/rack/model';
import type { Endpoint } from '../../data/lab/types';

const end = (e: Endpoint): string => {
  const name = e.device === 'isp' ? 'ISP' : device(e.device).short;
  return e.port ? `${name} · ${e.port}` : name;
};
const medium = { copper: 'Copper', fiber: 'Fiber', 'sfp+': 'SFP+', poe: 'PoE' } as const;
---

<BaseLayout
  title="Sheet 01 · The cabinet"
  description="My homelab's 42U cabinet as an engineering drawing: every box at its U position, front, side and rear views, and the network links between them."
>
  <div class="pg-rack">
    <section class="wrap rk-hero" aria-labelledby="rk-title">
      <p class="eyebrow rk-hero__eyebrow">Lab · Sheet 01</p>
      <h1 class="h1" id="rk-title">The <em>cabinet</em>.</h1>
      <p class="lede rk-hero__lede">Everything in my 42U, as it sits today: {derived.uUsed}U used, {derived.uFree}U waiting for a bad idea.</p>
      <p class="rk-hero__links">
        <a class="link link--quiet" href="/lab/"><span aria-hidden="true">←</span> The lab</a>
        <a class="link link--quiet" href="/lab/r720xd/">Sheet 02 · The server <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </section>

    <div class="rk-sheet" data-rack-views="/lab/rack/views/">
      <CabinetSheet id={DWG} />
      <p class="rk-colophon">Drawn from data, not by hand. When the cabinet changes, I edit a number.</p>
    </div>

    <section class="wrap rk-more" aria-label="The cabinet in words">
      <div class="rk-links">
        <h2 class="rk-links__h" id="rk-links">What’s plugged into what</h2>
        <div class="rk-scroll" role="region" aria-labelledby="rk-links" tabindex="0">
          <table class="rk-table">
            <thead><tr><th scope="col">From</th><th scope="col">To</th><th scope="col">Link</th></tr></thead>
            <tbody>
              {links.map((l) => (
                <tr>
                  <th scope="row">{end(l.from)}</th>
                  <td>{end(l.to)}</td>
                  <td class={l.speed?.startsWith('10') ? 'rk-10g' : undefined}>{[l.speed, medium[l.medium]].filter(Boolean).join(' · ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <p class="rk-next">
        <a class="link" href="/lab/r720xd/">Sheet 02 · The server <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link" href="/blog/from-hardware-raid-to-zfs/">The post: from hardware RAID to ZFS <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import '../../components/drawing/rack/rack';
</script>

<style is:global>
  .pg-rack .rk-hero { padding-block: clamp(40px, 6vw, 80px) clamp(28px, 4vw, 44px); }
  .pg-rack .rk-free .hatch { opacity: 0.45; }
  .pg-rack .rk-hero__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .pg-rack .rk-hero__eyebrow::before { content: ""; width: 28px; height: 1px; background: var(--gold-line); }
  .pg-rack .rk-hero__lede { margin-top: 20px; max-width: 58ch; }
  .pg-rack .rk-hero__links { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 24px; font-size: var(--fs-sm); }
  .pg-rack .rk-sheet { max-width: 1400px; margin-inline: auto; padding-inline: var(--gutter); }
  .pg-rack .rk-colophon { margin: 14px 0 0; font: italic 1rem/1.5 var(--font-display); color: var(--muted); }

  .pg-rack .rk-more { display: grid; grid-template-columns: minmax(0, 1fr); gap: 32px; padding-block: clamp(40px, 6vw, 72px); }
  .pg-rack .rk-links { max-width: 820px; }
  .pg-rack .rk-links__h { margin: 0 0 12px; font: 500 0.6875rem/1.3 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .pg-rack .rk-scroll { overflow-x: auto; scrollbar-width: thin; }
  .pg-rack .rk-scroll:focus-visible { outline-offset: 4px; }
  .pg-rack .rk-table { width: 100%; min-width: 520px; border-collapse: collapse; font-size: var(--fs-sm); }
  .pg-rack .rk-table :is(th, td) { padding: 10px 14px 10px 0; border-top: 1px solid var(--line); text-align: left; vertical-align: baseline; color: var(--ink-2); font-weight: 400; }
  .pg-rack .rk-table thead th { padding-top: 0; border-top: 0; border-bottom: 1px solid var(--line-2); font: 500 0.6875rem/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); }
  .pg-rack .rk-table tbody th { color: var(--ink); }
  .pg-rack .rk-table td:last-child { white-space: nowrap; }
  .pg-rack .rk-10g { color: var(--gold-light) !important; }
  .pg-rack .rk-next { display: flex; flex-wrap: wrap; gap: 10px 32px; margin: 0; }
</style>
