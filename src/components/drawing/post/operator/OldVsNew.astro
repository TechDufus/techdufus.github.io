---
/*
  FIG 2 · Same server. Different operator. The old lab and the new one, layer by layer: a
  drawing-schedule table. Wide: three columns (layer · before → now), the now column on a faint
  band. Narrow (280 units): a two-line key (— before, → now) over one block per layer, before
  (receding) over now. Every cell's text wraps to the same width in both layouts, so each row
  is drawn once and moved (at()), and its cells move inside it.
*/
import Figure from '../../figure/Figure.astro';
import { at, head, wrap } from '../../../../lib/drawing/figure';
import { oldVsNew as D } from './data';
import './operator.css';

const WRAP = 33; // characters a line (12px mono ≈ 7.3 units a character → ≈ 242 units)
const LH = 16;

/* wide: 680 · layer 16 · before 108 · arrow 364→404 · now 414 (band from 404) */
const W = 680, LX = 16, BX = 108, NX = 414, TOP = 60;
/* narrow: 280 · marks and layer 8 · text 26 */
const NW = 280, NL = 8, NT = 26, NTOP = 92;

let y = TOP, ny = NTOP;
const rows = D.rows.map((r) => {
  const b = wrap(r.before, WRAP), n = wrap(r.now, WRAP);
  const h = 16 + Math.max(b.length, n.length) * LH;
  const nowY = ny + 40 + b.length * LH + 6;
  const row = { ...r, b, n, y, ny, nowY };
  y += h;
  ny = nowY + (n.length - 1) * LH + 16;
  return row;
});
const H = y + 14, NH = ny + 4;

const rulesW = rows.map((r) => `M${LX} ${r.y}H${W - LX}`).join('') + `M${LX} ${y}H${W - LX}`;
const rulesN = rows.map((r) => `M${NL} ${r.ny - 4}H${NW - NL}`).join('');
const arrW = rows.map((r) => `M364 ${r.y + 17}H397`).join('');
const headW = rows.map((r) => head(404, r.y + 17, 'r')).join('');
/* narrow marks: a dash before "before", an arrow before "now"; the key's two lines first */
const marks = [[18, 58], ...rows.map((r) => [r.ny + 36, r.nowY - 4])];
const dashN = marks.map(([d]) => `M${NL} ${d}h9`).join('');
const arrN = marks.map(([, a]) => `M${NL} ${a}h7`).join('');
const headN = marks.map(([, a]) => head(NT - 4, a, 'r')).join('');

const desc =
  `Nine layers of the same server, before (${D.before.head}, ${D.before.sub}) and now (${D.now.head}, ${D.now.sub}). ` +
  D.rows.map((r) => `${r.layer}: ${r.before}, now ${r.now}`).join('; ') + '.';
---

<Figure
  id="fig-operator"
  fig={2}
  date="2026-09-29"
  title={D.title}
  desc={desc}
  size={[W, H]}
  narrow={[NW, NH]}
  bp={W}
>
  <rect class="fg-band fg-w" x="404" y="8" width={W - 404 - 8} height={H - 16} style="--p:0" />
  <path class="ln-thin fg-w" d={rulesW} style="--p:1" />
  <path class="ln-thin fg-n" d={rulesN} style="--p:1" />
  <g class="fg-edge" style="--p:3">
    <path class="ln-med fg-w" d={arrW} pathLength="1" />
    <path class="fg-arr fg-w" d={headW} />
    <path class="ln-thin fg-n" d={dashN} />
    <path class="ln-med fg-n" d={arrN} />
    <path class="fg-arr fg-n" d={headN} />
  </g>

  <g style="--p:4">
    <g {...at([BX, 28], [NT, 22])}>
      <text class="view__t op-old">{D.before.head}</text>
      <text class="op-n" y="17">{D.before.sub}</text>
    </g>
    <g {...at([NX, 28], [NT, 62])}>
      <text class="view__t op-foil">{D.now.head}</text>
      <text class="op-n" y="17">{D.now.sub}</text>
    </g>
  </g>

  <g style="--p:5">
    {rows.map((r) => (
      <g {...at([0, r.y + 21], [0, r.ny + 18])}>
        <text {...at([LX, 0], [NL, 0], 'txt-label fg-h')}>{r.layer}</text>
        <text {...at([BX, 0], [NT, 22], 'op-t op-old')}>{r.b.map((t, i) => <tspan x="0" y={i ? i * LH : undefined}>{t}</tspan>)}</text>
        <text {...at([NX, 0], [NT, r.nowY - r.ny - 18], 'op-t op-new')}>{r.n.map((t, i) => <tspan x="0" y={i ? i * LH : undefined}>{t}</tspan>)}</text>
      </g>
    ))}
  </g>
</Figure>
