---
/*
  /lab/: the lab is the drawings. The hero's numbers come from src/data/lab/ (the same data the
  sheets draw); the words around them, the changelog and the desk from labSpec (src/data/site.ts).
    01 the cabinet   Sheet 01's excerpt (CabinetExcerpt: drawing + devices by role)
    02 the stack     Sheet 03's excerpt (StackExcerpt)
    03 drawn to spec the three sheets and the posts that use them
    04 changelog     05 the desk
  Both excerpts are kit figures: numbered parts open cards (src/scripts/drawing.ts).
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/lab.css';
import CabinetExcerpt from '../components/drawing/rack/CabinetExcerpt.astro';
import StackExcerpt from '../components/drawing/stack/StackExcerpt.astro';
import SheetThumb from '../components/drawing/rack/SheetThumb.astro';
import Stat from '../components/ui/Stat.astro';
import { fmtDate, linkProps } from '../components/ui/format';
import { labSpec } from '../data/site';
import { cabinet, derived as rack } from '../data/lab/rack';
import { server } from '../data/lab/server';
import { stackItems } from '../data/lab/stack';
import { getPostMetas } from '../lib/content';
import { getFeaturedRepos } from '../lib/github';

const [metas, repos] = await Promise.all([getPostMetas(), getFeaturedRepos()]);
const postByHref = (href?: string) => (href ? metas.find((meta) => meta.href === href) : undefined);
const dotfilesHref = repos.find((repo) => repo.name === 'dotfiles')?.url ?? 'https://github.com/TechDufus/dotfiles';
const ws = labSpec.workstation;
const { drawings } = labSpec;

/* ---------- Hero: counted from the drawings' data ---------- */
const talos = stackItems().find((item) => item.id === 'talos-nodes');
const sheetOf = (thumb: string) => drawings.sheets.find((s) => s.thumb === thumb);
const cabSheet = sheetOf('cabinet');
const stackSheet = sheetOf('stack');

/* ---------- Changelog ---------- */
const splitTitle = (title: string): [string, string, boolean] => {
  const arrow = title.split(/\s*->\s*|\s*→\s*/);
  if (arrow.length === 2) return [arrow[0], arrow[1], true];
  const comma = title.lastIndexOf(', ');
  return comma > 0 ? [title.slice(0, comma + 1), title.slice(comma + 2), false] : [title, '', false];
};
const changelog = labSpec.changelog.map((item, index) => {
  const [from, to, isArrow] = splitTitle(item.title);
  return { ...item, post: postByHref(item.href), from, to, isArrow, index, when: fmtDate(item.date, 'short') };
});

/* ---------- Drawn to spec: the posts that use the drawings ---------- */
const posts = drawings.posts.map((p) => ({ ...p, meta: postByHref(p.href) }));
const count = (n: number, one: string) => `${n} ${one}${n === 1 ? '' : 's'}`;

/* ---------- Desk ---------- */
const photo = ws.photo;
const [photoLead, photoRest] = (photo.caption ?? '').split(' · ');
---

<BaseLayout
  title="The lab"
  description={`The homelab as engineering drawings: the cabinet, the R720xd and the stack on top of it (Proxmox, Talos Kubernetes, Flux), plus a terminal-first desk. Last revised ${labSpec.lastRevised}.`}
>
  <div class="pg-lab">
  <!-- ============ HERO ============ -->
  <section id="top" class="lhero" aria-labelledby="lab-title">
    <div class="wrap">
      <p class="eyebrow lhero__eyebrow" data-reveal>Homelab + workstation</p>
      <h1 class="display" id="lab-title" data-reveal style="--d:1" set:html={labSpec.headline} />
      <p class="lede lhero__lede" data-reveal style="--d:2">{labSpec.lede}</p>
      <p class="lhero__note" data-reveal style="--d:3">
        <span class="badge badge--live"><i class="dot" aria-hidden="true"></i>{labSpec.status} · revised <time datetime={labSpec.lastRevisedIso}>{labSpec.lastRevised}</time></span>
      </p>

      <dl class="stats lhero__stats" data-reveal style="--d:3">
        <Stat value={server.threads} term="Threads" label="threads, two Xeons, one R720xd" />
        <Stat value={server.memory.gb} accent="GB" term="Memory" label="of RAM in the same box" />
        <Stat value={server.pools.length} term="ZFS pools" label={`ZFS pools: ${server.pools.map((p) => p.id).join(', ')}`} />
        {talos?.count && <Stat value={talos.count} term="Cluster" label={`Talos ${talos.version} nodes on Proxmox`} />}
        <Stat value={rack.uUsed} accent="U" term="Cabinet" label={`of ${cabinet.heightU}U in the cabinet`} />
      </dl>
    </div>
  </section>

  <!-- ============ 01 · THE CABINET ============ -->
  <section id="cabinet" class="section" aria-labelledby="cab-title">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div class="sec-head__bar" data-reveal>
          <span class="sec-head__index">01</span>
          <span class="eyebrow">Hardware</span>
          {cabSheet && <span class="sec-head__aside"><span class="meta">{cabSheet.no} · {cabSheet.state}</span></span>}
        </div>
        <h2 class="h2 sec-head__title" id="cab-title" data-reveal>The <em>cabinet</em>.</h2>
        <p class="lede" data-reveal style="--d:1">{rack.uUsed}U of {cabinet.heightU}U in use. The rest is air, for now.</p>
      </div>
      <CabinetExcerpt id="lab-cab" />
    </div>
  </section>

  <!-- ============ 02 · THE STACK ============ -->
  <section id="stack" class="section" aria-labelledby="stack-title">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div class="sec-head__bar" data-reveal>
          <span class="sec-head__index">02</span>
          <span class="eyebrow">Software</span>
          {stackSheet && <span class="sec-head__aside"><span class="meta">{stackSheet.no} · {stackSheet.state}</span></span>}
        </div>
        <h2 class="h2 sec-head__title" id="stack-title" data-reveal>The <em>stack</em>.</h2>
        <p class="lede" data-reveal style="--d:1">Metal at the bottom, Kubernetes on top. The top floor is still going up.</p>
      </div>
      <div class="lstack"><StackExcerpt id="lab-stack" /></div>
    </div>
  </section>

  <!-- ============ 03 · DRAWN TO SPEC ============ -->
  <section id="drawings" class="section" aria-labelledby="dts-title">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div class="sec-head__bar" data-reveal>
          <span class="sec-head__index">03</span>
          <span class="eyebrow">Drawn to spec</span>
          <span class="sec-head__aside"><span class="meta">{count(drawings.sheets.length, 'sheet')} · {count(posts.length, 'post')}</span></span>
        </div>
        <h2 class="h2 sec-head__title" id="dts-title" data-reveal>Drawn to <em>spec</em>.</h2>
        <p class="lede" data-reveal style="--d:1">{drawings.lede}</p>
      </div>
      <ul class="dts" role="list" data-reveal style="--d:1">
        {drawings.sheets.map((d) => (
          <li>
            <a class="dts__card" href={d.href}>
              <span class="dts__art"><SheetThumb kind={d.thumb} /></span>
              <span class="dts__tb">
                <span class="dts__no">{d.no}<span class:list={['dts__state', { 'is-wip': d.state !== 'As built' }]}>{d.state}</span></span>
                <span class="dts__t">{d.title}</span>
                <span class="dts__note">{d.note}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <div class="dts-posts" data-reveal style="--d:2">
        <h3 class="dts-posts__h">Posts that use them</h3>
        <ul class="dts-posts__list" role="list">
          {posts.map((p) => (
            <li>
              <a class="dts__card dts__card--post" href={p.href}>
                <span class="dts__art"><SheetThumb kind={p.thumb} /></span>
                <span class="dts__tb">
                  <span class="dts__no">The post{p.meta && <> · {fmtDate(p.meta.date)} · {p.meta.minutes} min</>}</span>
                  <span class="dts__t">{p.title} <span class="arrow" aria-hidden="true">→</span></span>
                  <span class="dts__note">{p.note}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ 04 · CHANGELOG ============ -->
  <section id="changelog" class="section" aria-labelledby="log-title">
    <div class="wrap">
      <div class="sec-head">
        <div class="sec-head__bar" data-reveal>
          <span class="sec-head__index">04</span>
          <span class="eyebrow">Changelog</span>
          <span class="sec-head__aside"><span class="badge badge--live"><i class="dot" aria-hidden="true"></i>{labSpec.status}</span></span>
        </div>
      </div>
      <div class="log">
        <div class="log__intro" data-reveal>
          <h2 class="h2" id="log-title">Changelog.</h2>
        </div>
        <ol class="timeline" data-reveal style="--d:1">
          {changelog.map((item) => (
            <li class:list={['timeline__item', 'log__item', { 'is-now': item.index === 0 }]}>
              <span class="timeline__when"><time datetime={item.date}>{item.when}</time>{item.index === 0 && ' · latest'}</span>
              <h3 class="log__what">
                {item.href ? (
                  <a href={item.href}>{item.from}{item.to && ' '}{item.to && (item.isArrow ? <><span class="to">→</span> {item.to}</> : <span class="to">{item.to}</span>)}</a>
                ) : (
                  <>{item.from}{item.to && <> <span class="to">{item.isArrow ? `→ ${item.to}` : item.to}</span></>}</>
                )}
              </h3>
              {item.note && <p>{item.note}</p>}
              {item.href && (
                <p class="log__links">
                  <a class="link" href={item.href}>{item.cta ?? 'Read the post'} <span class="arrow" aria-hidden="true">→</span></a>
                  {item.post && <span class="meta">{fmtDate(item.post.date)} · {item.post.minutes} min</span>}
                </p>
              )}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ 05 · DESK ============ -->
  <section id="workstation" class="section" aria-labelledby="ws-title">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div class="sec-head__bar" data-reveal>
          <span class="sec-head__index">05</span>
          <span class="eyebrow">Workstation</span>
          <span class="sec-head__aside"><a class="meta link link--quiet" {...linkProps(dotfilesHref)}>TechDufus/dotfiles ↗</a></span>
        </div>
        <h2 class="h2 sec-head__title" id="ws-title" data-reveal>The <em>desk</em>.</h2>
      </div>

      <div class="ws">
        <figure class="photo" data-reveal>
          <div class="photo__img">
            <img data-lazy src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
          </div>
          {photo.caption && <figcaption><span>{photoLead}</span>{photoRest && <span>{photoRest}</span>}</figcaption>}
        </figure>
        <div data-reveal style="--d:1">
          <dl class="spec" aria-label={`${ws.host} specs`}>
            <div><dt>Machine</dt><dd>{ws.host}<small>{ws.role}</small></dd></div>
            {ws.specs.map((row) => (
              <div><dt>{row.k}</dt><dd>{row.href ? <a {...linkProps(row.href)}>{row.v}</a> : row.v}</dd></div>
            ))}
            <div><dt>Keyboard</dt><dd>{ws.keyboard.name}, custom {ws.keyboard.layout}<small><a {...linkProps(ws.keyboard.configHref)}>ORYX ↗</a></small></dd></div>
            <div><dt>Terminal</dt><dd>{ws.terminalStack.join(' → ')}</dd></div>
          </dl>
        </div>
      </div>

      <div class="ws__foot" data-reveal>
        <a class="link" href={labSpec.setupHref}>Everything else is in the setup notes <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
  </div>
</BaseLayout>

<script>
  // Big JPEGs: lazy, then fade in once decoded.
  document.querySelectorAll<HTMLImageElement>('img[data-lazy]').forEach((img) => {
    const box = img.parentElement;
    if (!box) return;
    const done = () => box.classList.add('is-loaded');
    if (img.complete && img.naturalWidth) done();
    else {
      img.addEventListener('load', done, { once: true });
      img.addEventListener('error', done, { once: true });
    }
  });
</script>
