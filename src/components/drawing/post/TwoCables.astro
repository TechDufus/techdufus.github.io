---
/*
  FIG 5 · Two cables, 26 bays: the inside of the R720xd from above, simplified, from
  server.internal (parts and cable routes as fractions of the chassis). The part drawing is one
  group in fraction units, mapped by a matrix: front to the left in the wide layout, front at the
  top in the narrow one (a CSS matrix; strokes are non-scaling). Labels move as blocks. Cables 1–4
  are clickable parts; their balloons carry the cable numbers.
*/
import Figure from '../figure/Figure.astro';
import Balloon from '../Balloon.astro';
import PartCard from '../PartCard.astro';
import { server } from '../../../data/lab/server';
import type { Cable } from '../../../data/lab/types';
import { at, Pen, type P } from '../../../lib/drawing/figure';

const { internal, cables, controller, bays } = server;
const part = (id: string) => {
  const p = internal.parts.find((x) => x.id === id);
  if (!p) throw new Error(`TwoCables: internal part ${id} missing`);
  return p;
};
const route = (n: number) => internal.routes.find((r) => r.cable === n)?.paths ?? [];

/* fraction formatter: ".017", "-.966" */
const q = (v: number): string => String(Math.round(v * 1000) / 1000).replace(/^(-?)0\./, '$1.');
const box = (id: string): string => {
  const { x, z } = part(id);
  return `M${q(x[0])} ${q(z[0])}h${q(x[1] - x[0])}v${q(z[1] - z[0])}h${q(x[0] - x[1])}Z`;
};
const line = (pts: [number, number][]): string => pts.map(([x, z], i) => `${i ? 'L' : 'M'}${q(x)} ${q(z)}`).join('');

/* layouts: wide = front at the left, narrow = front at the top */
const Wd = { x: 110, y: 34, d: 680, w: 380 };
const Nw = { x: 20, y: 84, d: 560, w: 350 };
const mapW = (u: number, v: number): P => [Wd.x + Wd.d * v, Wd.y + Wd.w * (1 - u)];
const mapN = (u: number, v: number): P => [Nw.x + Nw.w * u, Nw.y + Nw.d * v];
const matW = `matrix(0 ${-Wd.w} ${Wd.d} 0 ${Wd.x} ${Wd.y + Wd.w})`;
const matN = `--n:matrix(${Nw.w},0,0,${Nw.d},${Nw.x},${Nw.y})`;

/* the drawing, one path per pen; the cables are parts of their own */
const FRONT = bays.front;
const bp = part('backplane');
const bayLines = Array.from({ length: FRONT + 1 }, (_, i) => bp.x[0] + ((bp.x[1] - bp.x[0]) * i) / FRONT)
  .map((x) => `M${q(x)} 0V${q(bp.z[0])}`)
  .join('');
const pen = new Pen()
  .add('ln-obj', 'M0 0h1v1h-1Z')
  .add('ln-thin', bayLines + ['fans', 'retention', 'riser-1', 'psu-1', 'psu-2'].map(box).join(''))
  .add('ln-med', ['backplane', 'sas-b', 'sas-a', 'sas-a1', 'flex-backplane', 'flex-sas-a1'].map(box).join(''))
  .add('ln-hid sem-removed', box('perc'))
  .add('tint ln-med sem-removed', box('j-sasx8'))
  .add('tint ln-med sem-new', ['hba330', 'hba-port-1', 'hba-port-2'].map(box).join(''));

const TONE: Record<Cable['state'], { c: string; ln: string; word: string }> = {
  new: { c: 'sem-new', ln: 'ln-obj', word: 'new' },
  keep: { c: '', ln: 'ln-obj', word: 'untouched' },
  removed: { c: 'sem-removed', ln: 'ln-hid', word: 'came out' },
};
const drawn = cables.filter((c) => c.n !== 5); // cable 5 (power and signal) isn't part of the story
const cableId = (c: Cable): string => `cable-${c.n}`;

/* labels: [wide pos, narrow pos] from fraction anchors plus per-layout nudges */
const both = (u: number, v: number, dw: P = [0, 0], dn: P = [0, 0]): [P, P] => {
  const w = mapW(u, v), n = mapN(u, v);
  return [[w[0] + dw[0], w[1] + dw[1]], [n[0] + dn[0], n[1] + dn[1]]];
};
const mid = (id: string): [number, number] => {
  const { x, z } = part(id);
  return [(x[0] + x[1]) / 2, (z[0] + z[1]) / 2];
};
const connectors = ['sas-b', 'sas-a', 'sas-a1'].map((id, i) => {
  const [u, v] = mid(id);
  // narrow: the three sit 47 apart, so the middle one steps up a line
  const [wp, np] = both(u, v, [-10 - Wd.d * v, 4], [0, -12 - Nw.d * v - (i === 1 ? 15 : 0)]);
  return { t: part(id).label, wp, np, lw: `M${wp[0] + 4} ${wp[1] - 4}H${mapW(u, v)[0]}`, ln: `M${np[0]} ${np[1] + 4}V${mapN(u, v)[1]}` };
});
// balloons on the cables: a point on each route
const FLAG: Record<number, [number, number]> = { 1: [0.097, 0.42], 2: [0.227, 0.745], 3: [0.133, 0.755], 4: [0.95, 0.42] };
const [hbaU, hbaV] = mid('hba330');
const [percU, percV] = mid('perc');
const flex = part('flex-backplane');
const hba = controller.now.id.toUpperCase();
const perc = controller.before.name;
const legend = (['new', 'keep', 'removed'] as const).map((s) => ({ s, ns: drawn.filter((c) => c.state === s).map((c) => c.n) }));

const desc =
  `The server from above, simplified. New cables 2 and 3 run from the ${hba} in riser 1 to backplane SAS A and SAS B; ` +
  `its SAS expander feeds all ${FRONT} front bays. Cable 4 was untouched and feeds the ${bays.rear} rear bays. ` +
  `Cable 1, from the system board's J_SASX8, came out with the ${perc}.`;
---

<Figure
  id="fig-cables"
  fig="TD-LAB-02 · FIG 5"
  rev="B"
  date="2026-09-29"
  scale="SCHEMATIC"
  title="Two cables, 26 bays"
  desc={desc}
  caption="Two cables reach all 26 bays, because the backplane does the fanning out."
  size={[900, 456]}
  narrow={[390, 710]}
  breakout
  interactive
  hint
>
  <g transform={matW} class="fg-m" style={matN}>
    {pen.list.map(({ c, d }) => <path class={c} d={d} />)}
    {drawn.map((c) => (
      <g class:list={['part', TONE[c.state].c]} data-part={cableId(c)} role="button" tabindex="0" aria-pressed="false" aria-label={`Cable ${c.n}`}>
        <path class="dwg-hit pm-hit" d={route(c.n).map(line).join('')} />
        <path class={TONE[c.state].ln} d={route(c.n).map(line).join('')} />
      </g>
    ))}
  </g>
  <path class="ln-lead fg-w" d={connectors.map((c) => c.lw).join('')} style="--p:5" />
  <path class="ln-lead fg-n" d={connectors.map((c) => c.ln).join('')} style="--p:5" />

  <g style="--p:6">
    <g {...at([12, 24], [20, 22])}>
      <text class="view__t">FRONT</text>
      <text class="txt-note" x="62">{FRONT} bays</text>
    </g>
    <g {...at([12, 360], [20, 44])}>
      <text class="txt-note">backplane +</text>
      <text class="txt-note" y="15">SAS expander</text>
    </g>
    {connectors.map((c) => <text {...at(c.wp, c.np, 'txt-label fg-e fg-nc')}>{c.t}</text>)}
    <g {...at(...both(hbaU, hbaV, [0, -3], [0, -3]), 'sem-new fg-c')}>
      <text class="txt-label">{hba}</text>
      <text class="txt-note" y="15">riser 1</text>
    </g>
    <g {...at(...both(percU, percV, [-34, -6], [0, -2]), 'sem-removed fg-e fg-nc fg-ko')}>
      <text class="txt-label">{perc}</text>
      <text class="txt-note" y="15">came out</text>
    </g>
    <g class="sem-removed"><text {...at(...both(...mid('j-sasx8'), [-14, 4], [7, 21]), 'txt-note fg-e fg-ko')}>{part('j-sasx8').label}</text></g>
    <g {...at(...both((flex.x[0] + flex.x[1]) / 2, flex.z[0], [-27, -8], [-20, -41]), 'fg-e fg-nc fg-ko')}>
      <text class="txt-note">flex backplane</text>
      <text class="txt-label" y="15">{bays.rear} rear bays</text>
    </g>
    <text {...at([Wd.x + Wd.d + 14, Wd.y + Wd.w / 2], [Nw.x, Nw.y + Nw.d + 20], 'view__t')}>REAR</text>
    <g {...at([Wd.x, Wd.y + Wd.w + 30], [Nw.x, Nw.y + Nw.d + 44])}>
      {legend.map((l, i) => (
        <g class={TONE[l.s].c || undefined}><text class="txt-note" x={[0, 110, 240][i]}>{l.ns.join(', ')} · {TONE[l.s].word}</text></g>
      ))}
    </g>
  </g>
  {drawn.map((c) => (
    <g {...at(...both(...FLAG[c.n]), TONE[c.state].c)}>
      <Balloon at={[0, 0]} n={c.n} part={cableId(c)} r={9} />
    </g>
  ))}

  <Fragment slot="cards">
    {drawn.map((c) => <PartCard id={cableId(c)} title={c.card.title} kind={c.card.kind} lines={c.card.lines} />)}
  </Fragment>
</Figure>

<style is:global>
  .fg .pm-hit { fill: none; stroke: transparent; stroke-width: 14px; vector-effect: non-scaling-stroke; }
</style>
