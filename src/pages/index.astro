---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Portrait from '../components/ui/Portrait.astro';
import HeroAmbience from '../components/ui/HeroAmbience.astro';
import Stat from '../components/ui/Stat.astro';
import Ticker from '../components/ui/Ticker.astro';
import PostFeature from '../components/ui/PostFeature.astro';
import PostRow from '../components/ui/PostRow.astro';
import SpecList from '../components/ui/SpecList.astro';
import RepoCard from '../components/ui/RepoCard.astro';
import Draft from '../components/ui/Draft.astro';
import ProofPoints from '../components/ui/ProofPoints.astro';
import EmailCopy from '../components/ui/EmailCopy.astro';
import SocialChips from '../components/ui/SocialChips.astro';
import { delay, fmtDate, fmtNum, hostOf, isoDate } from '../components/ui/format';
import {
  aboutCopy,
  business,
  businessCopy,
  featuredProject,
  fillCopy,
  heroCopy,
  homeCopy,
  homeOperatingStyle,
  homeProofPoints,
  isPlaceholder,
  labSpec,
  profileSpotlight,
  siteMetadata,
  topics
} from '../data/site';
import { getPostMetas, postStats } from '../lib/content';
import { featuredReposNote, getFeaturedRepos } from '../lib/github';

const posts = await getPostMetas();
const stats = postStats(posts);
const [latestPost, ...olderPosts] = posts;
const listPosts = olderPosts.slice(0, 5);

const repos = await getFeaturedRepos();
const totalStars = repos.reduce((sum, repo) => sum + repo.stars, 0);

// Section numbering follows what actually renders, so the flag never leaves gaps.
const sectionOrder = ['app', 'writing', 'lab', 'work', 'services', 'about', 'contact'].filter(
  (id) => business.enabled || (id !== 'app' && id !== 'services')
);
const sectionIndex = (id: string) => sectionOrder.indexOf(id) + 1;

// Hero headline, split into words so each can rise in on load; the (first) accent word gets the gold <em>.
let accented = false;
const headlineWords = heroCopy.headline.split(' ').map((word) => {
  const at = accented ? -1 : word.indexOf(heroCopy.accentWord);
  if (at < 0) return { before: word, accent: '', after: '' };
  accented = true;
  return { before: word.slice(0, at), accent: heroCopy.accentWord, after: word.slice(at + heroCopy.accentWord.length) };
});

// Trust strip: copy lives in heroCopy, numbers are computed here.
const trustValues = {
  posts: stats.count,
  firstYear: stats.first.getUTCFullYear(),
  stars: fmtNum(totalStars),
  repos: repos.length
};
const trustTerms = ['Writing', 'Open source', 'Production'];
const proofSources = homeProofPoints.filter((point) => point.sourceHref);
const trust = heroCopy.trust.map((item, i) => {
  const value = fillCopy(item.value, trustValues);
  const sourceN = item.href ? proofSources.findIndex((point) => point.sourceHref === item.href) + 1 : 0;
  return {
    value,
    label: fillCopy(item.label, trustValues),
    accent: item.accent,
    term: trustTerms[i] ?? fillCopy(item.label, trustValues),
    num: /^[\d,]+$/.test(value),
    // Point at the numbered source in #about when it exists, otherwise link the source itself.
    href: sourceN > 0 ? `#src-${sourceN}` : item.href,
    linkText: sourceN > 0 ? `[${sourceN}]` : undefined,
    linkLabel: sourceN > 0 ? `Source ${sourceN}` : undefined
  };
});
const secondaryCta = business.enabled ? heroCopy.ctas.waitlist : heroCopy.ctas.lab;

const gitopsName = labSpec.gitops.repo.split('/').pop() ?? labSpec.gitops.repo;
const hardwareRows = labSpec.hardware.map((row) => ({ k: row.role, v: row.name, note: row.spec, href: row.href }));
const latestChange = labSpec.changelog[0];
const [changeFrom, changeTo] = latestChange ? latestChange.title.split(/\s*->\s*/) : [];

const aboutQuote = homeOperatingStyle[0];

// #app / #services styles, emitted only when the business flag renders those sections.
const businessCss = [
  '.pg-home .app__grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(40px,6vw,96px);align-items:start}',
  '.pg-home .app__name{font-family:var(--font-mono);font-size:.8125rem;color:var(--muted);margin-bottom:18px}',
  '.pg-home .app__points{display:grid;gap:0;margin-top:36px;border-top:1px solid var(--line);counter-reset:vp}',
  '.pg-home .app__points li{display:grid;grid-template-columns:40px minmax(0,1fr);gap:12px;padding:16px 0;border-bottom:1px solid var(--line);counter-increment:vp}',
  '.pg-home .app__points li::before{content:counter(vp,decimal-leading-zero);font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--accent);padding-top:4px}',
  '.pg-home .app__points strong{display:block;font-weight:500;color:var(--ink)}',
  '.pg-home .app__points span.muted{font-size:.95rem}',
  '.pg-home .app__join{margin-top:36px}',
  '.pg-home .app__join .label{display:block;margin-bottom:10px;color:var(--ink-2)}',
  '.pg-home .app__more{margin-top:28px;display:inline-flex;gap:8px;align-items:center;font-weight:500}',
  '.pg-home .app__demo-cap{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}',
  '.pg-home .app__demo{position:sticky;top:calc(var(--nav-h) + 24px)}',
  '@media (max-width:960px){.pg-home .app__grid{grid-template-columns:minmax(0,1fr)}.pg-home .app__demo{position:static}}',
  '@media (max-width:640px){.pg-home .app__join .btn{width:100%}.pg-home .app__demo .chat--inline{height:560px}}',
  '.pg-home .services__steps{margin-top:clamp(56px,7vw,96px)}',
  '.pg-home .services__steps-head{display:flex;align-items:center;gap:12px;margin-bottom:28px}',
  '.pg-home .service-card h3{font-size:1.75rem}',
  // .steps (numbered steps with big serif numerals); [app].astro carries its own copy.
  '.pg-home .steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(20px,3vw,40px);counter-reset:step}',
  '.pg-home .steps>li{counter-increment:step;padding-top:20px;border-top:1px solid var(--line-2);display:grid;gap:8px;align-content:start}',
  '.pg-home .steps>li::before{content:counter(step,decimal-leading-zero);font-family:var(--font-mono);font-size:var(--fs-xs);color:var(--accent);letter-spacing:.08em}',
  '.pg-home .steps h4{font-family:var(--font-display);font-size:1.5rem;font-weight:400;line-height:1.15;letter-spacing:-.01em}',
  '.pg-home .steps p{color:var(--muted);font-size:.975rem}',
  '@media (max-width:760px){.pg-home .steps{grid-template-columns:minmax(0,1fr)}}'
].join('');
---

<BaseLayout title={siteMetadata.role} description={homeCopy.metaDescription}>
  <Fragment slot="head">{business.enabled && <Fragment set:html={`<style>${businessCss}</style>`} />}</Fragment>
  <div class="pg-home">
  <!-- ============ HERO ============ -->
  <section id="top" class="hero" aria-labelledby="hero-title">
    <HeroAmbience />
    <div class="wrap hero__grid">
      <div>
        <div class="hero__id">
          <Portrait size="avatar" />
          <div>
            <p class="serif">{profileSpotlight.nickname}</p>
            <p class="meta">{siteMetadata.role}</p>
          </div>
        </div>
        <p class="eyebrow hero__eyebrow" data-reveal>{heroCopy.eyebrow}</p>
        <h1 class="display hero__title" id="hero-title">
          {headlineWords.map((w, i) => <><span class="w" style={`--i:${i}`}>{w.before}{w.accent && <em>{w.accent}</em>}{w.after}</span>{' '}</>)}
        </h1>
        <p class="lede hero__lede" data-reveal style="--d:2">{heroCopy.lede}</p>
        <div class="hero__ctas" data-reveal style="--d:3">
          <a class="btn btn--primary btn--lg" href={heroCopy.ctas.primary.href}>
            {heroCopy.ctas.primary.label} <span class="arrow" aria-hidden="true">→</span>
          </a>
          {
            business.enabled ? (
              <a class="btn btn--ghost btn--lg" href={secondaryCta.href}>
                <span class:list={[{ ph: isPlaceholder(business.appName) }]}>{business.appName}</span>
                <span aria-hidden="true">·</span> join the waitlist
              </a>
            ) : (
              <a class="btn btn--ghost btn--lg" href={secondaryCta.href}>
                {secondaryCta.label} <span class="arrow" aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
        <dl class="stats hero__stats" data-reveal style="--d:4">
          {trust.map((item) => <Stat {...item} />)}
        </dl>
      </div>
      <Portrait size="hero" />
    </div>
  </section>

  <!-- ============ TICKER ============ -->
  <Ticker items={topics} />

  <!-- ============ APP (business flag) ============ -->
  {
    business.enabled && (
      <section id="app" class="section" aria-labelledby="app-title">
        <div class="wrap">
          <SectionHead bare index={sectionIndex('app')} label="Launching soon">
            <Draft slot="aside" />
          </SectionHead>
          <div class="app__grid">
            <div class="app__copy">
              <p class="app__name" data-reveal>
                <span class:list={[{ ph: isPlaceholder(business.appName) }]}>{business.appName}</span> · by{' '}
                <span class:list={[{ ph: isPlaceholder(business.companyName) }]}>{business.companyName}</span>
              </p>
              <h2 class="h2" id="app-title" data-reveal style="--d:1">
                <span class="ph">[Headline: the promise, in <em>one line</em>]</span>
              </h2>
              <p class="lede" style="margin-top:24px;--d:2" data-reveal>
                <span class="ph">[One-line pitch: who it's for and what it saves them.]</span>
              </p>
              <ol class="app__points" data-reveal style="--d:3">
                {
                  ['one', 'two', 'three'].map((n) => (
                    <li>
                      <div>
                        <strong><span class="ph">[Value point {n}]</span></strong>
                        <span class="muted"><span class="ph">[A sentence that proves it.]</span></span>
                      </div>
                    </li>
                  ))
                }
              </ol>
              <div class="app__join" id="waitlist" data-reveal style="--d:4">
                <span class="label">Join the waitlist</span>
                <a class="btn btn--primary" href={business.waitlistHref}>
                  Email me to join <span class="arrow" aria-hidden="true">→</span>
                </a>
                <p class="form-note">One email when it launches. Nothing else.</p>
              </div>
              <a class="app__more link" href={business.appHref}>
                Learn more about <span class:list={[{ ph: isPlaceholder(business.appName) }]}>{business.appName}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
            <div class="app__demo" data-reveal style="--d:2">
              <div class="app__demo-cap">
                <span class="badge badge--live"><i class="dot" aria-hidden="true"></i>Live demo</span>
                <span class="meta hide-sm">Same engine as the guide in the corner</span>
              </div>
              <div id="app-demo" data-guide-inline></div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ WRITING ============ -->
  <section id="writing" class="section" aria-labelledby="writing-title">
    <div class="wrap">
      <SectionHead
        index={sectionIndex('writing')}
        label="Writing"
        titleId="writing-title"
        title="Latest <em>writing</em>."
      >
        <a slot="aside" class="link link--quiet" href="/blog/">All {stats.count} posts</a>
      </SectionHead>
      {latestPost && <PostFeature post={latestPost} label="Latest post" />}
      <div class="post-list writing__list">
        {listPosts.map((post, i) => <PostRow post={post} showTags={2} d={i % 3} />)}
      </div>
      <div class="writing__all">
        <a class="btn btn--ghost" href="/blog/">All {stats.count} posts <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link link--quiet meta" href="/feed.xml">RSS feed</a>
      </div>
    </div>
  </section>

  <!-- ============ LAB ============ -->
  <section id="lab" class="section" aria-labelledby="lab-title">
    <div class="wrap">
      <SectionHead
        index={sectionIndex('lab')}
        label="The lab"
        titleId="lab-title"
        title="The <em>lab</em>."
        lede="One server, three Talos nodes, all of it in git. Mid-rebuild."
      >
        <span slot="aside" class="badge badge--live"><i class="dot" aria-hidden="true"></i>{labSpec.status}</span>
      </SectionHead>

      <p
        class="lab__stackline"
        data-reveal
        aria-label={`Stack: Proxmox, then Talos Kubernetes times three, then ArgoCD with GitOps via ${gitopsName}, then ${labSpec.servicesCount} services including Immich. Tailscale Operator for access.`}
      >
        <span>Proxmox</span><span class="to" aria-hidden="true">→</span>
        <span>Talos Kubernetes ×3</span><span class="to" aria-hidden="true">→</span>
        <span>ArgoCD <span class="muted">(GitOps via {gitopsName})</span></span><span class="to" aria-hidden="true">→</span>
        <span>{labSpec.servicesCount} services <span class="muted">incl. Immich</span></span>
        <span class="muted" aria-hidden="true">·</span>
        <span>Tailscale Operator <span class="muted">for access</span></span>
      </p>

      <div class="lab__grid">
        <div data-reveal>
          <h3 class="about__h">Hardware readout</h3>
          <SpecList rows={hardwareRows} />
        </div>
        <div class="lab__side">
          {
            latestChange && (
              <div class="changelog" data-reveal style="--d:1">
                <time class="changelog__when" datetime={isoDate(latestChange.date)}>{fmtDate(latestChange.date, 'short')}</time>
                <p class="changelog__what">
                  {latestChange.href ? (
                    <a href={latestChange.href}>
                      {changeFrom}
                      {changeTo && <><span class="to" aria-hidden="true">→</span> {changeTo}</>}
                    </a>
                  ) : (
                    <>
                      {changeFrom}
                      {changeTo && <><span class="to" aria-hidden="true">→</span> {changeTo}</>}
                    </>
                  )}
                </p>
              </div>
            )
          }
          <a class="btn btn--ghost" href="/lab/" data-reveal style="--d:2">Full lab <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section id="work" class="section" aria-labelledby="work-title">
    <div class="wrap">
      <SectionHead
        index={sectionIndex('work')}
        label="Projects"
        aside={featuredReposNote(repos)}
        titleId="work-title"
        title="Things I <em>build</em>."
      />
      <article class="yw-card" data-reveal>
        <img class="yw-card__shot" src={featuredProject.image.src} alt="" width={featuredProject.image.width} height={featuredProject.image.height} loading="lazy" decoding="async" />
        <div class="yw-card__body">
          <div class="yw-card__head">
            <h3 class="yw-card__name"><a href={featuredProject.href} target="_blank" rel="noopener">{featuredProject.name}</a></h3>
            <span class="chip chip--accent">{featuredProject.status}</span>
          </div>
          <p class="yw-card__tagline">{featuredProject.tagline}</p>
        </div>
        <span class="yw-card__go" aria-hidden="true">{hostOf(featuredProject.href)} <span class="arrow--ne">↗</span></span>
      </article>
      <div class="grid grid--2">
        {repos.map((repo) => <RepoCard repo={repo} why={false} />)}
      </div>
      <div class="work__foot">
        <a class="btn btn--ghost" href="/projects/">All projects <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link link--quiet" href="https://github.com/TechDufus" target="_blank" rel="noopener">More on github.com/TechDufus ↗</a>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES (business flag) ============ -->
  {
    business.enabled && (
      <section id="services" class="section" aria-labelledby="services-title">
        <div class="wrap">
          <SectionHead
            index={sectionIndex('services')}
            label={businessCopy.services.eyebrow}
            titleId="services-title"
            title={businessCopy.services.title}
            lede={businessCopy.services.lede}
          >
            <Fragment slot="aside">
              <span class="meta hide-sm">
                under <span class:list={[{ ph: isPlaceholder(business.companyName) }]}>{business.companyName}</span>
              </span>
              <Draft />
            </Fragment>
          </SectionHead>
          <div class="grid grid--3">
            {
              business.services.map((service, i) => (
                <article class="service-card" data-reveal style={delay(i || null)}>
                  <div class="service-card__top">
                    <span class="meta">{service.index}</span>
                    {service.draft && <Draft />}
                  </div>
                  <h3 class="h3">{service.title}</h3>
                  <p class="service-card__who"><strong>For</strong> {service.who}</p>
                  <ul class="service-card__list">
                    {service.items.map((item) => <li>{item}</li>)}
                  </ul>
                  <div class="service-card__price">
                    <span class:list={['serif', { ph: isPlaceholder(service.price) }]}>{service.price}</span>
                    <span class:list={['meta', { ph: isPlaceholder(service.priceUnit) }]}>{service.priceUnit}</span>
                  </div>
                  <a class="btn btn--ghost service-card__cta" href={service.ctaHref}>
                    {service.ctaLabel} <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </article>
              ))
            }
          </div>
          <div class="services__steps">
            <div class="services__steps-head" data-reveal>
              <h3 class="about__h" style="margin:0">{businessCopy.services.stepsTitle}</h3>
              <Draft />
            </div>
            <ol class="steps">
              {
                businessCopy.services.steps.map((step, i) => (
                  <li data-reveal style={delay(i || null)}>
                    <h4>{step.title}</h4>
                    <p>{step.detail}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ ABOUT ============ -->
  <section id="about" class="section" aria-labelledby="about-title">
    <div class="wrap">
      <SectionHead bare index={sectionIndex('about')} label="About" />
      <div class="split">
        <div class="about__bio">
          <h2 class="h2 sec-head__title" id="about-title" data-reveal style="margin-bottom:32px">Hello, I'm <em>TechDufus</em>.</h2>
          <p class="first" data-reveal>{aboutCopy.intro}</p>
        </div>
        <div class="about__side">
          {
            aboutQuote && (
              <div class="about__quote" data-reveal style="--d:1">
                <p class="quote">{aboutQuote}</p>
              </div>
            )
          }
          <a class="btn btn--ghost" href="/about/" data-reveal style="--d:2">More about me <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <ProofPoints />
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="wrap">
      <SectionHead bare index={sectionIndex('contact')} label="Contact" />
      <h2 class="h2 sec-head__title" id="contact-title" data-reveal>Say <em>hey</em>.</h2>
      <p class="lede" style="margin-top:20px;--d:1" data-reveal>Questions, ideas, work, or a good DNS horror story. Email's fastest.</p>
      <EmailCopy d={2} />
      <SocialChips d={3} />
      <p class="contact__support" data-reveal style="--d:4">Like the notes? <a class="link link--quiet" href="/support/">You can support them <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  </div>

  <style is:global>
    /* Page styles from design/pro-studio/index.html, global under the .pg-home root (no data-astro-cid attributes).
       The hero figure/ring, proof points and contact pieces ship with their components.
       #app / #services styles are `businessCss` above, emitted only with the business flag. */

    /* ---------- Hero ---------- (the lit backdrop, ribbons and sparks: HeroAmbience.astro) */
    .pg-home .hero { position: relative; isolation: isolate; padding-block: clamp(40px, 7vw, 104px) clamp(56px, 7vw, 96px); }
    .pg-home .hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
    .pg-home .hero__id { display: none; }
    .pg-home .hero__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
    .pg-home .hero__eyebrow::before { content: ""; width: 28px; height: 1px; background: var(--gold-line); }
    .pg-home .hero .display { max-width: 13ch; }
    /* White words carry a faint warm glow, as if lit by the gold; each rises in once on load. */
    .pg-home .hero__title { text-shadow: var(--ink-glow); }
    .pg-home .hero__title .w { display: inline-block; }
    @media (prefers-reduced-motion: no-preference) {
      .pg-home .hero__title .w { animation: word-rise 1.1s var(--ease-out) calc(0.1s + var(--i) * 55ms) both; }
    }
    @keyframes word-rise { from { opacity: 0; transform: translateY(0.45em); } }
    .pg-home .hero__lede { margin-top: 28px; }
    .pg-home .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
    .pg-home .hero__stats { margin-top: clamp(48px, 6vw, 72px); }
    .pg-home .hero__stats .stat__label a { text-decoration: underline; text-decoration-color: var(--line-3); text-underline-offset: 3px; }
    .pg-home .hero__stats .stat__label a:hover { color: var(--ink); text-decoration-color: var(--accent); }
    @media (max-width: 960px) {
      .pg-home .hero__grid { grid-template-columns: minmax(0, 1fr); }
      .pg-home .hero__id { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
      .pg-home .hero__id .portrait { width: 72px; height: 72px; flex: none; }
      .pg-home .hero__id p { line-height: 1.35; }
      .pg-home .hero__id .serif { font-size: 1.375rem; font-style: italic; }
      .pg-home .hero__id .meta { color: var(--muted); }
      .pg-home .hero__eyebrow { margin-bottom: 18px; }
    }
    @media (max-width: 640px) {
      .pg-home .hero__ctas .btn { width: 100%; }
      .pg-home .hero .display { font-size: clamp(2.5rem, 11.4vw, 3.25rem); }
    }

    /* ---------- Writing ---------- */
    .pg-home .writing__list { margin-top: clamp(28px, 4vw, 48px); }
    .pg-home .writing__all { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 32px; }

    /* ---------- Lab ---------- */
    .pg-home .lab__stackline { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; padding: 18px 0; margin-bottom: clamp(32px, 4vw, 56px); border-block: 1px solid var(--line); font-family: var(--font-mono); font-size: 0.875rem; color: var(--ink-2); }
    .pg-home .lab__stackline .to { color: var(--accent); }
    .pg-home .lab__stackline .muted { color: var(--faint); }
    .pg-home .lab__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
    .pg-home .lab__side { display: grid; gap: 32px; justify-items: stretch; }
    .pg-home .lab__side > .btn { justify-self: start; }
    .pg-home .changelog { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px 16px; padding: 20px 22px; border-radius: var(--r); border: 1px solid var(--line); background: var(--surface); position: relative; transition: border-color var(--t-2) ease; }
