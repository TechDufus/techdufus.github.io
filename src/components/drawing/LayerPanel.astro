---
/*
  LayerPanel: CAD-style layer list. Each row is an aria-pressed toggle for every element with
  data-layer="<id>" in the same Sheet (SVG groups and HTML furniture alike, e.g. the notes).
  The swatch shows the layer's line type; the eye (struck through when off) is a CSS mask, so
  it costs no markup per row. Put it in the Sheet's `toolbar` slot.

  <LayerPanel layers={[
    { id: 'dims', label: 'Dimensions', line: 'dim' },
    { id: 'air', label: 'Airflow', line: 'air-cold' },
    { id: 'notes', label: 'Notes', line: 'thin', on: false },
  ]} />

    layers  { id, label, line?, on? } — line: swatch recipe, as LineKey ('obj' | 'hid' | 'ctr' |
            'dim' | 'cons' | 'hatch' | 'air-cold' | 'net-10g' | 'pool-bulk' | 'sem-new' …,
            see lineSwatch() in src/lib/drawing/sheet.ts). on: initial state (default true;
            false hides the layer once drawing.ts starts; without JS every layer shows)
    label   accessible name of the group (default "Layers")
*/
import { lineSwatch } from '../../lib/drawing/sheet';

interface Props {
  layers: { id: string; label: string; line?: string; on?: boolean }[];
  label?: string;
}
const { layers, label = 'Layers' } = Astro.props;
---

<div class="dwg-layers" role="group" aria-label={label}>
  <span class="dwg-layers__h" aria-hidden="true">Layers</span>
  {layers.map((l) => {
    const sw = lineSwatch(l.line ?? 'obj');
    return (
      <button type="button" class="dwg-layer" data-layer-toggle={l.id} aria-pressed={l.on === false ? 'false' : 'true'}>
        <i class="dwg-layer__eye" aria-hidden="true"></i>
        <svg class="dwg-layer__sw" viewBox="0 0 22 8" aria-hidden="true">
          <g class={sw.group || undefined}>{sw.hatch ? <rect class={sw.cls} x="1" y="1" width="20" height="6" /> : <path class={sw.cls} d="M1 4h20" />}</g>
        </svg>
        {l.label}
      </button>
    );
  })}
</div>
