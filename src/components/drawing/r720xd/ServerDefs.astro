---
/*
  ServerDefs: the R720xd drawn once, in model millimetres, as <defs> groups that any view places
  with <use href="#{id}-front" transform={…}/>. Lines only (no fills, no lettering), so a <use>
  can be scaled freely: strokes are non-scaling and the pens come from drawing.css.

    #{id}-front   front panel, face-local (u → from the left ear, v ↓ from the top), 482.4 × 87.3
    #{id}-rear    rear panel seen from behind (u → from the left of the body), 444.0 × 87.3
    #{id}-plan    top view with the cover off (u = model x from the left ear, v = −z: the rear wall
                  at v −684, the front plate at v 0 … 18). Schematic inside; no controller, no
                  drives (PlanView adds those for the state it draws).

  Place a face with transform={place(s, x, y)} from ./geom (y = its top edge; for the plan, the
  rack-flange line). Put fills (face-front, tints) BEFORE the <use>.

  Also carries the few styles every server drawing shares (lettering, cables, drive tints).

  <ServerDefs id="lab02" />                     all three
  <ServerDefs id="fig1" only={['front']} />     just the front
*/
import { join } from '../../../lib/drawing/projection';
import { frontPanel, rearPanel, planPaths } from './geom';

type Face = 'front' | 'rear' | 'plan';
interface Props {
  id: string;
  only?: Face[];
}
const { id, only = ['front', 'rear', 'plan'] } = Astro.props;
const has = new Set(only);
const f = has.has('front') ? frontPanel() : null;
const r = has.has('rear') ? rearPanel() : null;
const p = has.has('plan') ? planPaths() : null;
---

<defs>
  {f && (
    <g id={`${id}-front`}>
      <path class="ln-obj" d={join(f.outline, f.ears)} />
      <path class="ln-med" d={join(f.bays, f.ctrl)} />
      <path class="ln-thin" d={join(f.detail, f.latches)} />
    </g>
  )}
  {r && (
    <g id={`${id}-rear`}>
      <path class="ln-obj" d={join(r.outline, r.psus)} />
      <path class="ln-med" d={join(r.slots, r.bays)} />
      <path class="ln-thin" d={r.io} />
    </g>
  )}
  {p && (
    <g id={`${id}-plan`}>
      <path class="ln-obj" d={join(p.shell, p.cpus)} />
      <path class="ln-med" d={join(p.board, p.fans, p.risers, p.psus)} />
      <path class="ln-thin" d={join(p.cage, p.fins, p.dimms, p.retention, p.flex)} />
      <path class="ln-phantom" d={p.shroud} />
      <path class="ln-ctr" d={p.ctr} />
    </g>
  )}
</defs>

<style is:global>
  /* server drawings: small lettering, cables, drives (pool colour via .pool-*) */
  .sv-t, .sv-s { text-anchor: middle; letter-spacing: .06em; fill: var(--muted); }
  .sv-t { font-size: 10.5px; }
  .sv-s { font-size: 8.5px; letter-spacing: .08em; }
  .sv-ko { paint-order: stroke; stroke: var(--dwg-paper); stroke-width: 3px; stroke-linejoin: round; }
  .sv-b { fill: var(--dwg-text-hi); }
  .sem-new .sv-t, .sem-new.sv-t { fill: var(--dwg-new); }
  .sem-removed .sv-t, .sem-removed.sv-t { fill: var(--dwg-removed); }
  .sv-drv { fill: color-mix(in srgb, var(--flow) 26%, transparent); stroke: var(--flow); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  .sv-lt { font-size: 9px; letter-spacing: .1em; fill: var(--flow); }
  .sv-row { fill: var(--dwg-text); }
  .sv-nc { text-transform: none; }
  .pool-rpool .txt-label { fill: var(--flow); }
  .sv-empty { fill: none; stroke: var(--dwg-obj); stroke-width: .8px; stroke-dasharray: 3 3; opacity: .6; vector-effect: non-scaling-stroke; }
  .cbls { --flow: var(--ink-2); }
  .cbl { fill: none; stroke: var(--flow); stroke-width: 2.2px; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; opacity: .85; }
  .sem-removed .cbl { stroke-dasharray: 9 6; }
  .sv-hit { fill: none; stroke: transparent; stroke-width: 12px; pointer-events: stroke; }
</style>
