---
/*
  Tiny gold-ink thumbnails for the /lab "Drawn to spec" cards, generated from the same data as
  the sheets but with a fraction of the line work (no kit CSS on /lab, so the styles live here).
    kind="stack"   Sheet 01: the stack's front faces between two rails, U17 to U26
    kind="server"  Sheet 02: the R720xd's front face, 24 carriers and both ears
    kind="path"    the post: FIG 1 in miniature. Disks → PERC → virtual disks → Proxmox (dashed,
                   leaving) over disks → HBA330 → ZFS → Proxmox (the plan)
  Decorative: the card's text names the sheet, so the SVG is aria-hidden.
*/
import { U_MM } from '../../../lib/drawing/projection';
import { HOLES, rr, slotOf$, stack } from './model';
import { r720xd } from '../../../data/hardware/r720xd';

interface Props {
  kind: 'stack' | 'server' | 'path';
}
const { kind } = Astro.props;
const r1 = (n: number): string => String(Math.round(n * 10) / 10);

/** Evenly split a face into n vertical cells (carriers, bays) as one relative path. */
const cells = (x: number, y: number, w: number, h: number, n: number): string => {
  const cw = w / n;
  const one = `h${r1(cw - 1)}v${r1(h)}h${r1(1 - cw)}Z`;
  return `M${r1(x + 0.5)} ${r1(y)}${one}` + `m${r1(cw)} 0${one}`.repeat(n - 1);
};

let vb = '', obj = '', med = '', thin = '', hid = '', gone = '', add = '';
if (kind === 'stack') {
  const lo = (stack.from - 2) * U_MM, hi = (stack.to + 2) * U_MM;
  const Y = (y: number): number => hi - y; // model y up → svg y down, top of the strip at 0
  vb = `-24 -6 530.6 ${r1(hi - lo + 12)}`;
  const rails = HOLES.map((x) => rr(x - 8, 0, 16, hi - lo)).join('');
  thin = rails;
  for (const id of ['r720xd', 'unas-pro-8', 'udm-pro', 'patch-panel', 'shelf', 'rpi-4b']) {
    const s = slotOf$(id);
    const top = Y(s.faceTop);
    const x = s.plate ? s.plate.x : s.faceX;
    const w = s.plate ? s.plate.w : s.faceW;
    obj += rr(x, top, w, s.faceH);
    if (id === 'r720xd') med += cells(x + 19, top + 5, w - 38, s.faceH - 10, 24);
    if (id === 'unas-pro-8') med += cells(x + 5, top + 8, w - 10, s.faceH / 2 - 10, 4) + cells(x + 5, top + s.faceH / 2 + 3, w - 10, s.faceH / 2 - 10, 4);
    if (id === 'udm-pro') med += rr(x + 6, top + 10, 20, 24) + rr(x + 190, top + 8, 100, 29) + cells(x + 310, top + 9, 70, 26, 4) + rr(x + 386, top + 20, 16, 15);
    if (id === 'patch-panel') med += cells(x + 36, top + 16, w - 72, 14, 24);
    if (id === 'rpi-4b') med += rr(x + 3, top + 4, 16, 12);
  }
  // the ears of the two bracketed boxes
  for (const id of ['unas-pro-8', 'udm-pro']) {
    const s = slotOf$(id);
    const t = Y(s.y0 + s.hU - 0.4);
    thin += rr(0, t, s.faceX, s.hU - 0.8) + rr(482.6 - s.faceX, t, s.faceX, s.hU - 0.8);
  }
} else if (kind === 'server') {
  const s = slotOf$('r720xd');
  const w = s.plate?.w ?? 482.4, h = s.faceH;
  vb = `-6 -6 ${r1(w + 12)} ${r1(h + 12)}`;
  obj = rr(0, 0, w, h) + `M19.3 0v${r1(h)}M${r1(w - 19.3)} 0v${r1(h)}`;
  med = cells(19.3, 5, w - 38.6, h - 10, 24);
  thin = rr(5, 10, 9, 9) + rr(5, 28, 9, 12) + rr(w - 13, 9, 8, 18) + rr(w - 13, 36, 8, 6);
} else {
  // Two rows, as FIG 1: every drive before, the kept ones after; 4 virtual disks (the OS's view,
  // controllers.before.status.note, measured 2026-09-25) against one line per pool.
  const all = r720xd.drives.length, kept = r720xd.drives.filter((d) => d.fate !== 'remove').length;
  const H = 60, BW = 90, X = [70, 200, 330], rows = [36, 146];
  vb = `-6 -6 ${X[2] + BW + 12} ${rows[1] + H / 2 + 12}`;
  const disks = (y: number, n: number): string =>
    Array.from({ length: n }, (_, i) => {
      const dy = (i - (n - 1) / 2) * 8.5;
      return rr(0, y + dy - 2.5, 24, 5) + `M24 ${r1(y + dy)}L${X[0]} ${r1(y + dy * 0.7)}`;
    }).join('');
  const wires = (x0: number, y: number, n: number): string =>
    Array.from({ length: n }, (_, i) => `M${x0 + BW} ${r1(y + (i - (n - 1) / 2) * 7)}H${x0 + 130}`).join('');
  const [a, b] = rows;
  thin = disks(a, all) + disks(b, kept);
  hid = wires(X[0], a, 4) + wires(X[1], a, 4) + rr(X[1], a - H / 2, BW, H);
  gone = rr(X[0], a - H / 2, BW, H);
  add = rr(X[0], b - H / 2, BW, H);
  med = wires(X[0], b, kept) + wires(X[1], b, r720xd.pools.length);
  obj = rr(X[2], a - H / 2, BW, H) + rr(X[1], b - H / 2, BW, H) + rr(X[2], b - H / 2, BW, H);
}
---

<svg class="dts-thumb" viewBox={vb} aria-hidden="true" preserveAspectRatio="xMidYMid meet">
  <path class="dts-thumb__thin" d={thin} />
  {hid && <path class="dts-thumb__thin dts-thumb__hid" d={hid} />}
  <path class="dts-thumb__med" d={med} />
  <path class="dts-thumb__obj" d={obj} />
  {gone && <path class="dts-thumb__obj dts-thumb__gone" d={gone} />}
  {add && <path class="dts-thumb__obj dts-thumb__add" d={add} />}
</svg>

<style is:global>
  .dts-thumb { display: block; width: 100%; height: 100%; overflow: visible; }
  .dts-thumb path { fill: none; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .dts-thumb__obj { stroke: var(--gold-light); stroke-width: 1.3px; }
  .dts-thumb__med { stroke: color-mix(in srgb, var(--gold) 80%, transparent); stroke-width: 0.75px; }
  .dts-thumb__thin { stroke: color-mix(in srgb, var(--gold) 34%, transparent); stroke-width: 0.6px; }
  .dts-thumb .dts-thumb__hid { stroke: color-mix(in srgb, var(--gold) 60%, transparent); stroke-dasharray: 4 3; }
  .dts-thumb .dts-thumb__gone { stroke: var(--danger-ink); stroke-dasharray: 5 3; }
  .dts-thumb .dts-thumb__add { stroke: var(--ok); }
</style>
