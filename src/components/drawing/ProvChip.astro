---
/*
  ProvChip: the HTML provenance mark for text equivalents, spec tables and captions: the same
  one-letter tag as ProvMark, then (optionally) the date or a source link. The full word is
  in the accessible name, so screen readers hear "Measured 2026-09-27".

  <ProvChip prov="measured" asOf="2026-09-27" />
  <ProvChip prov="vendor" href="https://…" source="Dell Owner's Manual" />
  <ProvChip prov="assumed" compact />         letter only (in dense tables)

    prov     'measured' | 'vendor' | 'owner' | 'inferred' | 'assumed'
    asOf     date shown after the letter
    href     source link (vendor); source = link text (default "source")
    note     tooltip text (e.g. how it was inferred)
    compact  letter only (the word stays available to assistive tech and as a tooltip)
*/
import { PROV, provText, type Provenance } from '../../lib/drawing/prov';

interface Props {
  prov: Provenance;
  asOf?: string;
  href?: string;
  source?: string;
  note?: string;
  compact?: boolean;
}
const { prov, asOf, href, source = 'source', note, compact = false } = Astro.props;
const word = provText(prov, asOf);
const tip = note ? `${word}: ${note}` : word;
---

<span class={`prov prov--${prov}`} title={tip}>
  <b aria-hidden="true">{PROV[prov].letter}</b>
  {compact ? <span class="sr-only">{word}</span> : <span class="prov__w">{word}</span>}
  {href && <a class="prov__src" href={href} rel="noopener">{source}</a>}
</span>
