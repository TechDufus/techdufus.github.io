---
/*
  /lab/r720xd/views/: a page partial (no layout, no head) with the tab panels of Sheet 02 that
  load after the page: EXPLODED and BEFORE / AFTER. src/components/drawing/server/server.ts
  fetches it once and moves them into the sheet; the defs they <use> and the cards are already
  on /lab/r720xd/. Everything here is generated at build time, like the rest.
*/
import ExplodedView from '../../../components/drawing/server/ExplodedView.astro';
import BeforeAfter from '../../../components/drawing/server/BeforeAfter.astro';

export const partial = true;
const DWG = 'lab02';
---

<svg xmlns="http://www.w3.org/2000/svg">
  <ExplodedView dwg={DWG} />
  <BeforeAfter dwg={DWG} />
</svg>
