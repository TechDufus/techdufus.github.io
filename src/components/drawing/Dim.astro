---
/*
  Dim: a linear dimension in the ISO 129-1 style (closed filled arrowheads 3:1, extension lines
  with a small gap at the feature and a short overshoot past the dimension line, the value
  written above the line and aligned with it; vertical values read from the right, bottom → top).

  <Dim a={[x1, y]} b={[x2, y]} offset={-24} mm={482.6} sub="[19.00]" />

    a, b     feature points (paper units, or local units inside a scaled group; see k)
    dir      'h' measures Δx, dim line at y = a.y + offset (negative = above)
             'v' measures Δy, dim line at x = a.x + offset (negative = left)
             'aligned' measures |ab|, offset along the normal (dy, −dx)/|ab| (up for a → b rightward)
             default: 'h' if a.y = b.y, 'v' if a.x = b.x, else 'aligned'
    offset   distance from the features to the dimension line
    mm       the value to print; else text; else paper length ÷ scale
    text     literal label (e.g. "2U", "≈ 700", "VIF")
    scale    paper units per mm, used only to derive the value when mm/text are absent
    sub      second line under the dim line (inch equivalents "[19.00]", "REF", "VERIFY IN FIELD")
    ext      which extension lines to draw: 'both' (default) | 'a' | 'b' | 'none'
    k        paper units per local unit when drawn inside a scaled group (iso faces); keeps
             lettering, arrows and gaps at their paper size. Default 1.
    p        plot order (stagger step for the draw-in; default 5)
    class    extra classes on the group (e.g. "sem-new")
*/
import { fmtMm, type Pt } from '../../lib/drawing/projection';

interface Props {
  a: Pt;
  b: Pt;
  offset: number;
  dir?: 'h' | 'v' | 'aligned';
  mm?: number;
  text?: string;
  scale?: number;
  sub?: string;
  ext?: 'both' | 'a' | 'b' | 'none';
  k?: number;
  p?: number;
  class?: string;
}
const { a, b, offset, mm, text, scale = 1, sub, ext = 'both', k = 1, p = 5, class: cls = '' } = Astro.props;
const dir = Astro.props.dir ?? (a[1] === b[1] ? 'h' : a[0] === b[0] ? 'v' : 'aligned');

const FS = 12 / k; // lettering height (paper 12 = 4 mm printed)
const AL = 8.5 / k; // arrow length
const AW = 1.45 / k; // arrow half-width (3:1)
const GAP = 3 / k; // extension line gap at the feature
const OVER = 6 / k; // extension line overshoot
const LIFT = 3.5 / k; // text above the dim line

let A: Pt, B: Pt;
if (dir === 'h') {
  A = [a[0], a[1] + offset];
  B = [b[0], a[1] + offset];
} else if (dir === 'v') {
  A = [a[0] + offset, a[1]];
  B = [a[0] + offset, b[1]];
} else {
  const L0 = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
  const n: Pt = [(b[1] - a[1]) / L0, -(b[0] - a[0]) / L0];
  A = [a[0] + n[0] * offset, a[1] + n[1] * offset];
  B = [b[0] + n[0] * offset, b[1] + n[1] * offset];
}
const f = (v: number): string => String(Math.round(v * 10) / 10);
const P = (pt: Pt): string => `${f(pt[0])} ${f(pt[1])}`;
const L = Math.hypot(B[0] - A[0], B[1] - A[1]) || 1;
const t: Pt = [(B[0] - A[0]) / L, (B[1] - A[1]) / L];
const nrm: Pt = [-t[1], t[0]];

const extLine = (from: Pt, to: Pt): string => {
  const d = Math.hypot(to[0] - from[0], to[1] - from[1]);
  if (d <= GAP) return '';
  const u: Pt = [(to[0] - from[0]) / d, (to[1] - from[1]) / d];
  return `M${P([from[0] + u[0] * GAP, from[1] + u[1] * GAP])}L${P([to[0] + u[0] * OVER, to[1] + u[1] * OVER])}`;
};
const exts = (ext === 'both' || ext === 'a' ? extLine(a, A) : '') + (ext === 'both' || ext === 'b' ? extLine(b, B) : '');

// Arrows inside when they fit, else outside with short tails (ISO 129 small-space rule).
const inside = L >= 2 * AL + 6 / k;
const s = inside ? 1 : -1;
const head = (tip: Pt, dirv: Pt): string => {
  const base: Pt = [tip[0] + dirv[0] * AL, tip[1] + dirv[1] * AL];
  return `M${P(tip)}L${P([base[0] + nrm[0] * AW, base[1] + nrm[1] * AW])}L${P([base[0] - nrm[0] * AW, base[1] - nrm[1] * AW])}Z`;
};
const arrows = head(A, [t[0] * s, t[1] * s]) + head(B, [-t[0] * s, -t[1] * s]);
const tail = inside ? 0 : AL + 7 / k;
const dimLine = `M${P([A[0] - t[0] * tail, A[1] - t[1] * tail])}L${P([B[0] + t[0] * tail, B[1] + t[1] * tail])}`;

const label = text ?? fmtMm(mm ?? L / scale);
let angle = (Math.atan2(t[1], t[0]) * 180) / Math.PI;
if (angle > 90) angle -= 180;
if (angle <= -90) angle += 180;
if (Math.abs(angle - 90) < 0.01) angle = -90;
const mid: Pt = [(A[0] + B[0]) / 2, (A[1] + B[1]) / 2];
---

<g class:list={['dim', cls]} style={[p !== 5 && `--p:${p}`, k !== 1 && `--dwg-k:${k}`].filter(Boolean).join(';') || undefined}>
  <path class="ln-dim" d={exts + dimLine} pathLength="1" />
  <path class="dim-arr" d={arrows} />
  <g transform={`translate(${P(mid)})${angle ? ` rotate(${f(angle)})` : ''}`}>
    <text class="txt-dim" y={f(-LIFT)}>{label}</text>
    {sub && <text class="txt-dim txt-dim--sub" y={f(LIFT + FS * 0.8)}>{sub}</text>}
  </g>
</g>
