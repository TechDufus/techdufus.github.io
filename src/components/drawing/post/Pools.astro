---
/*
  FIG 2 · Three pools, no new drives. One block per pool (members, layout, usable size, what it
  holds) plus the failing drive set aside. Wide: four blocks in a row. Narrow: two by two.
*/
import PostFigure from './PostFigure.astro';
import ProvMark from '../ProvMark.astro';
import { r720xd } from '../../../data/hardware/r720xd';
import type { Drive } from '../../../data/hardware/types';
import { at, drive, POOL_CLASS, rc, shortName, wLabel, wNote, wrap, type P } from './fig';
import { circle } from '../../../lib/drawing/projection';

const ROW = 24, TOP = 30; // drive row pitch, first row's top (block-local)
const glyph = (d: Drive, y: number): string =>
  rc(10, y, 28, 16) + (d.kind === 'hdd' ? circle(21, y + 8, 5.5) + `M31 ${y + 4}v8` : rc(15, y + 5, 6, 6) + rc(24, y + 5, 6, 6));

type Block = { key: string; w: number; wp: P; np: P; c: string; head: string; sub: string; drives: Drive[]; big: string; bigProv?: 'inferred'; foot: string[] };

const widths = [180, 150, 150, 130];
const xs = widths.map((_, i) => 12 + widths.slice(0, i).reduce((s, w) => s + w + 18, 0));
const nxs = [8, 206, 8, 206];
const Y0 = 30, NY1 = Y0 + 208;

const pools: Block[] = r720xd.pools.map((p, i) => ({
  key: p.id,
  w: widths[i],
  wp: [xs[i], Y0],
  np: [nxs[i], i < 2 ? Y0 : NY1],
  c: POOL_CLASS[p.id],
  head: p.id,
  sub: p.layout.value.split(':')[0],
  drives: p.members.map(drive),
  big: p.usable.value.replace(/^about\s*/, '≈ '),
  bigProv: 'inferred',
  foot: wrap(p.holds.value, Math.floor(widths[i] / 6.93)),
}));
const gone = r720xd.drives.filter((d) => d.fate === 'remove');
const quote = gone[0].health.value.match(/“(.+)”/)?.[1] ?? gone[0].health.value;
const out: Block = {
  key: 'out',
  w: widths[3],
  wp: [xs[3], Y0],
  np: [nxs[3], NY1],
  c: 'sem-removed',
  head: 'set aside',
  sub: 'not replaced',
  drives: gone,
  big: `${gone[0].remapped?.value ?? '?'} DEFECTS`,
  foot: wrap(quote, Math.floor(widths[3] / 6.93)),
};
const blocks = [...pools, out];
const kept = r720xd.derived.drivesKept.value as number;
const tally = `${kept} drives kept · 0 bought · ${gone.length} set aside`;

const desc =
  `Three ZFS pools from drives already in the server. ` +
  pools.map((b) => `${b.head}, ${b.sub}: ${b.drives.map(shortName).join(', ')}, ${b.big.replace('≈', 'about')}.`).join(' ') +
  ` Set aside: ${gone.map(shortName).join(', ')} (${quote}).`;
---

<PostFigure
  id="fig-pools"
  n={2}
  title="Three pools, no new drives"
  desc={desc}
  caption="Every healthy drive gets a job. The one that isn't healthy gets a drawer."
  size={[680, 262]}
  narrow={[390, 480]}
>
  {blocks.map((b) => (
    <g {...at(b.wp, b.np, b.c, '--p:6')}>
      {b.key === 'out' && <path class="ln-phantom" d={`M-9 -14V${TOP + ROW * 3 + 70}`} style="--p:4" />}
      <text class="txt-label">{b.head}</text>
      <text class="txt-note" y="16">{b.sub}</text>
      <path
        class="face ln-med"
        d={(b.drives.length > 1 ? `M4 ${TOP + 8}V${TOP + 8 + ROW * (b.drives.length - 1)}` + b.drives.map((_, i) => `M4 ${TOP + 8 + ROW * i}h6`).join('') : '') +
          b.drives.map((d, i) => glyph(d, TOP + ROW * i) + (d.fate === 'remove' ? `M10 ${TOP + ROW * i}l28 16m0 -16l-28 16` : '')).join('')}
        pathLength="1"
        style="--p:2"
      />
      {b.drives.map((d, i) => <text class="txt-note" x="46" y={TOP + ROW * i + 12}>{shortName(d)}</text>)}
      <text class="txt-dim" y={TOP + ROW * 3 + 24}>{b.big}</text>
      {b.bigProv && <ProvMark x={wLabel(b.big) + 4} y={TOP + ROW * 3 + 15} prov={b.bigProv} />}
      {b.foot.map((t, i) => <text class="txt-note" y={TOP + ROW * 3 + 42 + i * 14}>{t}</text>)}
    </g>
  ))}
  <g {...at([12, 248], [8, 466], '', '--p:6')}>
    <text class="txt-note">{tally}</text>
    <ProvMark x={wNote(tally) + 6} y={-8.5} prov="owner" asOf="2026-09-28" />
  </g>
</PostFigure>
