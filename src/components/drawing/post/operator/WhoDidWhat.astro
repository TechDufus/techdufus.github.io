---
/*
  FIG 3 · Who did what: two lanes (me, the agent) across five stages. Every item gets a mark,
  hollow for me and solid for the agent, so the fuller lane reads before a word does. Wide
  (breakout): stages are columns, lanes are rows, the agent's lane on a faint band. Narrow: lanes
  are columns, stages are rows. Items wrap to the same width in both layouts, so each is drawn
  once and moved (at()).
*/
import Figure from '../../figure/Figure.astro';
import { at, wrap } from '../../../../lib/drawing/figure';
import { monoWidth } from '../../../../lib/drawing/sheet';
import { whoDidWhat as D, type Who } from './data';
import './operator.css';

const WRAP = 19; // characters a line (≈ 131 units at 11.5px mono)
const LH = 15, GAP = 7;
const who: Who[] = ['me', 'agent'];

type Item = { t: string[]; dy: number };
/** A cell's items, stacked: each item's first baseline relative to the cell's first one. */
const stackUp = (xs: string[]): { items: Item[]; h: number } => {
  let dy = 0;
  const items = xs.map((x) => {
    const t = wrap(x, WRAP);
    const it = { t, dy };
    dy += t.length * LH + GAP;
    return it;
  });
  return { items, h: dy - GAP };
};
const cells = D.stages.map((s) => ({ stage: s.stage, me: stackUp(s.me), agent: stackUp(s.agent) }));
const tallest = (k: Who): number => Math.max(...cells.map((c) => c[k].h));

/* wide: 920 · 5 columns of CW from X0 · lane rows under a stage header row */
const W = 920, X0 = 16, CW = (W - 2 * X0) / D.stages.length, HEAD = 46;
const laneTop = { me: HEAD, agent: HEAD + 46 + tallest('me') + 14 };
const H = laneTop.agent + 46 + tallest('agent') + 16;
const colX = (i: number): number => X0 + i * CW;

/* narrow: 360 · two lane columns · one band per stage */
const NW = 360, NCOL = { me: 16, agent: 188 }, NHEAD = 58;
let ny = NHEAD;
const bands = cells.map((c) => {
  const top = ny;
  ny += 38 + Math.max(c.me.h, c.agent.h) + 16;
  return top;
});
const NH = ny + 4;

/* rules: wide header rule, lane rule, column rules inside each lane; narrow band rules */
const colRules = (top: number, bottom: number): string =>
  cells.slice(1).map((_, i) => `M${colX(i + 1)} ${top}V${bottom}`).join('');
const rulesW =
  `M${X0} ${HEAD}H${W - X0}M${X0} ${laneTop.agent}H${W - X0}` +
  colRules(10, HEAD - 6) + colRules(laneTop.me + 32, laneTop.agent - 8) + colRules(laneTop.agent + 32, H - 8);
const rulesN = bands.map((t) => `M${X0} ${t}H${NW - X0}`).join('');

const lane = (k: Who) => D.lanes.find((l) => l.id === k)!;
const say = (k: Who): string => cells.map((c) => `${c.stage}: ${D.stages.find((s) => s.stage === c.stage)![k].join(', ')}`).join('; ');
const desc =
  `Two lanes across five stages, and the agent’s is much fuller. ` +
  `${lane('me').label}, ${lane('me').sub}: ${say('me')}. ${lane('agent').label}, ${lane('agent').sub}: ${say('agent')}.`;
---

<Figure
  id="fig-who"
  fig={3}
  date="2026-09-29"
  title={D.title}
  desc={desc}
  size={[W, H]}
  narrow={[NW, NH]}
  breakout
>
  <rect class="fg-band fg-w" x="8" y={laneTop.agent + 4} width={W - 16} height={H - laneTop.agent - 10} style="--p:0" />
  <rect class="fg-band fg-n" x={NCOL.agent - 8} y="8" width={NW - NCOL.agent} height={NH - 14} style="--p:0" />
  <path class="ln-thin fg-w" d={rulesW} style="--p:1" />
  <path class="ln-thin fg-n" d={rulesN} style="--p:1" />

  <g style="--p:3">
    {who.map((k) => (
      <g {...at([X0, laneTop[k] + 26], [NCOL[k], 24])}>
        <text class:list={['view__t', k === 'agent' && 'op-foil']}>{lane(k).label.toUpperCase()}</text>
        <text class="txt-note fg-w" x={Math.round(monoWidth(lane(k).label.toUpperCase(), 13, 0.14)) + 12}>{lane(k).sub}</text>
        <text class="txt-note fg-n" y="16">{lane(k).sub}</text>
      </g>
    ))}
    {cells.map((c, i) => <text {...at([colX(i) + 12, 32], [X0, bands[i] + 22], 'txt-label fg-h')}>{c.stage}</text>)}
  </g>

  <g style="--p:5">
    {cells.map((c, i) =>
      who.map((k) =>
        c[k].items.map((it) => (
          <g {...at([colX(i) + 24, laneTop[k] + 52 + it.dy], [NCOL[k] + 14, bands[i] + 46 + it.dy])}>
            <circle class={k === 'me' ? 'op-me' : 'op-ag'} cx="-11" cy="-4" r="3.2" />
            <text class="op-t">{it.t.map((t, j) => <tspan x="0" y={j ? j * LH : undefined}>{t}</tspan>)}</text>
          </g>
        )),
      ),
    )}
  </g>
</Figure>
