---
/*
  TD-LAB-02B · The R430, as built. One orthographic sheet: the TOP VIEW with the cover off above
  the FRONT, the REAR beside it, DETAIL B (the eight bays with their chassis numbers and the two
  drives), and the ZFS POOL, the controller and the memory as lettered blocks. Every number comes
  from src/data/lab/r430.ts; the faces are the cabinet's panel line work and the inside is
  schematic (./geom.ts). The page (src/pages/lab/r430.astro) wraps it in the page shell and the
  text equivalent.

  A part keeps its number in every view (NUM in ./geom.ts) and its card comes from the data.
*/
import '../../../styles/server-sheet.css';
import Sheet from '../Sheet.astro';
import View from '../View.astro';
import Part from '../Part.astro';
import Balloon from '../Balloon.astro';
import Dim from '../Dim.astro';
import Particles from '../Particles.astro';
import PartCard from '../PartCard.astro';
import Key from '../r730/Key.astro';
import { atScale, join } from '../../../lib/drawing/projection';
import { P, R, n, place, planAt } from '../r730/geom';
import { D, EAR, EAR_D, FRONT, H, NUM, REAR, REAR_OX, STAMP, W, WE, bayRect, bays, dimmBanks, drives, driveShort, part, planPaths, psuBoxes, rz } from './geom';
import { r430 } from '../../../data/lab/r430';
import type { Card } from '../../../data/lab/types';

const DWG = 'lab02b';
const title = (id: string): string => (/^cpu\d$/.test(id) ? `CPU ${id.slice(3)}` : (r430.internal.find((q) => q.id === id)?.card.title ?? id));

/* ---------- top, front and rear at 1:4 ---------- */
const s = atScale(1, 4);
const X0 = 74, YF = 600, YT = 668, XR = X0 + s * WE + 30 + s * EAR;
const top = planAt(X0, YF, s);
const pl = top.pt;
/** front face (u, v) → paper */
const fr = (u: number, v: number): [number, number] => [X0 + s * u, YT + s * v];
/** rear face (u from the body's left seen from behind, v) → paper */
const rr = (u: number, v: number): [number, number] => [XR + s * u, YT + s * v];
const plan = planPaths();

const bp = part('backplane'), fans = part('fans'), cpus = [part('cpu1'), part('cpu2')], bank = part('dimms');
const psuAll = { x: psuBoxes[1].x, z: psuBoxes[0].z, w: psuBoxes[0].x + psuBoxes[0].w - psuBoxes[1].x, d: psuBoxes[0].d };
// balloons: the left wall's parts down the left, the board's down the right, clear of the depth dimension
const LX = 50, RX = X0 + s * WE + 36;
const left = [
  { id: 'psus', y: pl(0, psuAll.z + psuAll.d * 0.82)[1], to: pl(psuAll.x + 8, psuAll.z + psuAll.d * 0.82) },
  { id: 'fans', y: pl(0, fans.z + fans.d / 2)[1] - 6, to: pl(fans.x + 8, fans.z + fans.d / 2) },
  { id: 'backplane', y: pl(0, bp.z)[1] + 22, to: pl(bp.x + 8, bp.z + bp.d / 2) },
];
const right = [
  { id: 'cpu2', y: pl(0, cpus[1].z + cpus[1].d * 0.72)[1], to: pl(cpus[1].x + cpus[1].w - 8, cpus[1].z + cpus[1].d * 0.6) },
  { id: 'dimms', y: pl(0, bank.z + bank.d)[1] + 18, to: pl(bank.x + bank.w - 4, bank.z + bank.d * 0.82) },
  { id: 'cpu1', y: pl(0, cpus[0].z + cpus[0].d * 0.3)[1], to: pl(cpus[0].x + cpus[0].w - 8, cpus[0].z + cpus[0].d * 0.4) },
];
const coldX = EAR + W * 0.5, hotX = EAR + W * 0.32;
const cold = P([pl(coldX, -46), pl(coldX, fans.z + fans.d)]);
const hot = P([pl(hotX, D * 0.62), pl(hotX, D + 14)]);

const labels = [
  { t: 'CPU 1', at: top.mid(cpus[0]) },
  { t: 'CPU 2', at: top.mid(cpus[1]) },
  { t: 'FANS', at: top.mid(fans), sm: true },
  { t: 'BACKPLANE', at: pl(EAR + W * 0.22, bp.z - 9), sm: true },
  { t: `${r430.memory.sockets} DIMM SOCKETS`, at: pl(EAR + W * 0.5, D * 0.86), sm: true },
  { t: `${r430.memory.dimms} FITTED`, at: pl(EAR + W * 0.5, D * 0.86 - 15), sm: true },
  { t: 'PSU 2', at: pl(psuBoxes[1].x + psuBoxes[1].w / 2, psuBoxes[1].z + psuBoxes[1].d * 0.55), sm: true },
  { t: 'PSU 1', at: pl(psuBoxes[0].x + psuBoxes[0].w / 2, psuBoxes[0].z + psuBoxes[0].d * 0.4), sm: true },
  { t: 'POWER', at: pl(EAR + W * 0.135, D * 0.5 + 8), sm: true },
  { t: 'BOARD', at: pl(EAR + W * 0.135, D * 0.5 - 8), sm: true },
];

/* front: the two drives in their bays */
const bayOnFront = (bay: number): string => {
  const q = bayRect(bay);
  return R(...fr(q.x + 0.6, q.y), s * (q.w - 1.2), s * q.h);
};

/* rear: the NICs and the PSUs */
const nicIds = ['nic-1', 'nic-2', 'nic-3', 'nic-4'];
const nicZ = nicIds.map(rz);
const nicHit = nicZ.map((q) => R(...rr(q.x - 1.5, q.y - 1.5), s * (q.w + 3), s * (q.h + 3))).join('');
const n1 = nicZ[0], n4 = nicZ[3];
const nicOut = rr(n1.x + n1.w / 2, n1.y);
const psu1 = rz('psu-1'), psu2 = rz('psu-2');
const psuHit = R(...rr(psu1.x, psu1.y), s * (psu2.x + psu2.w - psu1.x), s * psu1.h);
const up = r430.nics.uplink;

/* ---------- Detail B: the whole front at 1:2.5, every bay numbered ---------- */
const SB = atScale(1, 2.5);
const B = { x: 506, y: 196 };
const bb = (u: number, v: number): [number, number] => [B.x + SB * u, B.y + SB * v];
const detail = bays.map((b) => {
  const q = bayRect(b.n);
  const d = drives.find((x) => x.id === b.drive);
  const [x, y] = bb(q.x + 0.6, q.y);
  return { ...b, d, x, y, w: SB * (q.w - 1.2), h: SB * q.h, cx: x + (SB * (q.w - 1.2)) / 2 };
});
const held = detail.filter((b) => b.d);
const bracket = { a: Math.min(...held.map((b) => b.x)) + 2, b: Math.max(...held.map((b) => b.x + b.w)) - 2, y: B.y + SB * H + 10 };

/* ---------- the pool, the controller and the memory, lettered ---------- */
const T = { x: 520, y: 392, row: 18 };
const rows0 = T.y + 50;
const lastRow = rows0 + (drives.length - 1) * T.row;
const sticks = r430.memory.sticks.map((k) => `${k.count} × ${k.gb} GB`).join(' + ');
const blocks = [
  { id: 'perc', x: 770, head: r430.controller.name.replace('Dell ', ''), lines: [r430.controller.mode, 'EVERY DISK GOES', 'STRAIGHT TO ZFS'], w: 170 },
  { id: 'dimms', x: 990, head: `${r430.memory.gb} GB RAM`, lines: [sticks, `SOCKETS ${r430.memory.fitted.join(' ')}`, `${r430.memory.sockets - r430.memory.dimms} OF ${r430.memory.sockets} EMPTY`], w: 190 },
];

const cards: [string, Card][] = [
  ...r430.drives.map((d): [string, Card] => [d.id, d.card]),
  [r430.pool.id, r430.pool.card],
  ['server', r430.identity.card],
  ...r430.internal.map((p): [string, Card] => [p.id, p.card]),
];

const desc =
  `Dell PowerEdge R430 as built. Top view with the cover off: the eight-bay drive cage, the backplane, a row of fans, two CPUs with ${r430.memory.sockets} DIMM sockets (${r430.memory.dimms} fitted, in ${r430.memory.fitted.join(', ')}) and two power supplies at the rear left. ` +
  `Front and rear elevations. Detail B: the eight front bays with their numbers, ${r430.drives.map((d) => `a ${d.card.title} in bay ${d.bay}`).join(' and ')}, bays 2 to 7 empty. ` +
  `The ZFS pool rpool is a mirror of those two drives behind a ${r430.controller.name} in ${r430.controller.mode}. Each numbered part opens a card.`;
---

<Sheet
  id={DWG}
  dwgNo="TD-LAB-02B"
  title="The R430"
  desc={desc}
  sheet={[2, 3]}
  rev="A"
  date="2026-11-10"
  checked="TD"
  revisions={[{ rev: 'A', date: '2026-11-10', desc: 'First issue' }]}
  stamp={{ ...STAMP, x: 1046, y: 600 }}
  interactive
  hint
>
  <defs>
    <g id={`${DWG}-front`}>
      <path class="ln-obj" d={FRONT.obj} />
      <path class="ln-med" d={FRONT.med} />
      <path class="ln-thin" d={FRONT.thin} />
    </g>
    <g id={`${DWG}-rear`}>
      <path class="ln-obj" d={REAR.obj} />
      <path class="ln-med" d={REAR.med} />
      <path class="ln-thin" d={REAR.thin} />
    </g>
    <g id={`${DWG}-plan`}>
      <path class="ln-obj" d={join(plan.shell, plan.cpus)} />
      <path class="ln-med" d={join(plan.board, plan.psus)} />
      <path class="ln-thin" d={join(plan.cage, plan.fins, plan.sockets)} />
      <path class="sv-stick" d={plan.sticks} />
    </g>
  </defs>

  <!-- ================= DETAIL B: the bays ================= -->
  <View x={490} y={150} w={620} h={170} title="DETAIL B · THE BAYS" scale={SB} labelAt={[B.x + (SB * WE) / 2, 300]}>
    <path class="face-front" d={R(B.x, B.y, SB * WE, SB * H)} />
    <use href={`#${DWG}-front`} transform={place(SB, B.x, B.y)} />
    {detail.map((b) => b.d ? (
      <Part id={b.d.id} label={b.d.card.title} class={`pool-${b.d.pool}`}>
        <path class="sv-drv" d={R(b.x, b.y, b.w, b.h)} />
        <text class="sv-lt sv-ko" x={n(b.x + 22)} y={n(b.y + b.h / 2 + 3.2)}>{driveShort(b.d)}</text>
      </Part>
    ) : null)}
    <text class="sv-s" x={detail.map((b) => n(b.x + 11)).join(' ')} y={detail.map((b) => n(b.y + b.h / 2 + 3)).join(' ')}>{detail.map((b) => b.n).join('')}</text>
    {held.map((b) => <Balloon at={[b.cx, B.y - 26]} n={NUM[b.d!.id]} to={[b.cx, b.y + 5]} part={b.d!.id} />)}
    <g class={`pool-${r430.pool.id}`}>
      <path class="ln-obj" d={`M${n(bracket.a)} ${n(bracket.y)}v6H${n(bracket.b)}v-6`} />
      <text class="txt-label" x={n((bracket.a + bracket.b) / 2)} y={n(bracket.y + 22)} text-anchor="middle">{r430.pool.id}</text>
    </g>
  </View>

  <!-- ================= ZFS POOL, controller, memory ================= -->
  <View x={490} y={360} w={700} h={190} title="ZFS POOL" labelAt={[T.x + 96, lastRow + 62]}>
    <g class={`pool-${r430.pool.id}`}>
      <Part id={r430.pool.id} label={r430.pool.id}>
        <path class="dwg-hit" d={R(T.x - 12, T.y - 12, 190, 40)} />
        <text class="txt-label" x={T.x + 22} y={T.y + 4}>{r430.pool.id}</text>
        <text class="txt-note" x={T.x + 22} y={T.y + 17}>{r430.pool.copies}-WAY MIRROR</text>
      </Part>
      <Balloon at={[T.x, T.y]} n={NUM[r430.pool.id]} part={r430.pool.id} />
      <path class="ln-med" d={`M${T.x} ${T.y + 30}V${lastRow}` + drives.map((_, j) => `M${T.x} ${rows0 + j * T.row}h14`).join('')} />
      {drives.map((d, j) => {
        const ry = rows0 + j * T.row;
        return (
          <Part id={d.id} label={d.card.title}>
            <path class="dwg-hit" d={R(T.x + 16, ry - 9, 190, 18)} />
            <path class="sv-drv" d={R(T.x + 18, ry - 4.5, 12, 9)} />
            <text class="txt-note sv-row" x={T.x + 34} y={ry + 3.8}>BAY {d.bay} · {driveShort(d)}</text>
          </Part>
        );
      })}
      <text class="txt-note" x={T.x + 22} y={lastRow + 24}>{r430.pool.holds}</text>
    </g>
    {blocks.map((b) => (
      <>
        <Part id={b.id} label={title(b.id)}>
          <path class="dwg-hit" d={R(b.x - 12, T.y - 12, b.w, 20 + b.lines.length * 13 + 10)} />
          <text class="txt-label" x={b.x + 22} y={T.y + 4}>{b.head}</text>
          {b.lines.map((l, i) => <text class="txt-note" x={b.x + 22} y={T.y + 17 + i * 13}>{l}</text>)}
        </Part>
        <Balloon at={[b.x, T.y]} n={NUM[b.id]} part={b.id} />
      </>
    ))}
  </View>

  <!-- ================= TOP VIEW (cover off) ================= -->
  <View x={39} y={48} w={440} h={580} title="TOP VIEW · COVER OFF" scale={s} note="INSIDE IS SCHEMATIC" labelAt={[X0 + (s * WE) / 2, 66]}>
    <path class="face-top" d={top.box({ x: EAR, z: 0, w: W, d: D })} />
    <use href={`#${DWG}-plan`} transform={top.m} />
    {[
      { id: 'backplane', d: top.box(bp) },
      { id: 'fans', d: top.box(fans) },
      { id: 'cpu1', d: top.box(cpus[0]) },
      { id: 'cpu2', d: top.box(cpus[1]) },
      { id: 'dimms', d: dimmBanks.map(top.box).join('') },
      { id: 'psus', d: psuBoxes.map(top.box).join('') },
    ].map((p) => (
      <Part id={p.id} label={title(p.id)}>
        <path class="tint" d={p.d} />
        <path class="ln-obj" d={p.d} pathLength="1" />
      </Part>
    ))}
    {labels.map((l) => <text class:list={[l.sm ? 'sv-s' : 'sv-t', 'sv-ko']} x={n(l.at[0])} y={n(l.at[1] + 3.5)}>{l.t}</text>)}
    <Particles d={cold} kind="cold" n={2} dur={3} />
    <Particles d={hot} kind="hot" n={2} dur={3} />
    {left.map((b) => <Balloon at={[LX, b.y]} n={NUM[b.id]} to={b.to} part={b.id} />)}
    {right.map((b) => <Balloon at={[RX, b.y]} n={NUM[b.id]} to={b.to} part={b.id} />)}
    <Dim a={pl(EAR + W, 0)} b={pl(EAR + W, D)} offset={18} mm={D} />
  </View>

  <!-- ================= FRONT ================= -->
  <View x={39} y={640} w={420} h={212} title="FRONT" scale={s} labelAt={[X0 + (s * WE) / 2, 776]}>
    <path class="ln-cons" d={join(P([pl(0, -EAR_D), fr(0, -10)]), P([pl(WE, -EAR_D), fr(WE, -10)]))} />
    <Part id="server" label={r430.identity.name}>
      <path class="face-front" d={R(X0, YT, s * WE, s * H)} />
      <use href={`#${DWG}-front`} transform={place(s, X0, YT)} />
    </Part>
    {drives.map((d) => (
      <Part id={d.id} label={d.card.title} class={`pool-${d.pool}`}>
        <path class="sv-drv" d={bayOnFront(d.bay)} />
      </Part>
    ))}
    <text class="txt-label" x={X0} y={YT - 8}>B</text>
    <Balloon at={[X0 + s * WE + 22, YT - 16]} n={NUM.server} to={fr(WE - 8, 6)} part="server" />
    <Dim a={fr(0, H)} b={fr(WE, H)} offset={22} mm={WE} />
    <Dim a={fr(0, 0)} b={fr(0, H)} offset={-18} mm={H} sub="1U" />
  </View>

  <!-- ================= REAR ================= -->
  <View x={470} y={600} w={367} h={252} title="REAR" scale={s} labelAt={[XR + (s * W) / 2, 776]}>
    <path class="face-front" d={R(XR, YT, s * W, s * H)} />
    <path class="ln-thin" d={join(R(XR - s * EAR, YT, s * EAR, s * H), R(XR + s * W, YT, s * EAR, s * H))} />
    <use href={`#${DWG}-rear`} transform={place(s, XR - s * REAR_OX, YT)} />
    <Part id="nics" label={title('nics')}>
      <path class="dwg-hit" d={nicHit} />
      <path class="ln-med" d={nicHit} />
    </Part>
    <Part id="psus" label={title('psus')}>
      <path class="dwg-hit" d={psuHit} />
      <path class="ln-obj" d={psuHit} />
    </Part>
    <g class="net-1g">
      <path class="ln-net" d={P([nicOut, [nicOut[0], YT - 14]])} pathLength="1" />
      <text class="txt-note" x={nicOut[0] + 6} y={YT - 12}>{up.nic} → GATEWAY {up.port} · {up.speed}</text>
    </g>
    <g class="sv-s">
      <text x={n(rr(psu1.x + psu1.w / 2, 0)[0])} y={YT + s * H + 12}>PSU 1</text>
      <text x={n(rr(psu2.x + psu2.w / 2, 0)[0])} y={YT + s * H + 12}>PSU 2</text>
    </g>
    <Balloon at={[rr(n4.x + n4.w / 2, 0)[0], YT + s * H + 30]} n={NUM.nics} to={rr(n4.x + n4.w / 2, n4.y + n4.h - 3)} part="nics" />
    <Balloon at={[rr((psu1.x + psu1.w + psu2.x) / 2, 0)[0], YT + s * H + 36]} n={NUM.psus} to={rr((psu1.x + psu1.w + psu2.x) / 2, psu1.y + psu1.h - 4)} part="psus" />
  </View>

  <Fragment slot="cards">
    {cards.map(([id, c]) => <PartCard id={id} title={c.title} kind={c.kind} lines={c.lines} />)}
  </Fragment>

  <Fragment slot="legend">
    <Key items={[
      { line: 'obj', label: 'Object' },
      { line: 'pool-rpool', label: 'rpool' },
      { line: 'net-1g', label: '1 GbE' },
      { line: 'air-cold', label: 'Cold air' },
      { line: 'air-hot', label: 'Hot air' },
    ]} />
  </Fragment>
</Sheet>
