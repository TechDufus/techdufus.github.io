---
/*
  Sheet 01 · SIDE tab: SECTION A–A through the middle of the cabinet at 1:10, looking from the
  left with the front to the left: every box's depth against the rails and the enclosure, and
  airflow only for the boxes that pull it front to back. PLAN B–B at 1:15 shows the door swing.
*/
import View from '../View.astro';
import Part from '../Part.astro';
import Dim from '../Dim.astro';
import Balloon from '../Balloon.astro';
import Particles from '../Particles.astro';
import { atScale, fmtMm, join, ortho, type Pt } from '../../../lib/drawing/projection';
import { CAB, FRONT_TO_BACK, HOLES, el, free, slotOf$, slots, type Slot } from './model';

interface Props {
  dwg: string;
}
const { dwg } = Astro.props;

/* ---------- SECTION A–A, 1:10: model (z, y) → paper ---------- */
const FLOOR_Y = 766;
const S = ortho({ x: 156 - CAB.z0 * atScale(1, 10), y: FLOOR_Y + CAB.y0 * atScale(1, 10), scale: atScale(1, 10), flipY: true });
const skin = CAB.skin;
const zDoorIn = CAB.z0 + skin, zRearIn = CAB.z1 - skin;
// the cut: door, rear panel, roof and plinth are sectioned (hatched); the far side panel is behind
const cut = join(
  S.rect(CAB.z0, CAB.y0 + 40, skin, CAB.h - 40),
  S.rect(zRearIn, CAB.y0 + 40, skin, CAB.h - 40),
  S.rect(CAB.z0, CAB.y1 - skin, CAB.d, skin),
  S.rect(CAB.z0, CAB.y0 + 40, CAB.d, skin),
);
const plinth = join(S.rect(CAB.z0 + 20, CAB.y0, 60, 40), S.rect(CAB.z1 - 80, CAB.y0, 60, 40));
const rails = join(S.rect(-2, -10, 2, CAB.railTop + 20), S.rect(CAB.railSpan, -10, 2, CAB.railTop + 20));
const [gx0, gy] = S.pt(CAB.z0 - 60, CAB.y0);
const [gx1] = S.pt(CAB.z1 + 60, CAB.y0);
const ground = Array.from({ length: Math.floor((gx1 - gx0) / 9) }, (_, i) => `M${gx0 + i * 9 + 7} ${gy}l-7 7`).join('');

const r7 = slotOf$('r720xd');
/** A box's side profile, plus the R720xd's ears-and-carriers plate in front of it. */
const profile = (sl: Slot): string =>
  sl.dev.id === 'patch-cables'
    ? join(...[0, 1, 2].map((i) => {
        const [cx, cy] = S.pt(sl.body.z + sl.body.d / 2, sl.body.y + 5 + i * 9);
        return el(cx, cy, (sl.body.d / 2) * S.scale, 1.6);
      }))
    : join(S.rect(sl.body.z, sl.body.y, sl.body.d, sl.body.h), sl.plate ? S.rect(sl.plate.z, sl.faceTop - sl.plate.h, sl.plate.t, sl.plate.h) : '', sl.ears ? S.rect(sl.faceZ, sl.y0 + 0.4, 3, sl.hU - 0.8) : '');
// R720xd extras: the bezel in front of the carriers, the PSU handles behind the body
const bezel = S.rect(-32, r7.body.y + 4, 14, r7.body.h - 8);
const HANDLES_Z = 723;
const handles = S.rect(r7.body.z + r7.body.d, r7.body.y + 6, HANDLES_Z - r7.body.d, 26);

/* airflow: door to intake, exhaust to the rear panel */
const flow = FRONT_TO_BACK.map((id) => {
  const sl = slotOf$(id);
  const my = sl.body.y + sl.body.h / 2;
  const back = sl.dev.id === 'r720xd' ? HANDLES_Z + 8 : sl.body.z + sl.body.d + 6;
  return { cold: S.poly([[zDoorIn + 8, my], [sl.faceZ - 4, my]]), hot: S.poly([[back, my], [zRearIn - 8, my]]) };
});

/* depth labels on the boxes wide enough to hold one; balloons in a column behind the cabinet */
const tagged = ['r720xd', 'unas-pro-8'] as const;
const BX = 512;
let lastY = -Infinity;
const balloons = slots
  .map((sl) => ({ sl, to: (sl.dev.id === 'patch-cables' ? S.pt(sl.body.z + sl.body.d, sl.body.y + 10) : S.pt(sl.body.z + sl.body.d * (sl.on ? 0.3 + sl.body.x / 800 : 1) - 4, sl.body.y + sl.body.h * (sl.on ? 0.7 : 0.5))) as Pt }))
  .sort((a, b) => a.to[1] - b.to[1] || b.to[0] - a.to[0])
  .map((b) => ({ ...b, y: (lastY = Math.max(b.to[1] - 26, lastY + 29)) }));
const runs = free.filter((r) => r.n > 2);

/* ---------- PLAN B–B, 1:15: model (x, z) → paper, front at the bottom ---------- */
const P = ortho({ x: 676, y: 420, scale: atScale(1, 15), flipY: true });
const pCab = P.rect(CAB.x0, CAB.z0, CAB.w, CAB.d);
const pSkins = join(P.rect(CAB.x0, CAB.z0, CAB.w, skin), P.rect(CAB.x0, CAB.z1 - skin, CAB.w, skin), P.rect(CAB.x0, CAB.z0, skin, CAB.d), P.rect(CAB.x1 - skin, CAB.z0, skin, CAB.d));
const pPosts = join(...HOLES.flatMap((x) => [0, CAB.railSpan].map((z) => P.rect(x - 8, z - 8, 16, 16))));
const udm = slotOf$('udm-pro');
const pUdm = P.rect(udm.body.x, udm.body.z, udm.body.w, udm.body.d);
const pR7 = P.rect(r7.body.x, udm.body.z + udm.body.d, r7.body.w, r7.body.d - udm.body.d);
const doorOpen = P.rect(CAB.x0 - skin, CAB.z0 - CAB.w, skin, CAB.w);
const swing = (() => {
  const [hx, hy] = P.pt(CAB.x0, CAB.z0);
  const r = CAB.w * P.scale;
  return `M${hx + r} ${hy}A${r} ${r} 0 0 1 ${hx} ${hy + r}`;
})();
---

<View dwg={dwg} name="side" x={39} y={39} w={798} h={813}>
  <View x={46} y={110} w={500} h={740} title="SECTION A–A" scale={S.scale} note="LOOKING FROM THE LEFT" labelAt={[302, 800]}>
    <g style="--p:1">
      <path class="face" d={S.rect(CAB.z0, CAB.y0 + 40, CAB.d, CAB.h - 40)} />
      <path class="hatch" d={cut} />
      <path class="ln-obj" d={cut} pathLength="1" />
      <path class="ln-med" d={plinth} />
      <path class="ln-thin" d={rails} />
      <path class="ln-ctr" d={join(S.poly([[0, -60], [0, CAB.railTop + 60]]), S.poly([[CAB.railSpan, -60], [CAB.railSpan, CAB.railTop + 60]]))} style="--p:4" />
      <path class="ln-obj" d={`M${gx0} ${gy}H${gx1}`} pathLength="1" />
      <path class="ln-thin" d={ground} />
    </g>
    {runs.map((r) => {
      const [cx, cy] = S.pt(CAB.railSpan / 2, (r.y0 + r.y1) / 2);
      return <text class="txt-note" x={cx} y={cy + 4} text-anchor="middle">{r.n}U FREE</text>;
    })}

    <g>
      {slots.map((sl) => (
        <Part id={sl.dev.id} label={sl.dev.short} p={2}>
          <path class="face-front" d={profile(sl)} />
          <path class="ln-obj" d={profile(sl)} pathLength="1" />
        </Part>
      ))}
    </g>
    <path class="ln-phantom" d={bezel} />
    <path class="ln-med" d={handles} />
    {tagged.map((id) => {
      const sl = slotOf$(id);
      const [x, y] = S.pt(sl.body.z + sl.body.d / 2, sl.body.y + sl.body.h / 2);
      return <text class="txt-dim" x={x} y={y + 4.5} text-anchor="middle" style="pointer-events:none">{sl.dev.short.toUpperCase()} · {fmtMm(sl.body.d)}</text>;
    })}

    {flow.map((f) => (
      <>
        <Particles d={f.cold} kind="cold" n={2} dur={2.8} />
        <Particles d={f.hot} kind="hot" n={2} dur={2.8} />
      </>
    ))}

    <text class="txt-note" x={S.pt(zDoorIn + 12, 0)[0]} y={S.pt(0, CAB.railTop - 40)[1]}>FRONT</text>
    <text class="txt-note" x={S.pt(zRearIn - 12, 0)[0]} y={S.pt(0, CAB.railTop - 40)[1]} text-anchor="end">REAR</text>

    <Dim a={S.pt(CAB.z0, CAB.y1)} b={S.pt(CAB.z1, CAB.y1)} offset={-44} mm={CAB.d} />
    <Dim a={S.pt(0, CAB.y1)} b={S.pt(CAB.railSpan, CAB.y1)} offset={-14} mm={CAB.railSpan} sub="RAIL SPAN" ext="none" />
    <Dim a={S.pt(CAB.z0, CAB.y0)} b={S.pt(CAB.z0, CAB.y1)} offset={-30} mm={CAB.h} />
    <Dim a={S.pt(-32, r7.body.y)} b={S.pt(HANDLES_Z, r7.body.y)} offset={30} mm={HANDLES_Z + 32} sub="R720xd, BEZEL TO HANDLES" />

    {balloons.map(({ sl, to, y }) => <Balloon at={[BX, y]} n={sl.n} to={to} end="dot" part={sl.dev.id} />)}
  </View>

  <!-- ======== PLAN B–B: door swing ======== -->
  <View x={560} y={200} w={277} h={440} title="PLAN B–B" scale={P.scale} note="CUT AT U10 · DOOR SWING" labelAt={[724, 612]}>
    <g style="--p:1">
      <path class="face" d={pCab} />
      <path class="hatch" d={pSkins} />
      <path class="ln-obj" d={pCab} pathLength="1" />
      <path class="ln-med" d={pPosts} />
    </g>
    <g style="--p:2">
      <path class="face-top" d={pUdm} />
      <path class="ln-obj" d={pUdm} />
      <path class="ln-hid" d={pR7} />
    </g>
    <g style="--p:4">
      <path class="ln-phantom" d={join(doorOpen, swing)} />
      <path class="ln-ctr" d={P.poly([[241.3, CAB.z0 - 40], [241.3, CAB.z1 + 40]])} />
    </g>
    <text class="txt-note" x={P.pt(241.3, 0)[0]} y={P.pt(0, CAB.z0)[1] + 18} text-anchor="middle">FRONT</text>
    <Dim a={P.pt(CAB.x0, CAB.z1)} b={P.pt(CAB.x1, CAB.z1)} offset={-16} mm={CAB.w} />
  </View>
</View>
