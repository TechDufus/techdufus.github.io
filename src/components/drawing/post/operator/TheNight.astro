---
/*
  FIG 3 · Bare metal to monitoring: the night on one vertical time axis, by the owner's clock.
  Rows are evenly spaced, not to scale, and the night itself is a break in the axis. My moments
  are hollow marks, the agent's solid. Wide: mine on the left of the axis, the agent's on the
  right, each time next to the axis. Narrow (280 units): the axis at the left edge, each time over
  its moment. Each row is drawn once and moved (at()), its texts moving inside it; the axis, its marks and its points of light
  (the kit's Particles; none under reduced motion) are drawn per layout.
*/
import Figure from '../../figure/Figure.astro';
import Particles from '../../Particles.astro';
import { at, wrap } from '../../../../lib/drawing/figure';
import { theNight as D, type Moment } from './data';
import './operator.css';

const WRAP = 33, QWRAP = 26; // mono characters a line (≈ 242 units); quotes, italic serif
const LH = 16, QLH = 18, GAPH = 58;

/* x: wide axis 330, mine end at 240 (time ends 316), the agent's start 420 (time 344);
   narrow axis 12, time and moment at 28 */
const AX = 330, NAX = 12, NX = 28;

type Row = Moment & { y: number; ny: number; ne: number; t: string[]; lh: number };
let y = 50, ny = 44;
const rows: Row[][] = [];
const breaks: [number, number][] = [];
D.parts.forEach((part, i) => {
  if (i) {
    breaks.push([y - 6, ny - 6]);
    y += GAPH;
    ny += GAPH;
  }
  rows.push(
    part.map((m) => {
      const t = m.quote ? wrap(`“${m.event}”`, QWRAP) : wrap(m.event, WRAP);
      const lh = m.quote ? QLH : LH;
      const r = { ...m, y: y + 16, ny: ny + 14, ne: ny + 14 + lh + 3, t, lh };
      y += t.length * lh + 14;
      ny = r.ne + (t.length - 1) * lh + 14;
      return r;
    }),
  );
});
const H = y + 10, NH = ny + 6;
const all = rows.flat();

/* one axis per layout, local to x = 0, broken for the night, with a mark per moment */
const axis = (k: 'y' | 'ny', gaps: number[]) => {
  const segs = rows.map((p) => [p[0][k] - 14, p[p.length - 1][k] + 8] as const);
  const dot = (who: Moment['who']) => all.filter((r) => r.who === who).map((r) => `M-4 ${r[k] - 4}a4 4 0 1 0 8 0a4 4 0 1 0 -8 0`).join('');
  return {
    segs,
    line: segs.map(([a, b]) => `M0 ${a}V${b}`).join(''),
    brk: gaps.map((b) => `M-7 ${b + GAPH / 2 - 7}l14 -6M-7 ${b + GAPH / 2 + 1}l14 -6`).join(''),
    me: dot('me'),
    ag: dot('agent'),
  };
};
const axes = [
  { c: 'fg-w', x: AX, ...axis('y', breaks.map((b) => b[0])) },
  { c: 'fg-n', x: NAX, ...axis('ny', breaks.map((b) => b[1])) },
];

const say = (m: Moment): string => `${m.time}, ${m.who === 'me' ? 'me' : 'the agent'}: ${m.quote ? `“${m.event}”` : m.event}`;
const desc =
  `A timeline of the night, not to scale, with the night itself as a break in the axis; hollow marks are me, solid marks are the agent. ` +
  D.parts.map((p) => p.map(say).join('; ')).join(`; then ${D.gap}; `) + '.';
---

<Figure
  id="fig-night"
  fig={3}
  date="2026-09-29"
  title={D.title}
  desc={desc}
  caption={D.foot}
  size={[680, H]}
  narrow={[280, NH]}
  bp={680}
>
  {axes.map((a) => (
    <g class={a.c} transform={`translate(${a.x} 0)`}>
      <path class="ln-obj" d={a.line} pathLength="1" style="--p:1" />
      <path class="ln-med" d={a.brk} style="--p:2" />
      {a.segs.map(([p, q]) => <Particles d={`M0 ${p}V${q}`} kind="net10" n={2} dur={5.5} r={2} guide={false} p={3} />)}
      <path class="op-me" d={a.me} style="--p:4" />
      <path class="op-ag" d={a.ag} style="--p:4" />
    </g>
  ))}

  <g style="--p:5">
    <g {...at([226, 24], [NX, 20])}>
      <circle class="op-me" cx="-10" cy="-4" r="4" />
      <text class="txt-label fg-h">me</text>
    </g>
    <g {...at([430, 24], [96, 20])}>
      <circle class="op-ag" cx="-10" cy="-4" r="4" />
      <text class="txt-label fg-h">agent</text>
    </g>
    {breaks.map(([b, nb]) => <text {...at([AX - 20, b + GAPH / 2], [NX, nb + GAPH / 2], 'op-n fg-e fg-ns')}>{D.gap}</text>)}
    {all.map((r) => (
      <g {...at([0, r.y], [0, r.ny])}>
        <text {...at([r.who === 'me' ? AX - 14 : AX + 14, 0], [NX, 0], `op-time${r.who === 'me' ? ' fg-e fg-ns' : ''}`)}>{r.time}</text>
        <text {...at([r.who === 'me' ? 240 : 420, 0], [NX, r.ne - r.ny], `${r.quote ? 'op-q' : 'op-t op-new'}${r.who === 'me' ? ' fg-e fg-ns' : ''}`)}>
          {r.t.map((t, j) => <tspan x="0" y={j ? j * r.lh : undefined}>{t}</tspan>)}
        </text>
      </g>
    ))}
  </g>
</Figure>
