---
/*
  FIG 4 · Mirror sizes to scale: the three rpool members as bars from 0 GiB, the installer's 10%
  band drawn from the smallest member, and the SAS drive's overshoot dimensioned. Bars grow in.
  Both layouts use the same rows; only the GiB scale changes.
*/
import PostFigure from './PostFigure.astro';
import Dim from '../Dim.astro';
import ProvMark from '../ProvMark.astro';
import { r720xd } from '../../../data/hardware/r720xd';
import { at, drive, gib, glyphRun, rc, shortName, wLabel } from './fig';

const TOL = 0.1; // the Proxmox installer's mirror size tolerance (post copy, runbook)
const members = r720xd.pools.find((p) => p.id === 'rpool')!.members.map(drive);
const sizes = members.map(gib);
const lo = Math.min(...sizes), hi = Math.max(...sizes);
const limit = lo * (1 + TOL);
const over = Math.round((hi / lo - 1) * 100);
const AX = 300; // axis end, GiB

const L = {
  w: { x0: 20, s: 2.1, row: 50, top: 50, tick: 50 },
  n: { x0: 16, s: 1.16, row: 50, top: 60, tick: 100 },
};
type Lay = typeof L.w;
const X = (l: Lay, g: number): number => l.x0 + g * l.s;
const rowY = (l: Lay, i: number): number => l.top + i * l.row; // label baseline; bar below it
const bars = (l: Lay) => members.map((d, i) => ({ d, i, x1: X(l, sizes[i]), y: rowY(l, i) + 8, fits: sizes[i] <= limit }));
const axisY = (l: Lay): number => rowY(l, members.length) + 22;
const axis = (l: Lay): string =>
  `M${l.x0} ${axisY(l)}H${X(l, AX)}` + Array.from({ length: AX / 50 + 1 }, (_, k) => `M${X(l, k * 50)} ${axisY(l)}v5`).join('');
const band = (l: Lay): string => rc(X(l, lo), rowY(l, 0) - 14, (limit - lo) * l.s, rowY(l, members.length - 1) - rowY(l, 0) + 42);

const desc =
  `Bars to scale from 0 to ${AX} GiB: ` +
  members.map((d, i) => `${shortName(d)} about ${sizes[i]} GiB`).join(', ') +
  `. A band marks the installer's ${TOL * 100}% tolerance, from ${lo} to ${Math.round(limit * 10) / 10} GiB. Both Gigastones sit inside it; the SAS drive is about ${over}% larger and lands outside, so it joins the mirror after the install.`;
---

<PostFigure
  id="fig-sizes"
  n={4}
  title="Mirror members, to scale"
  desc={desc}
  caption="Two fit, one doesn't. The SAS drive waits outside and joins after the install."
  size={[680, 250]}
  narrow={[390, 262]}
  scale="TO SCALE"
  defs={['hatch']}
>
  {(['w', 'n'] as const).map((k) => {
    const l = L[k];
    return (
      <g class={k === 'w' ? 'pf-w' : 'pf-n'}>
        <path class="hatch ln-hid" d={band(l)} style="--p:4" />
        {bars(l).map((b) => (
          <path class="tint ln-med pool-rpool pf-grow" d={rc(l.x0, b.y, b.x1 - l.x0, 16)} style={`--p:${2 + b.i}`} />
        ))}
        <path class="ln-thin" d={axis(l)} style="--p:5" />
        {(() => {
          const run = glyphRun(Array.from({ length: AX / l.tick }, (_, i) => [X(l, i * l.tick), String(i * l.tick)]));
          return (
            <g style="--p:6">
              <text class="txt-note pf-c" x={run.x} y={axisY(l) + 18}>{run.t}</text>
              <text class="txt-note pf-e pf-nc" x={X(l, AX) + 10} y={axisY(l) + 18}>{AX} GiB</text>
            </g>
          );
        })()}
        <Dim a={[X(l, lo), bars(l)[2].y + 16]} b={[X(l, hi), bars(l)[2].y + 16]} offset={22} text={`+${over}%`} class="sem-removed" />
      </g>
    );
  })}

  <g style="--p:6">
    {bars(L.w).map((b) => {
      const nb = bars(L.n)[b.i];
      const name = shortName(b.d);
      return (
        <g {...at([L.w.x0, b.y - 8], [L.n.x0, nb.y - 8])}>
          <text class="txt-label">{name}</text>
          <text class="txt-dim" x={wLabel(name) + 12}>≈ {sizes[b.i]} GiB</text>
        </g>
      );
    })}
    <g {...at([X(L.w, limit), rowY(L.w, 0) - 22], [X(L.n, limit), rowY(L.n, 0) - 22])}>
      <text class="txt-note pf-e">installer's limit +{TOL * 100}%</text>
      <ProvMark x={4} y={-8.5} prov="vendor" />
    </g>
    <g class="sem-removed">
      <text {...at([X(L.w, lo) - 10, bars(L.w)[2].y + 42], [X(L.n, lo) - 10, bars(L.n)[2].y + 42], 'txt-label pf-e')}>installer says no</text>
    </g>
  </g>
</PostFigure>
