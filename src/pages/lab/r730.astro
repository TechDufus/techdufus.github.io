---
/*
  /lab/r730/: Sheet 02 · The server (TD-LAB-02), the Dell PowerEdge R730 that replaced the R720xd
  on 2026-10-02. Every number comes from src/data/lab/server.ts; the drawings live in
  src/components/drawing/r730/; the EXPLODED and R720xd → R730 panels load from /lab/r730/views/
  (r730/page.ts). Below the sheet: the machine at a glance and the pools, spares included (the
  text equivalent of the drives and pools on the drawing). The R720xd sheet it replaced is the
  frozen archive at /lab/r720xd/.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteMetadata } from '../../data/site';
import Sheet from '../../components/drawing/Sheet.astro';
import ViewTabs from '../../components/drawing/ViewTabs.astro';
import Key from '../../components/drawing/r730/Key.astro';
import R730Defs from '../../components/drawing/r730/R730Defs.astro';
import R730Cards from '../../components/drawing/r730/R730Cards.astro';
import OrthoViews from '../../components/drawing/r730/OrthoViews.astro';
import View from '../../components/drawing/View.astro';
import { derived, driveAt, server } from '../../data/lab/server';

const DWG = 'lab02';
const cpu = server.cpus[0];
const hotSpares = server.drives.filter((d) => d.role === 'spare' && d.pool).length;
const looseSpares = server.drives.filter((d) => d.role === 'spare' && !d.pool).length;
const glance = [
  { k: 'CPUs', v: `2 × ${cpu.model.replace('Intel Xeon ', '').replace('-', '\u2011').replace(' ', '\u00a0')}` },
  { k: 'Threads', v: String(server.threads) },
  { k: 'Memory', v: `${server.memory.gb} GB` },
  { k: 'Storage', v: `${derived.drives} drives in ${server.pools.length} ZFS pools` },
  { k: 'Spares', v: `${hotSpares} hot, ${looseSpares} in no pool` },
  { k: 'Controller', v: `${server.controller.name.replace('Dell ', '')}, ${server.controller.mode}` },
];
const words = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen'];
const cap = (w: string) => w[0].toUpperCase() + w.slice(1);
const quip = `${cap(words[derived.drives])} drives, ${words[server.pools.length]} pools, ${words[derived.baysFree]} empty bays. The bad ideas have to fit in fewer slots now.`;
const layout = (p: (typeof server.pools)[number]) => (p.layout === 'mirror' ? `${p.copies}-way mirror` : 'Single disk');
const spares = server.drives.filter((d) => !d.pool);
---

<BaseLayout
  title="The server · Sheet 02"
  description="Sheet 02 of my homelab drawings: the Dell PowerEdge R730 as built on 2026-10-02. Sixteen front bays, ten drives in three ZFS pools with a hot spare and two spares, and a PERC H730P Mini in HBA mode. Top, front and rear views, an exploded view, and how the drives moved over from the R720xd."
  ogImage={siteMetadata.media.labSocialImage}
  ogImageAlt={siteMetadata.media.labSocialImageAlt}
>
  <div class="pg-server">
    <section class="wrap srv-hero" aria-labelledby="srv-title">
      <p class="eyebrow srv-hero__eyebrow">Lab · Sheet 02</p>
      <h1 class="h1" id="srv-title">The <em>server</em>.</h1>
      <p class="lede srv-hero__lede">A Dell R730, in the R720xd’s old slot. Its RAID card does HBA mode on its own, so ZFS sees every disk and there was no surgery this time.</p>
      <p class="srv-hero__links">
        <a class="link" href="/lab/r720xd/">The R720xd it replaced <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link link--quiet" href="/lab/"><span aria-hidden="true">←</span> The lab</a>
        <a class="link link--quiet" href="/lab/rack/">Sheet 01 · The cabinet</a>
        <a class="link link--quiet" href="/lab/stack/">Sheet 03 · The stack <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </section>

    <div class="srv-wide" data-srv-views="/lab/r730/views/">
      <Sheet
        id={DWG}
        dwgNo="TD-LAB-02"
        title="The server"
        desc="Dell PowerEdge R730 as built. Orthographic tab: top view with the cover off, front elevation, rear elevation, detail B of front bays 0 to 9 with the ten drives (a hot spare in bay 0, two spares in bays 8 and 9), and the three ZFS pools with the spares. Exploded tab: the server taken apart, with the drives pulled out. R720xd to R730 tab: where each drive came from in the R720xd and where it sits now, with the four new SSDs."
        sheet={[2, 3]}
        rev="C"
        date="2026-10-03"
        checked="TD"
        revisions={[
          { rev: 'A', date: '2026-09-28', desc: 'First issue' },
          { rev: 'B', date: '2026-09-29', desc: 'As built' },
          { rev: 'C', date: '2026-10-03', desc: 'Redrawn for the R730' },
        ]}
        interactive
        hint
      >
        <Fragment slot="toolbar">
          <ViewTabs dwg={DWG} active="ortho" views={[
            { id: 'ortho', label: 'Orthographic', icon: 'front' },
            { id: 'exploded', label: 'Exploded', icon: 'iso' },
            { id: 'history', label: 'R720xd → R730', icon: 'top' },
          ]} />
        </Fragment>

        <R730Defs id={DWG} />
        <OrthoViews dwg={DWG} active />
        {/* filled from /lab/r730/views/ (ExplodedView, HistoryView) by r730/page.ts */}
        <View dwg={DWG} name="exploded" x={39} y={39} w={1182} h={813} />
        <View dwg={DWG} name="history" x={39} y={39} w={1182} h={813} />

        <Fragment slot="cards"><R730Cards /></Fragment>
        <Fragment slot="legend">
          <Key items={[
            { line: 'obj', label: 'Object' },
            { line: 'pool-rpool', label: 'rpool' },
            { line: 'pool-fast', label: 'fast' },
            { line: 'pool-bulk', label: 'bulk' },
            { line: 'spare-hot', label: 'Hot spare' },
            { line: 'spare-idle', label: 'Spare, no pool' },
            { line: 'sem-new', label: 'New to the lab' },
            { line: 'air-cold', label: 'Cold air' },
            { line: 'air-hot', label: 'Hot air' },
          ]} />
        </Fragment>
      </Sheet>
    </div>

    <section class="wrap srv-sec" aria-labelledby="srv-glance">
      <h2 class="srv-h" id="srv-glance">At a glance</h2>
      <dl class="srv-glance">
        {glance.map((g) => <div><dt>{g.k}</dt><dd>{g.v}</dd></div>)}
      </dl>
      <p class="srv-quip">{quip}</p>

      <h2 class="srv-h srv-h--pools" id="srv-pools">The pools</h2>
      <ul class="srv-pools" aria-labelledby="srv-pools">
        {server.pools.map((p) => (
          <li data-pool={p.id}>
            <p class="srv-pool__n">{p.id}</p>
            <p class="srv-pool__m">{layout(p)} · about {p.usableGiB} GiB</p>
            <p class="srv-pool__h">{p.holds}</p>
            <ul class="srv-pool__d">
              {p.bays.map((b) => <li><span>Bay {b}</span> {driveAt(b)?.card.title}</li>)}
              {p.spares.map((b) => <li><span>Bay {b}</span> {driveAt(b)?.card.title} · hot spare</li>)}
            </ul>
          </li>
        ))}
        {spares.length > 0 && (
          <li data-pool="none">
            <p class="srv-pool__n">No pool</p>
            <p class="srv-pool__m">Spares in the server</p>
            <p class="srv-pool__h">Wiped and waiting</p>
            <ul class="srv-pool__d">
              {spares.map((d) => <li><span>Bay {d.bay}</span> {d.card.title}</li>)}
            </ul>
          </li>
        )}
      </ul>

      <nav class="srv-next" aria-label="More drawings">
        <a class="link link--quiet" href="/lab/rack/"><span aria-hidden="true">←</span> Sheet 01 · The cabinet</a>
        <a class="link link--quiet" href="/lab/r720xd/">The R720xd sheet, archived</a>
        <a class="link link--quiet" href="/lab/stack/">Sheet 03 · The stack <span class="arrow" aria-hidden="true">→</span></a>
      </nav>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .pg-server .srv-hero { padding-block: clamp(40px, 6vw, 80px) clamp(28px, 4vw, 44px); }
  .pg-server .srv-hero__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 24px; }
  .pg-server .srv-hero__eyebrow::before { content: ""; width: 28px; height: 1px; background: var(--gold-line); }
  .pg-server .srv-hero__lede { margin-top: 20px; max-width: 46ch; }
  .pg-server .srv-hero__links { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 24px; font-size: var(--fs-sm); }
  .pg-server .srv-wide { max-width: 1400px; margin-inline: auto; padding-inline: var(--gutter); }

  /* exploded view: faint shroud; the static drawing is the exploded state */
  .pg-server .xp-see :is(.face-top, .face-front, .face-side) { fill-opacity: .35; }
  .pg-server .xp-wire .ln-med { stroke: var(--dwg-rule); }
  /* The drawing's box (outside its pan scroller) drives it: assembled when the page opens, apart
     as the drawing rises, balloons in before it's fully on screen, so the sheet at rest is always
     the whole picture. */
  @supports (animation-timeline: view()) {
    @media screen and (prefers-reduced-motion: no-preference) {
      .pg-server .dwg__view { view-timeline: --srv-xp block; }
      .pg-server .xp { animation: srv-xp linear both; animation-timeline: --srv-xp; animation-range: cover 25% cover 42%; }
      .pg-server .xp-lbl { animation: srv-fade linear both; animation-timeline: --srv-xp; animation-range: cover 40% cover 46%; }
    }
  }
  @keyframes srv-xp { from { transform: translate(var(--ax, 0px), var(--ay, 0px)); } }
  @keyframes srv-fade { from { opacity: 0; } }

  /* ---------- below the sheet ---------- */
  .pg-server .srv-sec { padding-block: clamp(48px, 6vw, 80px) clamp(64px, 8vw, 112px); }
  .pg-server .srv-h { margin: 0 0 18px; font: 500 .6875rem/1.2 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--gold-light); }
  .pg-server .srv-h--pools { margin-top: clamp(40px, 5vw, 64px); }
  .pg-server .srv-glance { display: flex; flex-wrap: wrap; margin: 0; border-block: 1px solid var(--line-2); }
  .pg-server .srv-glance > div { flex: 1 1 160px; padding: 18px 24px 18px 0; }
  .pg-server .srv-glance > div + div { padding-left: 24px; border-left: 1px solid var(--line); }
  .pg-server .srv-glance dt { font: 500 .6875rem/1.2 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: var(--faint); }
  .pg-server .srv-glance dd { margin: 8px 0 0; font: 400 1.125rem/1.3 var(--font-mono); color: var(--ink); letter-spacing: -.01em; }
  .pg-server .srv-quip { margin: 20px 0 0; font: italic 1.25rem/1.35 var(--font-display); color: var(--ink-2); }
  .pg-server [data-pool] { --pc: var(--line-3); }
  .pg-server [data-pool="rpool"] { --pc: var(--gold); }
  .pg-server [data-pool="fast"] { --pc: var(--ink); }
  .pg-server [data-pool="bulk"] { --pc: #8fa3c7; }
  .pg-server [data-pool="none"] { --pc: var(--faint); }
  .pg-server .srv-pools { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--line); border: 1px solid var(--line); }
  .pg-server .srv-pools > li { padding: 20px 22px 18px; background: var(--bg); box-shadow: inset 0 2px 0 var(--pc); }
  .pg-server .srv-pools p { margin: 0; }
  .pg-server .srv-pool__n { font: 500 1rem/1 var(--font-mono); color: var(--pc); letter-spacing: .02em; }
  .pg-server .srv-pool__m { margin-top: 10px !important; font: .75rem/1.5 var(--font-mono); letter-spacing: .04em; color: var(--muted); }
  .pg-server .srv-pool__h { margin-top: 12px !important; font: italic 1.2rem/1.25 var(--font-display); color: var(--ink); }
  .pg-server .srv-pool__d { display: grid; gap: 4px; margin: 14px 0 0; padding: 12px 0 0; list-style: none; border-top: 1px solid var(--line); font-size: var(--fs-sm); color: var(--ink-2); }
  .pg-server .srv-pool__d span { display: inline-block; min-width: 4.5em; font: .75rem var(--font-mono); color: var(--faint); }
  .pg-server .srv-next { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px 32px; margin: 48px 0 0; padding-top: 24px; border-top: 1px solid var(--line-2); }
  @media (max-width: 760px) {
    .pg-server .srv-pools { grid-template-columns: minmax(0, 1fr); }
    .pg-server .srv-glance > div { flex-basis: 45%; padding-left: 0 !important; border-left: 0 !important; }
  }
</style>

<script>
  import '../../components/drawing/r730/page';
</script>
