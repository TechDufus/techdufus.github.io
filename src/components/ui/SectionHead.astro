---
/*
  Section head: the section's title, with an optional lede and an optional aside (one fact about
  the section: a count, a status badge, a link). No number and no label above the title; the
  title is the label.
    <div class="sec-head [sec-head--split]">
      <h2 class="h2 sec-head__title" data-reveal>…<em>accent</em>.</h2>
      <div class="sec-head__side">                      (only with a lede or an aside)
        <p class="lede" data-reveal style="--d:1">…</p>
        <div class="sec-head__aside" data-reveal style="--d:1">…</div>
      </div>
    </div>
  `title` and `lede` are trusted HTML (use <em> for the one gold word).
  Aside: `aside` text renders as <span class="meta">, or pass a named slot "aside".
  Without a lede the aside sits on the title's baseline, at the far end of the row.
*/
interface Props {
  title: string;
  titleId?: string;
  lede?: string;
  aside?: string;
  /** 2-column head: title left, lede (and aside) right. Defaults to true when a lede is set. */
  split?: boolean;
  headingLevel?: 'h1' | 'h2';
  class?: string;
}

const { title, titleId, lede, aside, split, headingLevel: Heading = 'h2', class: className } = Astro.props;
const isSplit = split ?? Boolean(lede);
const hasAside = Boolean(aside) || Astro.slots.has('aside');
---
<div class:list={['sec-head', { 'sec-head--split': isSplit }, className]}>
  <Heading class="h2 sec-head__title" id={titleId} data-reveal="" set:html={title} />
  {
    (lede || hasAside) && (
      <div class="sec-head__side">
        {lede && <p class="lede" data-reveal style="--d:1" set:html={lede} />}
        {hasAside && (
          <div class="sec-head__aside" data-reveal style="--d:1">
            <slot name="aside">{aside && <span class="meta">{aside}</span>}</slot>
          </div>
        )}
      </div>
    )
  }
</div>
