---
/*
  FIG 1 · The storage path, before and after. Before: seven disks into the PERC (RAID, cache,
  battery), four virtual disks out, Proxmox on LVM-thin. After (the plan): six disks straight
  through the HBA330 into ZFS, three pools up to Proxmox. Data particles run the planned path.
  Wide: two rows. Narrow: two columns, flowing down.
*/
import PostFigure from './PostFigure.astro';
import ProvMark from '../ProvMark.astro';
import Stamp from '../Stamp.astro';
import Particles from '../Particles.astro';
import { r720xd } from '../../../data/hardware/r720xd';
import { at, cls, pl, poolOrder, POOL_CLASS, Pen, rc, type P } from './fig';
import { monoWidth } from '../../../lib/drawing/sheet';

const { before, after } = r720xd.controllers;
const drives = poolOrder(); // rpool ×3, fast ×2, bulk, then the failing drive
const kept = drives.filter((d) => d.fate === 'keep');
// "The OS sees four PERC virtual disks" (controllers.before.status.note, measured 2026-09-25).
const VDS = 4;
// Runbook §Now: "Proxmox VE 8.4 on a RAID1". The planned version comes from stage 8's title.
const PVE_BEFORE = 'Proxmox VE 8.4';
const PVE_AFTER = r720xd.stages.find((s) => s.n === 8)?.title.match(/Proxmox VE [\d.]+/)?.[0] ?? 'Proxmox VE';
const pools = r720xd.pools;

/* ---------- geometry ---------- */
const B1 = 170, B2 = 150, H = 64; // box widths / height
const cy = { a: 112, b: 282 }; // wide row centres
const cx = { a: 97, b: 293 }; // narrow column centres
const X = { d: 24, b1: 130, b2: 360, b3: 570, sees: 740 }; // wide x stations
const Y = { d: 62, b1: 140, b2: 244, b3: 348, sees: 440 }; // narrow y stations

type Row = 'a' | 'b';
const disksOf = (r: Row) => (r === 'a' ? drives : kept);
const off = (i: number, n: number, step: number): number => (i - (n - 1) / 2) * step;

// Wide: disks stacked at the left of each row
const wDisk = (r: Row) => disksOf(r).map((d, i) => ({ d, y: cy[r] + off(i, disksOf(r).length, 10) }));
// Narrow: disks in a row at the top of each column
const nDisk = (r: Row) => disksOf(r).map((d, i) => ({ d, x: cx[r] + off(i, disksOf(r).length, 10) }));

/* Lines, merged into one path per colour and layout (HTML budget). */
const wd = { a: wDisk('a'), b: wDisk('b') };
const nd = { a: nDisk('a'), b: nDisk('b') };
const poolY = pools.map((_, i) => cy.b + off(i, 3, 10));
const poolX = pools.map((_, i) => cx.b + off(i, 3, 10));
const pens = { w: new Pen(), n: new Pen() };
wd.a.forEach(({ d, y }, i) => {
  const ye = cy.a + off(i, 7, 6);
  pens.w.add(d.fate === 'remove' ? 'sem-removed' : '', rc(X.d, y - 3, 30, 6));
  pens.w.add('', pl([[X.d + 30, y], [78, y], [106, ye], [X.b1, ye]]));
});
nd.a.forEach(({ d, x }, i) => {
  const xe = cx.a + off(i, 7, 6);
  pens.n.add(d.fate === 'remove' ? 'sem-removed' : '', rc(x - 3, Y.d, 6, 26));
  pens.n.add('', pl([[x, Y.d + 26], [x, 104], [xe, 128], [xe, Y.b1]]));
});
wd.b.forEach(({ d, y }) => pens.w.add(cls(d), rc(X.d, y - 3, 30, 6) + `M${X.d + 30} ${y}H${X.b1}M${X.b1 + B1} ${y}H${X.b2}`));
nd.b.forEach(({ d, x }) => pens.n.add(cls(d), rc(x - 3, Y.d, 6, 26) + `M${x} ${Y.d + 26}V${Y.b1}M${x} ${Y.b1 + H}V${Y.b2}`));
pools.forEach((p, i) => {
  pens.w.add(POOL_CLASS[p.id], `M${X.b2 + B2} ${poolY[i]}H${X.b3}`);
  pens.n.add(POOL_CLASS[p.id], `M${poolX[i]} ${Y.b2 + H}V${Y.b3}`);
});
const vd = {
  w: Array.from({ length: VDS }, (_, i) => cy.a + off(i, VDS, 10)).map((y) => `M${X.b1 + B1} ${y}H${X.b2}M${X.b2 + B2} ${y}H${X.b3}`).join(''),
  n: Array.from({ length: VDS }, (_, i) => cx.a + off(i, VDS, 10)).map((x) => `M${x} ${Y.b1 + H}V${Y.b2}M${x} ${Y.b2 + H}V${Y.b3}`).join(''),
};
// Particles: one lane per pool, hidden inside the boxes (they are drawn on top)
const lanes = pools.map((p) => kept.findIndex((d) => d.pool === p.id));
const flow = {
  w: lanes.map((li, pi) => `M${X.d + 30} ${wd.b[li].y}H${X.b2 + B2 / 2}V${poolY[pi]}H${X.b3}`),
  n: lanes.map((li, pi) => `M${nd.b[li].x} ${Y.d + 26}V${Y.b2 + H / 2}H${poolX[pi]}V${Y.b3}`),
};

type Box = { w: number; lines: [string, ...string[]]; c?: string; dashed?: boolean };
const boxes: { id: string; wp: P; np: P; box: Box }[] = [
  { id: 'perc', wp: [X.b1, cy.a - H / 2], np: [cx.a - B1 / 2, Y.b1], box: { w: B1, c: 'sem-removed', lines: [before.name, 'RAID · cache · battery', 'comes out'] } },
  { id: 'vd', wp: [X.b2, cy.a - H / 2], np: [cx.a - B2 / 2, Y.b2], box: { w: B2, dashed: true, lines: ['Virtual disks', `× ${VDS}`] } },
  { id: 'pve8', wp: [X.b3, cy.a - H / 2], np: [cx.a - B2 / 2, Y.b3], box: { w: B2, lines: [PVE_BEFORE, 'on LVM-thin'] } },
  { id: 'hba', wp: [X.b1, cy.b - H / 2], np: [cx.b - B1 / 2, Y.b1], box: { w: B1, c: 'sem-new', lines: [after.id.toUpperCase(), 'pass-through', 'goes in'] } },
  { id: 'zfs', wp: [X.b2, cy.b - H / 2], np: [cx.b - B2 / 2, Y.b2], box: { w: B2, lines: ['ZFS', 'checksums, mirrors,', 'snapshots'] } },
  { id: 'pve9', wp: [X.b3, cy.b - H / 2], np: [cx.b - B2 / 2, Y.b3], box: { w: B2, lines: [PVE_AFTER, `${pools.length} pools on ZFS`] } },
];
const lineY = (n: number): number[] => (n === 3 ? [24, 40, 54] : [28, 46]);

const titles = [
  { t: 'Before', note: 'today', prov: 'measured' as const, asOf: before.status.asOf, wp: [X.d, cy.a - 66] as P, np: [cx.a - B1 / 2, 22] as P },
  { t: 'After', note: 'the plan', prov: 'owner' as const, asOf: after.status.asOf, wp: [X.d, cy.b - 66] as P, np: [cx.b - B1 / 2, 22] as P },
];
const sees = [
  { wp: [X.sees, cy.a - 4] as P, np: [cx.a - B2 / 2, Y.sees] as P, a: 'Proxmox sees', b: `${VDS} virtual disks` },
  { wp: [X.sees, cy.b - 4] as P, np: [cx.b - B2 / 2, Y.sees] as P, a: 'Proxmox will see', b: `${kept.length} real disks` },
];
const counts = [
  { wp: [X.d + 15, cy.a + 52] as P, np: [cx.a, 54] as P, t: `${drives.length} disks` },
  { wp: [X.d + 15, cy.b + 46] as P, np: [cx.b, 54] as P, t: `${kept.length} disks` },
];

const desc =
  `Before, measured: ${drives.length} disks into the ${before.name} (RAID, cache, battery), ${VDS} virtual disks up to ${PVE_BEFORE} on LVM-thin. ` +
  `After, planned: ${kept.length} disks straight through the ${after.id.toUpperCase()} into ZFS, ${pools.length} pools up to ${PVE_AFTER}.`;
---

<PostFigure
  id="fig-path"
  n={1}
  title="The storage path, before and after"
  desc={desc}
  caption="Same disks, minus one. The difference is who gets to see them."
  size={[900, 352]}
  narrow={[390, 530]}
  breakout
  defs={['rough']}
>
  {(['w', 'n'] as const).map((k) => (
    <g class={`pf-${k}`} style="--p:2">
      {pens[k].list.map(({ c, d }) => <path class:list={['ln-med', c]} d={d} pathLength="1" />)}
      <path class="ln-hid" d={vd[k]} />
      {flow[k].map((d, i) => <Particles d={d} kind="net10" n={2} dur={3.4} guide={false} r={2.2} class={POOL_CLASS[pools[i].id]} />)}
    </g>
  ))}

  <!-- boxes (drawn over the lanes, so the data disappears inside them) -->
  {boxes.map(({ wp, np, box }) => (
    <g {...at(wp, np, `${box.c ?? ''} pf-c`, '--p:1')}>
      <path class={box.dashed ? 'face ln-hid' : 'face ln-obj'} d={rc(0, 0, box.w, H)} pathLength={box.dashed ? undefined : '1'} />
      {box.lines.map((t, i) => (
        <text class={i ? 'txt-note' : 'txt-label'} x={box.w / 2} y={lineY(box.lines.length)[i]}>{t}</text>
      ))}
    </g>
  ))}

  <!-- lettering -->
  <g style="--p:6">
    {titles.map((t) => (
      <g {...at(t.wp, t.np)}>
        <text class="view__t">{t.t.toUpperCase()}</text>
        <text class="txt-note" y="17">{t.note}</text>
        <ProvMark x={monoWidth(t.note, 10.5, 0.06) + 6} y={8.5} prov={t.prov} asOf={t.asOf} />
      </g>
    ))}
    {counts.map((c) => <text {...at(c.wp, c.np, 'txt-note pf-c')}>{c.t}</text>)}
    {sees.map((s, i) => (
      <g {...at(s.wp, s.np, i ? 'sem-new' : '')}>
        <text class="txt-note">{s.a}</text>
        <text class="txt-label" y="17">{s.b}</text>
      </g>
    ))}
  </g>
  <g {...at([188, cy.b - 70], [cx.b, 498])}>
    <Stamp x={0} y={0} text="PLANNED" tone="ok" />
  </g>
</PostFigure>
