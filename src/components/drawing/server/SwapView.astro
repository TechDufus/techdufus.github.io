---
/*
  SwapView: Sheet 02's SWAP tab. The plan (cover off) rotated 90° so the storage path reads left
  to right, front to rear, with a Before/After switch:
    before  (as found) PERC H710P Mini in J_STORAGE, cable 1 from J_SASX8 to SAS A and SAS B
    after   (planned) HBA330 in riser 1 slot 2, new cables 2 and 3 drawn in, cable 1 and the
            PERC as removed phantoms; cables 4 and 5 kept
  and the data path strip under it. State lives on the figure: data-swap="before|after"; the
  switch buttons carry data-swap-to. The page script flips it and the page CSS shows
  .swap-b / .swap-a. Needs <ServerDefs id={dwg} /> in the same SVG.

  <SwapView dwg="lab02" />
*/
import View from '../View.astro';
import Stamp from '../Stamp.astro';
import DataPath from './DataPath.astro';
import { atScale, join } from '../../../lib/drawing/projection';
import { r720xd } from '../../../data/hardware/r720xd';
import { EAR, R, P, n, part, routes, type Box2 } from './geom';

interface Props {
  dwg: string;
  active?: boolean;
}
const { dwg, active = false } = Astro.props;

const s = atScale(1, 3.5);
const X0 = 117.4, Y0 = 128;
/** rotated plan: model (x, z) → paper (front at the left, the server's left side at the top) */
const rp = (x: number, z: number): [number, number] => [X0 + s * z, Y0 + s * x];
const box = (b: Box2) => R(X0 + s * b.z, Y0 + s * b.x, s * b.d, s * b.w);
const rt = routes();
const cable = (k: 1 | 2 | 3 | 4 | 5) => rt[k].map((p) => P(p.map(([x, z]) => rp(x, z)))).join('');

const perc = part('perc'), hba = part('hba330'), ports = [part('hba-port-1'), part('hba-port-2')];
const jsx = part('j-sasx8'), jst = part('j-storage'), flexA1 = part('flex-sas-a1');
const sas = ['sas-a1', 'sas-a', 'sas-b'].map(part);
const riser1 = part('riser-1');
const act = { remove: 'REMOVE', new: 'NEW', keep: 'KEEP' } as const;
const schedule = r720xd.cables.map((c) => ({
  n: c.n,
  cls: c.action === 'new' ? 'sem-new' : c.action === 'remove' ? 'sem-removed' : '',
  text: `${c.n}  ${c.n === 5 ? 'POWER, SIDEBAND, FRONT I/O: BOARD → BACKPLANES' : `${c.from.replace(/^System board |, (either|the other) port$/g, '')} → ${c.to}`.toUpperCase()}`,
  act: act[c.action],
}));
// the plan rotated: u = x → paper y, v = −z → paper −x
const planM = `matrix(0,${n(s)},${n(-s)},0,${n(X0)},${n(Y0)})`;
const lbl = (x: number, z: number, dx = 0, dy = 3.5) => {
  const [px, py] = rp(x, z);
  return { x: n(px + dx), y: n(py + dy) };
};
---

<View dwg={dwg} name="swap" active={active} x={39} y={39} w={798} h={813} title="SWAP · PLAN, ROTATED 90°" scale={s} note="INTERNALS APPROX. · LABELS ON THE PARTS WIN"
      labelAt={[438, 790]} mm={`matrix(0,${n(s)},${n(s)},0,${n(X0)},${n(Y0)})`}>
  <!-- the switch -->
  <g class="swt-row" style="--p:1">
    <text class="txt-note" x="62" y="66">CONFIGURATION</text>
    {[['before', 'BEFORE · AS FOUND'], ['after', 'AFTER · PLANNED']].map(([id, t], i) => (
      <g class="swt" role="button" tabindex="0" aria-pressed={i === 0 ? 'true' : 'false'} data-swap-to={id} aria-label={i ? 'Show after the swap (planned)' : 'Show before the swap (as found)'}>
        <rect x={62 + i * 182} y="74" width="172" height="28" />
        <text class="txt-label" x={148 + i * 182} y="92" text-anchor="middle">{t}</text>
      </g>
    ))}
  </g>

  <!-- plan -->
  <g data-layer="parts" style="--p:1">
    <path class="face-top" d={R(...rp(EAR, 0), s * 684, s * 444)} />
    <use href={`#${dwg}-plan`} transform={planM} />
  </g>
  <g data-layer="parts" class="swap-b" style="--p:2">
    <path class="ln-obj" d={box(perc)} pathLength="1" />
  </g>
  <g data-layer="parts" class="swap-a" style="--p:2">
    <g class="sem-removed"><path class="ln-phantom" d={box(perc)} /></g>
    <g class="sem-new swap-in">
      <path class="tint" d={box(hba)} />
      <path class="ln-obj" d={join(box(hba), ...ports.map(box))} pathLength="1" />
    </g>
  </g>

  <!-- cables -->
  <g class="cbls" data-layer="cables" style="--p:3">
    <path class="cbl" d={join(cable(4), cable(5))} />
    <g class="swap-b"><path class="cbl" d={cable(1)} /></g>
    <g class="swap-a">
      <g class="sem-removed"><path class="cbl" d={cable(1)} /></g>
      <g class="sem-new swap-in"><path class="cbl" d={join(cable(2), cable(3))} pathLength="1" /></g>
    </g>
    <g class="ctag">
      <text {...lbl(41.4, 300, 0, 4)}>4</text>
      <text {...lbl(93.3, 96, 0, 4)}>5</text>
      <text {...lbl(420.1, 300, 0, 4)} class="cb1">1</text>
      <g class="swap-a sem-new"><text {...lbl(430.8, 370, 0, 4)}>2</text><text {...lbl(439.7, 160, 0, 4)}>3</text></g>
    </g>
  </g>

  <!-- labels -->
  <g data-layer="labels" class="nt">
    {sas.map((c) => <text {...lbl(c.x + c.w / 2, 72, 0)} class="sm-l">{c.p.label}</text>)}
    <text {...lbl(flexA1.x + flexA1.w / 2, flexA1.z - 12)} class="sm-l">FLEX SAS A1</text>
    <text {...lbl(jsx.x + jsx.w / 2, jsx.z - 30)} class="sm-l">J_SASX8</text>
    <text {...lbl(jst.x + jst.w / 2, jst.z + 30)} class="sm-l" transform={`rotate(-90 ${rp(jst.x + jst.w / 2, jst.z + 30).join(' ')})`}>J_STORAGE</text>
    <text {...lbl(126 + 26, 289)}>CPU 1</text>
    <text {...lbl(296 + 26, 289)}>CPU 2</text>
    <text {...lbl(60, 610)}>PSU 2</text>
    <text {...lbl(121, 610)}>PSU 1</text>
    <text {...lbl(riser1.x + riser1.w - 10, 660, 0, 0)}>RISER 1</text>
    <text {...lbl(264, 640)}>RISER 2</text>
    <text {...lbl(186, 640)}>RISER 3</text>
    <text x="80" y={n(rp(241, 0)[1])} transform={`rotate(-90 80 ${n(rp(241, 0)[1])})`}>FRONT · 24 BAYS</text>
    <text x="772" y={n(rp(241, 0)[1])} transform={`rotate(90 772 ${n(rp(241, 0)[1])})`}>REAR</text>
    <g class="swap-b"><text {...lbl(perc.x + perc.w / 2, perc.z + perc.d / 2)} transform={`rotate(-90 ${rp(perc.x + perc.w / 2, perc.z + perc.d / 2).join(' ')})`}>PERC H710P MINI</text></g>
    <g class="swap-a">
      <text {...lbl(perc.x + perc.w / 2, perc.z + perc.d / 2)} class="sem-removed" transform={`rotate(-90 ${rp(perc.x + perc.w / 2, perc.z + perc.d / 2).join(' ')})`}>REMOVED</text>
      <text {...lbl(hba.x + hba.w / 2, hba.z + hba.d / 2, 0, -4)} class="sem-new">HBA330</text>
      <text {...lbl(hba.x + hba.w / 2, hba.z + hba.d / 2, 0, 10)} class="sem-new">SLOT 2 · PLANNED</text>
    </g>
  </g>

  <!-- data path -->
  <g data-layer="labels"><text class="txt-note" x="62" y="592">DATA PATH</text></g>
  <DataPath x={62} y={602} w={710} state="both" />

  <!-- cable schedule -->
  <g data-layer="cables" class="sched">
    <text class="txt-note" x="62" y="680">CABLES</text>
    {schedule.map((c, i) => (
      <g class={c.cls || undefined}>
        <path class="cbl" d={`M62 ${n(691 + i * 17)}h22`} />
        <text class="txt-label" x="94" y={n(695 + i * 17)}>{c.text}</text>
        <text class="txt-label" x="560" y={n(695 + i * 17)} text-anchor="end">{c.act}</text>
      </g>
    ))}
  </g>

  <g class="swap-a"><Stamp x={694} y={712} text="PLANNED" sub="NOT DONE YET" rotate={-4} /></g>
</View>
