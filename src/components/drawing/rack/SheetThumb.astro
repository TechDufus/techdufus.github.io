---
/*
  Tiny gold-ink thumbnails for the /lab "Drawn to spec" cards, generated from the same data as
  the sheets but with a fraction of the line work (no kit CSS needed, so the styles live here).
    kind="cabinet"  Sheet 01: the cabinet's front faces from U1 to U14 between two rails, the
                    empty U3–7 broken out
    kind="server"   Sheet 02: the R730's front face, 16 carriers in two groups of 8, the left control cluster and both ears
    kind="stack"    Sheet 03: the three layers as storeys, one box per thing, planned ones dashed
    kind="path"     the post: disks → PERC → virtual disks → Proxmox (red, dashed: gone) over
                    disks → HBA330 → ZFS pools → Proxmox (green: what went in)
    kind="lanes"    the operator post's FIG 5: two lanes across five stages, a stroke per line of
                    each item, mine (top, hollow marks) sparse and the agent's (bottom) dense
  Decorative: the card's text names the sheet, so the SVG is aria-hidden.
*/
import { HOLES, device, rr, slotOf$, yBot, yTop } from './model';
import { server } from '../../../data/lab/snapshots/server-2026-09-28';
import { stack } from '../../../data/lab/stack';
import { whoDidWhat } from '../post/operator/data';
import { wrap } from '../../../lib/drawing/figure';

interface Props {
  kind: 'cabinet' | 'server' | 'stack' | 'path' | 'lanes';
}
const { kind } = Astro.props;
const r1 = (n: number): string => String(Math.round(n * 10) / 10);

/** Evenly split a face into n vertical cells (carriers, bays) as one relative path. */
const cells = (x: number, y: number, w: number, h: number, n: number): string => {
  const cw = w / n;
  const one = `h${r1(cw - 1)}v${r1(h)}h${r1(1 - cw)}Z`;
  return `M${r1(x + 0.5)} ${r1(y)}${one}` + `m${r1(cw)} 0${one}`.repeat(n - 1);
};

/** A device's front-face zones (fractions) placed on a face at (x, y), `w` × `h`: the bay runs as carrier cells, and the rest as rectangles. */
const frontZones = (id: 'r730', x: number, y: number, w: number, h: number, only?: string[]): { cells: string; boxes: string } => {
  let c = '', b = '';
  for (const z of device(id).panels?.front?.zones ?? []) {
    const [zx, zy, zw, zh] = [x + z.x0 * w, y + z.y0 * h, (z.x1 - z.x0) * w, (z.y1 - z.y0) * h];
    if (z.kind === 'bay' && z.cells) c += cells(zx, zy, zw, zh, z.cells);
    else if (only?.includes(z.id)) b += rr(zx, zy, zw, zh);
  }
  return { cells: c, boxes: b };
};

let vb = '', obj = '', med = '', thin = '', hid = '', gone = '', add = '';
if (kind === 'cabinet') {
  // U1–2 (the top shelf) and U8–14, with U3–7 broken out: everything above the break drops by
  // the empty run less a short gap. Model y is up; the strip's top is paper y 0.
  const cut = yBot(2), resume = yTop(8), GAP = 26;
  const drop = cut - resume - GAP, top = yTop(1) - drop, lo = yBot(14);
  const Y = (y: number): number => top - (y >= cut ? y - drop : y);
  const H = top - lo;
  vb = `-24 -6 530.6 ${r1(H + 12)}`;
  const brk = Y(cut) + GAP / 2;
  // rails, each broken with a zig-zag across the gap
  for (const x of HOLES) {
    thin += rr(x - 8, 0, 16, Y(cut)) + rr(x - 8, Y(resume), 16, H - Y(resume));
    thin += `M${r1(x - 14)} ${r1(brk)}h8l3 -6l4 12l3 -6h8`;
  }
  for (const id of ['top-shelf', 'rpi-4b', 'ont', 'poe-injector', 'unas-pro-8', 'udm-pro', 'r730'] as const) {
    const s = slotOf$(id);
    if (id === 'top-shelf') {
      // the tray, and the two brackets
      obj += rr(s.body.x, Y(s.body.y + s.body.h), s.body.w, s.body.h);
      thin += rr(0, Y(s.faceTop), s.ears!.w, s.faceH) + rr(482.6 - s.ears!.w, Y(s.faceTop), s.ears!.w, s.faceH);
      continue;
    }
    const t = Y(s.faceTop);
    const x = s.plate ? s.plate.x : s.faceX;
    const w = s.plate ? s.plate.w : s.faceW;
    obj += rr(x, t, w, s.faceH);
    if (id === 'r730') med += frontZones(id, x, t, w, s.faceH).cells;
    if (id === 'unas-pro-8') med += cells(x + 5, t + 10, w - 10, s.faceH * 0.34, 4) + cells(x + 5, t + s.faceH * 0.54, w - 10, s.faceH * 0.34, 4);
    if (id === 'udm-pro') med += rr(x + 6, t + 10, 20, 24) + rr(x + 186, t + 8, 107, 29) + cells(x + 308, t + 9, 64, 26, 4) + rr(x + 386, t + 20, 20, 15);
    if (id === 'rpi-4b') med += rr(x + 4, t + 6, 14, s.faceH - 8) + rr(x + 42, t + 6, 16, s.faceH - 8);
    if (id === 'ont') med += `M${r1(x + w * 0.42)} ${r1(t + 5)}h${r1(w * 0.26)}` + cells(x + 8, t + 14, w - 16, s.faceH - 20, 10);
    if (id === 'poe-injector') med += rr(x + 8, t + 11, 20, 16) + rr(x + 32, t + 11, 20, 16);
  }
  // the ears of the two bracketed boxes
  for (const id of ['unas-pro-8', 'udm-pro'] as const) {
    const s = slotOf$(id);
    const t = Y(s.y0 + s.hU - 0.4);
    thin += rr(0, t, s.faceX, s.hU - 0.8) + rr(482.6 - s.faceX, t, s.faceX, s.hU - 0.8);
  }
} else if (kind === 'server') {
  const s = slotOf$('r730');
  const w = s.plate?.w ?? 482.4, h = s.faceH;
  const zs = device('r730').panels!.front!.zones;
  const earL = zs.find((z) => z.id === 'ear-l')!.x1 * w, earR = zs.find((z) => z.id === 'ear-r')!.x0 * w;
  const fz = frontZones('r730', 0, 0, w, h, ['power', 'sysid', 'vga', 'lcd', 'usb-1', 'usb-2', 'optical']);
  vb = `-6 -6 ${r1(w + 12)} ${r1(h + 12)}`;
  obj = rr(0, 0, w, h) + `M${r1(earL)} 0v${r1(h)}M${r1(earR)} 0v${r1(h)}`;
  med = fz.cells;
  thin = fz.boxes;
} else if (kind === 'stack') {
  // Storeys bottom up (layer 1 at the bottom), a box per item (an empty planned slot is one
  // dashed box), in up to two rows; a bracket on the left of each storey and the ground under it.
  const X0 = 40, W = 440, FH = 62, SLAB = 12, PAD = 10, G = 6;
  const floors = [...stack].reverse();
  const Hh = floors.length * (FH + SLAB);
  vb = `-6 -6 ${X0 + W + 12} ${Hh + 20}`;
  floors.forEach((l, i) => {
    const y = i * (FH + SLAB);
    obj += rr(X0, y, W, FH);
    thin += rr(X0, y + FH, W, SLAB - 4) + `M${X0 - 10} ${y + 6}h6v${FH - 12}h-6`;
    const boxes = l.groups.flatMap((g) => (g.items.length ? g.items.map((it) => it.status === 'planned') : [true]));
    const rows = boxes.length > 6 ? 2 : 1;
    const per = Math.ceil(boxes.length / rows);
    const bw = (W - 2 * PAD - G * (per - 1)) / per;
    const bh = (FH - 2 * PAD - G * (rows - 1)) / rows;
    boxes.forEach((planned, j) => {
      const b = rr(X0 + PAD + (j % per) * (bw + G), y + PAD + Math.floor(j / per) * (bh + G), bw, bh);
      if (planned) hid += b;
      else med += b;
    });
  });
  // ground line with short hatch strokes under the bottom storey
  thin += `M${X0 - 20} ${Hh}H${X0 + W + 6}` + Array.from({ length: 24 }, (_, i) => `M${X0 - 12 + i * 19} ${Hh}l-7 7`).join('');
} else if (kind === 'lanes') {
  // Five columns; per item a mark (a ring for me, a square for the agent) and one stroke per
  // wrapped line, its length from the line's length. Lane heights follow the fuller cell.
  const W = 480, CW = W / whoDidWhat.stages.length, PITCH = 9, GAP = 6, PAD = 12, WRAP = 19;
  const cell = (xs: string[]) => xs.map((x) => wrap(x, WRAP).map((l) => l.length));
  const height = (c: number[][]): number => c.reduce((s, it) => s + it.length * PITCH + GAP, -GAP);
  const lanes = (['me', 'agent'] as const).map((k) => whoDidWhat.stages.map((s) => cell(s[k])));
  let top = 0;
  lanes.forEach((cols, li) => {
    const h = PAD * 2 + Math.max(...cols.map(height));
    obj += rr(0, top, W, h);
    thin += cols.slice(1).map((_, i) => `M${r1((i + 1) * CW)} ${r1(top + 6)}v${r1(h - 12)}`).join('');
    cols.forEach((items, ci) => {
      let y = top + PAD + 3;
      for (const lines of items) {
        const x = ci * CW + 10;
        if (li === 0) thin += `M${r1(x + 3)} ${r1(y)}m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0`;
        else med += rr(x, y - 2.5, 5, 5);
        lines.forEach((n, j) => {
          const d = `M${r1(x + 12)} ${r1(y + j * PITCH)}h${r1((n / WRAP) * (CW - 30))}`;
          if (li === 0) med += d;
          else obj += d;
        });
        y += lines.length * PITCH + GAP;
      }
    });
    top += h + 8;
  });
  vb = `-6 -6 ${W + 12} ${r1(top - 8 + 12)}`;
} else {
  // Two rows, as the post's FIG 1: every drive before (the pulled SAS drive included), the kept
  // ones after; 4 virtual disks (the OS's view before) against one line per pool.
  const kept = server.drives.length, all = kept + 1;
  const H = 60, BW = 90, X = [70, 200, 330], rows = [36, 146];
  vb = `-6 -6 ${X[2] + BW + 12} ${rows[1] + H / 2 + 12}`;
  const disks = (y: number, n: number): string =>
    Array.from({ length: n }, (_, i) => {
      const dy = (i - (n - 1) / 2) * 8.5;
      return rr(0, y + dy - 2.5, 24, 5) + `M24 ${r1(y + dy)}L${X[0]} ${r1(y + dy * 0.7)}`;
    }).join('');
  const wires = (x0: number, y: number, n: number): string =>
    Array.from({ length: n }, (_, i) => `M${x0 + BW} ${r1(y + (i - (n - 1) / 2) * 7)}H${x0 + 130}`).join('');
  const [a, b] = rows;
  thin = disks(a, all) + disks(b, kept);
  hid = wires(X[0], a, 4) + wires(X[1], a, 4) + rr(X[1], a - H / 2, BW, H);
  gone = rr(X[0], a - H / 2, BW, H);
  add = rr(X[0], b - H / 2, BW, H);
  med = wires(X[0], b, kept) + wires(X[1], b, server.pools.length);
  obj = rr(X[2], a - H / 2, BW, H) + rr(X[1], b - H / 2, BW, H) + rr(X[2], b - H / 2, BW, H);
}
---

<svg class="dts-thumb" viewBox={vb} aria-hidden="true" preserveAspectRatio="xMidYMid meet">
  <path class="dts-thumb__thin" d={thin} />
  {hid && <path class="dts-thumb__thin dts-thumb__hid" d={hid} />}
  <path class="dts-thumb__med" d={med} />
  <path class="dts-thumb__obj" d={obj} />
  {gone && <path class="dts-thumb__obj dts-thumb__gone" d={gone} />}
  {add && <path class="dts-thumb__obj dts-thumb__add" d={add} />}
</svg>

<style is:global>
  .dts-thumb { display: block; width: 100%; height: 100%; overflow: visible; }
  .dts-thumb path { fill: none; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .dts-thumb__obj { stroke: var(--gold-light); stroke-width: 1.3px; }
  .dts-thumb__med { stroke: color-mix(in srgb, var(--gold) 80%, transparent); stroke-width: 0.75px; }
  .dts-thumb__thin { stroke: color-mix(in srgb, var(--gold) 34%, transparent); stroke-width: 0.6px; }
  .dts-thumb .dts-thumb__hid { stroke: color-mix(in srgb, var(--gold) 60%, transparent); stroke-dasharray: 4 3; }
  .dts-thumb .dts-thumb__gone { stroke: var(--danger-ink); stroke-dasharray: 5 3; }
  .dts-thumb .dts-thumb__add { stroke: var(--ok); }
</style>
