---
/*
  Stamp: a rubber stamp ("PRELIMINARY / NOT FOR CONSTRUCTION"): double border, inked texture
  (#{id}-rough via var(--dwg-rough)), set down with a small "thunk" once the plot finishes.
  Sheet.astro renders one from its `stamp` prop; use this directly for extra stamps.

  <Stamp x={cx} y={cy} text="PRELIMINARY" sub="NOT FOR CONSTRUCTION" />

    x, y     centre (paper units)
    text     main line, sub = second smaller line
    rotate   degrees (default −6)
    tone     'warn' (default, rubber-stamp red = --dwg-stamp: "PRELIMINARY") | 'ok' (green:
             "AS BUILT") | 'wip' (amber: "IN PROGRESS")
    p        plot order (default 7: last)
*/
import { monoWidth } from '../../lib/drawing/sheet';

interface Props {
  x: number;
  y: number;
  text: string;
  sub?: string;
  rotate?: number;
  tone?: 'warn' | 'ok' | 'wip';
  p?: number;
}
const { x, y, text, sub, rotate = -6, tone = 'warn', p = 7 } = Astro.props;
const f = (v: number): string => String(Math.round(v * 10) / 10);
const FS = 24, SUB = 9.5;
const w = Math.max(monoWidth(text, FS, 0.16), sub ? monoWidth(sub, SUB, 0.22) : 0) + 36;
const h = sub ? 58 : 42;
---

<g class={`stamp stamp--${tone}`} style={`--p:${p}`} transform={`translate(${f(x)} ${f(y)}) rotate(${rotate})`}>
  <g class="stamp__ink">
    <rect class="stamp__b1" x={f(-w / 2)} y={f(-h / 2)} width={f(w)} height={h} rx="3" />
    <rect class="stamp__b2" x={f(-w / 2 + 4)} y={f(-h / 2 + 4)} width={f(w - 8)} height={h - 8} rx="1.5" />
    <text class="stamp__t" y={sub ? -1 : 8.5} text-anchor="middle">{text}</text>
    {sub && <text class="stamp__s" y="17" text-anchor="middle">{sub}</text>}
  </g>
</g>
