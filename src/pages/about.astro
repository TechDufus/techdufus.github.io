---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Portrait from '../components/ui/Portrait.astro';
import ProofPoints from '../components/ui/ProofPoints.astro';
import Timeline, { type TimelineItem } from '../components/ui/Timeline.astro';
import Principles from '../components/ui/Principles.astro';
import { aboutCopy, aboutNow, featuredProject, homeOperatingStyle, profileSpotlight, siteMetadata } from '../data/site';

// The body copy carries the old Tailwind link classes; render its links with the Studio `.link` style.
const bodyParagraphs = aboutCopy.body.map((paragraph) => paragraph.replace(/class="[^"]*"/g, 'class="link"'));

// The path by focus area, not employer or year. `when` carries the transition: why I switched.
const toolkit = (name: string) => `<a href="https://github.com/TechDufus/${name}" target="_blank" rel="noopener noreferrer" class="link">${name}</a>`;
const path: TimelineItem[] = [
  { when: 'Where it started', what: 'PowerShell automation', bodyHtml: `Got bit by the automation bug in a heavily regulated shop. Built ${toolkit('AdminToolkit')} and ${toolkit('HelpDesk')}, stopped clicking through runbooks, and picked up Security+.` },
  { when: 'Wanted the whole pipeline', what: 'DevOps', body: 'Scripts only covered my corner. I wanted to see how software actually ships, so I moved into DevOps: Terraform on Azure, CI/CD, PKI automation that went from hours to seconds. CISSP along the way.' },
  { when: 'Wanted the app side too', what: 'Full-stack', body: 'I wanted to understand the apps I was deploying, so I joined a team that owned everything from app code to firewalls. Go services, Helm on GKE. Learned to care about the people using what I build.' },
  { when: 'Wanted the platform underneath', what: 'Platform engineering', body: 'Big Kubernetes clusters, RBAC at scale, GitOps with ArgoCD, air-gapped environments, Ansible across whole fleets. Fast only counts if you can roll it back.' },
  { when: 'Now', what: 'AI everything engineer', whatNote: 'Team lead, solutions architect', now: true, bodyHtml: `AI means one person can finally work across the whole stack, so I do: infra, code, and the agents that write it. I lead a team now, and most of that job is mentoring and training people to use AI well. I'm also building <a href="${featuredProject.href}" target="_blank" rel="noopener noreferrer" class="link">${featuredProject.name}</a>, an AI Bible-study tool, on the side.` }
];
---

<BaseLayout title="About" description={aboutCopy.intro}>
  <div class="pg-about">
  <!-- ============ Hero ============ -->
  <section class="hero" aria-labelledby="page-title">
    <div class="wrap hero__grid">
      <div>
        <div class="hero__id">
          <Portrait size="avatar" loading="eager" />
          <div>
            <p class="serif">{profileSpotlight.nickname}</p>
            <p class="meta">{siteMetadata.role}</p>
          </div>
        </div>
        <p class="eyebrow hero__eyebrow" data-reveal>About</p>
        <h1 class="display" id="page-title" data-reveal style="--d:1">Hello, I'm <em>TechDufus</em>.</h1>
        <p class="lede hero__lede" data-reveal style="--d:2">{aboutCopy.intro}</p>
        <div class="hero__ctas" data-reveal style="--d:3">
          <a class="btn btn--primary btn--lg" href="/contact/">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost btn--lg" href="https://github.com/TechDufus" target="_blank" rel="noopener">GitHub <span class="arrow--ne" aria-hidden="true">↗</span></a>
        </div>
        <p class="meta hero__status" data-reveal style="--d:3"><span class="dot" aria-hidden="true"></span>{profileSpotlight.status}</p>
      </div>
      <Portrait size="hero" />
    </div>
  </section>

  <!-- ============ 01 · Backstory ============ -->
  <section id="story" class="section" aria-labelledby="story-title">
    <div class="wrap">
      <SectionHead index={1} label="Backstory" bare />
      <div class="about__bio">
        <h2 class="h2 sec-head__title" id="story-title" data-reveal>How I got <em>here</em>.</h2>
        {bodyParagraphs.map((paragraph, i) => <p class:list={{ first: i === 0 }} data-reveal set:html={paragraph} />)}
        <Timeline items={path} class="about__path" reveal d={1} />
        <div class="about__quote" data-reveal>
          <p class="quote">{homeOperatingStyle[0]}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 02 · Now ============ -->
  <section id="now" class="section" aria-labelledby="now-title">
    <div class="wrap">
      <SectionHead index={2} label="Now" aside={aboutNow.timeframe} titleId="now-title" title="Right <em>now</em>." lede={aboutNow.primaryFocus} />
    </div>
  </section>

  <!-- ============ 03 · Proof ============ -->
  <section id="proof" class="section" aria-labelledby="proof-title">
    <div class="wrap">
      <SectionHead index={3} label="Proof" titleId="proof-title" title="Proof." />
      <ProofPoints />
    </div>
  </section>

  <!-- ============ 04 · Principles ============ -->
  <section id="operate" class="section" aria-labelledby="operate-title">
    <div class="wrap">
      <SectionHead index={4} label="Principles" titleId="operate-title" title="How I <em>work</em>." />
      <div class="principles">
        <Principles heading="" />
      </div>
    </div>
  </section>

  <!-- ============ Say hey ============ -->
  <section class="section section--tight" aria-labelledby="hey-title">
    <div class="wrap hey" data-reveal>
      <div>
        <h2 class="h2" id="hey-title">Say <em>hey</em>!</h2>
        <p class="lede">Seriously, please talk to me.</p>
      </div>
      <a class="btn btn--primary btn--lg" href="/contact/">Open the contact page <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
  </div>
</BaseLayout>

<style is:global>
  /* Global under the .pg-about root (no data-astro-cid attributes).
     Hero (mockup index.html .hero; the figure + ring styles live in Portrait.astro) */
  .pg-about .hero { padding-block: clamp(40px, 7vw, 104px) clamp(56px, 7vw, 96px); }
  .pg-about .hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  .pg-about .hero__id { display: none; }
  .pg-about .hero__eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
  .pg-about .hero__eyebrow::before { content: ""; width: 28px; height: 1px; background: var(--gold-line); }
  .pg-about .hero .display { max-width: 13ch; }
  .pg-about .hero__lede { margin-top: 28px; color: var(--ink-2); }
  .pg-about .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .pg-about .hero__status { display: inline-flex; align-items: center; gap: 8px; margin-top: 22px; }
  .pg-about .hero__status .dot { background: var(--ok); }
  @media (max-width: 960px) {
    .pg-about .hero__grid { grid-template-columns: minmax(0, 1fr); }
    .pg-about .hero__id { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
    .pg-about .hero__id .portrait { width: 72px; height: 72px; flex: none; }
    .pg-about .hero__id p { line-height: 1.35; }
    .pg-about .hero__id .serif { font-size: 1.375rem; font-style: italic; }
    .pg-about .hero__id .meta { color: var(--muted); }
    .pg-about .hero__eyebrow { margin-bottom: 18px; }
  }
  @media (max-width: 640px) {
    .pg-about .hero__ctas .btn { width: 100%; }
    .pg-about .hero .display { font-size: clamp(2.5rem, 11.4vw, 3.25rem); }
  }

  /* Backstory (mockup #about) */
  .pg-about .about__bio > .sec-head__title { margin-bottom: 32px; }
  .pg-about .about__bio > p + p { margin-top: 1.1em; }
  .pg-about .about__bio > p { color: var(--ink-2); font-size: 1.0625rem; max-width: 60ch; }
  .pg-about .about__bio .first { font-size: var(--fs-md); color: var(--ink); }
  .pg-about .about__quote { margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--line); }

  /* The path (eras by focus area) */
  .pg-about .about__path { margin-top: 36px; max-width: 64ch; }
  .pg-about .about__path .timeline__what { font-family: var(--font-display); font-size: 1.5rem; font-weight: 400; line-height: 1.2; }
  .pg-about .about__path .timeline__what span { font-family: var(--font-sans); font-size: 0.95rem; }
  .pg-about .about__path .timeline__item { padding-bottom: 32px; }
  .pg-about .about__path .timeline__item:last-child { padding-bottom: 0; }
  .pg-about .about__path .timeline__item::before { top: 6px; }
  .pg-about .about__path .timeline__item p { color: var(--ink-2); font-size: 1rem; }

  /* Proof and principles sit right under the section title */
  .pg-about #proof .proof { margin-top: 0; }

  .pg-about .principles .operate__h { margin-top: 0; }

  .pg-about .hey { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 24px 40px; }
  .pg-about .hey .lede { margin-top: 12px; }
</style>
