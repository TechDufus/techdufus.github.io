---
/*
  SheetLink: the card at the end of a post that points to a lab sheet, with a tiny drawing.
    sheet="server"  (default) Sheet 02 (TD-LAB-02): a front elevation of the R720xd drawn from
                    its dimensions and bay count
    sheet="stack"   Sheet 03 (TD-LAB-03): the three layers as storeys, a box per thing, planned
                    ones dashed (from src/data/lab/stack.ts); title, note and link from labSpec
*/
import { device } from '../../../data/lab/rack';
import { server } from '../../../data/lab/server';
import { stack } from '../../../data/lab/stack';
import { labSpec } from '../../../data/site';
import { f } from '../../../lib/drawing/figure';

interface Props {
  sheet?: 'server' | 'stack';
}
const { sheet = 'server' } = Astro.props;

let href: string, meta: string, title: string, desc: string, go: string;
let H: number, outline: string, bays: string, hid = '';
if (sheet === 'stack') {
  const s = labSpec.drawings.sheets.find((x) => x.no === 'TD-LAB-03');
  if (!s) throw new Error('SheetLink: labSpec has no TD-LAB-03 sheet');
  ({ href, title } = s);
  // No Rev here: Sheet 03 is still going up, and its REV lives in StackSheet.astro.
  meta = 'TD-LAB-03 · Sheet 3 of 3 · Checked TD';
  desc = s.note;
  go = 'Open Sheet 03';

  /* thumbnail: the layers as storeys, top layer on top, fitted to 150 units wide */
  const X = 5, Y = 8, W = 150, FH = 16, SLAB = 4, PAD = 3, G = 2;
  H = stack.length * (FH + SLAB);
  outline = `M${X - 3} ${Y + H}H${X + W + 3}`;
  bays = '';
  [...stack].reverse().forEach((l, i) => {
    const y = Y + i * (FH + SLAB);
    outline += `M${X} ${y}h${W}v${FH}h${-W}Z`;
    const cells = l.groups.flatMap((g) => (g.items.length ? g.items.map((it) => it.status === 'planned') : [true]));
    const rows = cells.length > 6 ? 2 : 1;
    const per = Math.ceil(cells.length / rows);
    const bw = (W - 2 * PAD - G * (per - 1)) / per;
    const bh = (FH - 2 * PAD - G * (rows - 1)) / rows;
    cells.forEach((planned, j) => {
      const d = `M${f(X + PAD + (j % per) * (bw + G))} ${f(y + PAD + Math.floor(j / per) * (bh + G))}h${f(bw)}v${f(bh)}h${f(-bw)}Z`;
      if (planned) hid += d;
      else bays += d;
    });
  });
} else {
  href = device('r720xd').sheetHref ?? '/lab/r720xd/';
  const { before, now } = server.controller;
  const { body, earsWidth } = server.dims;
  meta = 'TD-LAB-02 · Sheet 2 of 3 · Rev B · Checked TD';
  title = 'The server';
  desc = `The R720xd inside and out, after the ${before.name} → ${now.id.toUpperCase()} swap.`;
  go = 'Open Sheet 02';

  /* thumbnail: front elevation, ears included, fitted to 150 units wide */
  const k = 150 / earsWidth;
  const W = earsWidth * k, ear = ((earsWidth - body.w) / 2) * k;
  const X = 5, Y = 8;
  H = body.h * k;
  const n = server.bays.front;
  const bayW = (W - 2 * ear - 4) / n;
  bays = Array.from({ length: n + 1 }, (_, i) => `M${f(X + ear + 2 + i * bayW)} ${f(Y + 3)}v${f(H - 6)}`).join('');
  outline = `M${X} ${Y}h${f(W)}v${f(H)}h${f(-W)}Z M${f(X + ear)} ${Y}v${f(H)}M${f(X + W - ear)} ${Y}v${f(H)}`;
}
---

<a class="pf-card" href={href}>
  <svg class="pf-card__th" viewBox={`0 0 160 ${f(H + 16)}`} aria-hidden="true" focusable="false">
    <path class="pf-card__o" d={outline} />
    <path class="pf-card__b" d={bays} />{hid && <path class="pf-card__b" d={hid} stroke-dasharray="3 2" />}
  </svg>
  <span class="pf-card__txt">
    <span class="pf-card__meta">{meta}</span>
    <span class="pf-card__t">{title}</span>
    <span class="pf-card__d">{desc}</span>
    <span class="pf-card__go">{go} <span class="arrow" aria-hidden="true">→</span></span>
  </span>
</a>

<style is:global>
  .prose .pf-card {
    display: grid; grid-template-columns: minmax(120px, 34%) minmax(0, 1fr); gap: 0; margin-block: 2em;
    border: 1px solid var(--line-2); background: var(--bg-deep); color: var(--ink-2); text-decoration: none;
    transition: border-color var(--t-2) ease;
  }
  .prose .pf-card:hover { color: var(--ink-2); border-color: var(--accent-line); }
  .pf-card__th {
    display: block; width: 100%; height: 100%; padding: 18px 16px; box-sizing: border-box; border-right: 1px solid var(--line-2);
    background: repeating-linear-gradient(0deg, color-mix(in srgb, var(--line-ink) 5%, transparent) 0 1px, transparent 1px 15px),
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--line-ink) 5%, transparent) 0 1px, transparent 1px 15px), var(--bg);
  }
  .pf-card__th path { fill: none; vector-effect: non-scaling-stroke; }
  .pf-card__o { stroke: var(--gold-light); stroke-width: 1.4; }
  .pf-card__b { stroke: color-mix(in srgb, var(--gold) 70%, transparent); stroke-width: 0.7; }
  .pf-card__txt { display: grid; gap: 6px; align-content: center; padding: 18px 20px; }
  .pf-card__meta { font: 500 0.6875rem/1.3 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); }
  .pf-card__t { font: italic 1.75rem/1.05 var(--font-display); color: var(--gold-light); }
  .pf-card__d { font-size: 0.9375rem; line-height: 1.5; color: var(--muted); }
  .pf-card__go { margin-top: 4px; font: 500 0.75rem/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .pf-card__go .arrow { display: inline-block; transition: transform var(--t-2) var(--ease-out); }
  .pf-card:hover .pf-card__go .arrow { transform: translateX(4px); }
  .pf-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 520px) {
    .prose .pf-card { grid-template-columns: minmax(0, 1fr); }
    .pf-card__th { height: auto; border-right: 0; border-bottom: 1px solid var(--line-2); }
  }
  @media print { .pf-card__th { background: none; } .pf-card__o, .pf-card__b { stroke: #000; } }
</style>
